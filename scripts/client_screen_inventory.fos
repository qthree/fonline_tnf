class InventoryItemAction : IGUIElementCallbackInit, IGUIElementCallbackMouseClick, IGUIElementCallbackDraw
{
	IGUIElementOpt@ Options;
	ScreenInventory @ Instance;
	bool CanPress;
	uint8 Type;
	
	InventoryItemAction(ScreenInventory& instance, uint8 type)
	{
		@Instance = instance;
		Type = type;
		CanPress = true;
	}
	
	void OnInit()
	{
		uint8 index = (Type != INVENTORY_ITEM_DROP ? Type : Instance.ItemActions.length() -1);
		@Options = GUI_GetElementOptions();
		@Instance.ItemActions[index] = this;
		
		Options.Position(Options.GetPosX(), Options.GetPosY(), 30, 30);
	}
	
	void OnMouseClick(int click)
	{
		if(click == MOUSE_CLICK_LEFT && CanPress)
		{
			switch(Type)
			{
				case INVENTORY_ITEM_USE 	: InventoryUse(); break;
				case INVENTORY_ITEM_WEAR_DOWN 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_ARMOR 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_HAND1 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_HAND2 	: InventoryWear(); break;
				case INVENTORY_ITEM_SKILL 	: InventorySkill(); break;
				case INVENTORY_ITEM_UNLOAD 	: InventoryUnloadWeap(); break;
				case INVENTORY_ITEM_DROP	: InventoryDrop(); break;
				default 			: break;
			}
		}
	}
	
	void OnDraw()
	{
		//Message("width 3 "+Options.GetSurfaceWidth() + " " + Options.GetSurfaceHeight());
		
		string text = "X";
		uint8 prevIndex = Instance.ItemList.prevIndex;
		
		if(prevIndex == 255) return;
		
		uint16 invItemIndex = Instance.InventoryButtons[prevIndex].InvItemIndex;

		//InventoryItem invItem
		if(invItemIndex < 0 || invItemIndex >= Instance.ItemList.InventoryItems.length()) return;
		
		ItemCl@ tempItem = Instance.ItemList.InventoryItems[invItemIndex].tempItem[0];
		
		if(tempItem is null) return;
		
		switch(Type)
		{
			case INVENTORY_ITEM_USE 		: if(FLAG(tempItem.Flags, ITEM_CAN_USE)) {text = "U"; CanPress = true;} else { text = "X"; CanPress = false;} break;
			case INVENTORY_ITEM_WEAR_DOWN		: if(tempItem.CritSlot != SLOT_INV) {text = "I"; CanPress = true;} else { text = "X"; CanPress = false;} break;
			case INVENTORY_ITEM_WEAR_ARMOR 		: if(tempItem.GetType() == ITEM_TYPE_ARMOR && tempItem.CritSlot != SLOT_ARMOR) {text = "A"; CanPress = true;} else { text = "X"; CanPress = false;} break;
			case INVENTORY_ITEM_UNLOAD		: if(tempItem.GetType() == ITEM_TYPE_WEAPON && tempItem.AmmoCount<tempItem.Proto.Weapon_MaxAmmoCount) {text = "G"; CanPress = true;} else { text = "X"; CanPress = false;} break;
			default			: break;
		}
		
		Options.Text(""+text,FONT_BIG,CanPress ? COLOR_SAND : COLOR_RED, COLOR_GREEN, FT_CENTERX|FT_CENTERY);
	}
	
	void InventoryUse()
	{
		if(Instance.ItemList.InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_ITEM;
			invActionArr[1] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
			invActionArr[2] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].tempItem[0].GetProtoId();
			invActionArr[3] = TARGET_SELF;
			invActionArr[4] = GetChosen().Id;
			invActionArr[5] = ITEM_MODE_USE;
			for(uint8 ii = 6; ii < 7; ++ii) {invActionArr[ii] = 0;}
			SetActions(invActionArr);
		}
			//RefreshItemList();
	}

	void InventorySkill()
	{
		if(Instance.ItemList.InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_SKL_ON_ITEM;
			invActionArr[1] = 1;
			invActionArr[2] = 216;
			invActionArr[3] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
			invActionArr[4] = 0;
			invActionArr[5] = 0;
			
			SetActions(invActionArr);
		}
	}

	void InventoryWear()
	{
		uint[] invActionArr(7);
		invActionArr[0] = CHOSEN_MOVE_ITEM;
		invActionArr[1] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
		invActionArr[2] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].tempItem[0].GetCount();
		invActionArr[3] = Type;
		invActionArr[4] = 0;
		invActionArr[5] = 0;
		
		SetActions(invActionArr);
	}

	void InventoryUnloadWeap()
	{
		if(Instance.ItemList.InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_ITEM;
			invActionArr[1] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
			invActionArr[2] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].tempItem[0].GetProtoId();
			invActionArr[3] = TARGET_SELF;
			invActionArr[4] = GetChosen().Id;
			invActionArr[5] = ITEM_MODE_RELOAD;
			for(uint8 ii = 6; ii < 7; ++ii) {invActionArr[ii] = 0;}
			
			SetActions(invActionArr);
		}
	}
	
	void InventoryDrop()
	{
		//for(uint16 i = 0, j = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id.length(); i < j; ++i)
		//{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_MOVE_ITEM;
			invActionArr[1] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
			invActionArr[2] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].tempItem[0].GetCount();
			invActionArr[3] = 0xFF;
			for(uint8 ii = 4; ii < 7; ++ii) {invActionArr[ii] = 0;}
				
			SetActions(invActionArr);
		//}
		
		//Instance.ItemList.ShowList(Instance.InventoryButtons[0].InvItemIndex);
		Instance.ItemList.DropFromList();
		//Instance.ItemList.InventoryItems.removeAt(Instance.ItemList.prevIndex);
		//Instance.ItemList.FullRefrash();

	}

	void SetActions(uint[] actions)
	{
		SetChosenActions(actions);
	}
}

