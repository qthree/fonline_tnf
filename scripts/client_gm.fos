bool gm_msg_longstr(string& message)
{
	CritterCl@ chosen=GetChosen();
	if(!valid(chosen)) return false;

	if(num>=2)
	{
		if(CH_P(0, "$name") && GetCurrentCursor()<=CURSOR_MOVE)
		{
				/*string@[] parts_temp2;

				parts_temp2.resize(parts.length()-1);

				for(uint i=1; i<parts.length(); i++)
				{
					@parts_temp2[i-1]=@parts[i];
				}

				string name = join(parts_temp2, " ");

				SetConsoleName(name);

				ChangeCursor(CURSOR_USE_SKILL);*/
				Message("Для запоминания имен используйте среднюю кнопку мыши.");

		}
/*		if(CH_P(0, "$sname"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);

			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}

			string name = join(parts_temp2, " ");
			RunServerScript("qmap_debug@_sname",  0, 0, 0, name, null);
		}*/
		else if(CH_P(0, "$hash"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);

			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}

			string name = join(parts_temp2, " ");

			uint hash = GetStrHash(name);
			Message("hash "+int(hash));
		}
		else if(CH_P(0, "$s2a"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			RunServerScript("gm@_say2all",  0, 0, 0, str, null);
		}
		else if(CH_P(0, "$ans"))
		{
			if(chosen.Param[ST_VAR5]>3)
			{
				Message("Antiflood.");
				return false;
			}
		
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			RunServerScriptUnsafe("gm@unsafe_ans",  0, 0, 0, str, null);
			
			Message("Отправлено.");
		}
		else if(CH_P(0, "$help"))
		{
			if(chosen.Param[ST_VAR5]>3)
			{
				Message("Antiflood.");
				return false;
			}		
		
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			RunServerScriptUnsafe("gm@unsafe_help",  0, 0, 0, str, null);
			
			Message("Отправлено.");
		}
		else if(CH_P(0, "$poll"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			RunServerScript("gm@_poll",  0, 0, 0, str, null);
		}
		else if(num>=3 && CH_P(0, "$gmlex") && CH_P_NUM(1))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-2);
			
			for(uint i=2; i<parts.length(); i++)
			{
				@parts_temp2[i-2]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			if(str.length()>0) RunServerScript("gm@_gmlex",  ARG_NUM(1), 0, 0, str, null);
		}
		else if(CH_P(0, "$gmlex2"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			CritterCl@ target = GetMonitorCritter (__MouseX, __MouseY);
			
			if(@target!=null && str.length()>0) RunServerScript("gm@_gmlex", target.Id, 0, 0, str, null);
		}
		else if(num>=3 && CH_P(0, "$gmitemlex") && CH_P_NUM(1))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-2);
			
			for(uint i=2; i<parts.length(); i++)
			{
				@parts_temp2[i-2]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			if(str.length()>0) RunServerScript("gm@_gmitemlex",  ARG_NUM(1), 0, 0, str, null);
		}
		else if(CH_P(0, "$pm2"))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-1);
			
			for(uint i=1; i<parts.length(); i++)
			{
				@parts_temp2[i-1]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			CritterCl@ target = GetMonitorCritter (__MouseX, __MouseY);
			
			if(@target!=null && str.length()>0) RunServerScript("gm@_private", target.Id, 0, 0, str, null);
		}
		else if(num>=3 && CH_P(0, "$pm") && CH_P_NUM(1))
		{
			string@[] parts_temp2;

			parts_temp2.resize(parts.length()-2);
			
			for(uint i=2; i<parts.length(); i++)
			{
				@parts_temp2[i-2]=@parts[i];
			}
			
			string str = join(parts_temp2, " ");
			
			if(str.length()>0) RunServerScript("gm@_private",  ARG_NUM(1), 0, 0, str, null);
		}
		else if(num==2 && CH_P(0, "$act"))
		{
			if(chosen.Param[ST_VAR5]>3)
			{
				Message("Antiflood.");
				return false;
			}
			
			if(ARG(1).length()>3) RunServerScriptUnsafe("activation@unsafe_act",  0, 0, 0, ARG(1), null);
		}
	}

	return false;
}

bool gm_msg(string& message)
{
	if(message.length()<2 || message[1]==' ') return false;

	string@[]@ parts_temp = split(message, " ");

	if(!valid(parts_temp)) return false;

	parts.resize(parts_temp.length());

	for(uint i=0; i<parts.length(); i++)
	{
		parts[i]=parts_temp[i];
	}

	num = parts.length();

	if(num==0) return false;

	num_args_b.resize(num);
	num_args.resize(num);
	
	if(message[0]=='%')
	{
		return gm_msg_run(message);
	}

	for(uint i=0; i<num; i++)
	{
		num_args_b[i] = StrToInt (parts[i], num_args[i]);
	}

	if(message[0]=='#')
	{
		return gm_msg_cmd(message);
	}
	
	if(message[0]=='$')
	{
		return gm_msg_longstr(message);
	}
	
	return false;
}