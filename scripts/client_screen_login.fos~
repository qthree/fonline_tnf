#ifdef __DEBUG
            Message("key "+key+" letter "+letter);
#endif //__DEBUG
        string@ text = Options.GetText();
        //string@ text2 = ""+key;
        //text += letter;
#ifdef __DEBUG
        Message(text);
#endif //__DEBUG
        if( text.length() > 0 && text[ text.length() - 1 ] == '\n' )
            text.resize( text.length() - 1 );

        Options.Text( text, FONT_FALLOUT, COLOR_SAND, COLOR_GREEN, FT_CENTERY ); //FT_CENTERX |
        }

        void SetText(string text){
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
        }

        string GetText(){
           return Options.GetText();
        }

        void TextAdd(uint8 letter){
            string text = Options.GetText();

            //text.insertLast(letter);

            StrInsLast(text, letter);
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
        }

        void TextRm(){

            string text = Options.GetText();
            if(text.length() > 0){

                //text.removeLast();
                StrRmLast(text);
                Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
            }
        }

        void StrInsLast(string& str, uint8 letter){
            uint len = str.length();
            str.resize(len+1);
            str[len] = letter;

        }

        void StrRmLast(string& str){
            uint len = str.length()-1;
            if(len >= 0) str.resize(len);
        }

        void Visible(){
            Options.SetVisible(!Options.GetVisible());
        }
}
