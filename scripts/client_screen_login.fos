//#include "serializator.fos"

#define LOGIN_INPUTBOX_NAME_INDEX     (0)
#define LOGIN_INPUTBOX_PASS_INDEX     (1)

#define LOGIN_SCREEN_BTN_ENTER          (0)
#define LOGIN_SCREEN_BTN_REG            (1)
#define LOGIN_SCREEN_BTN_EXIT           (2)
#define LOGIN_SCREEN_BTN_REGSHOW        (3)

#define CHARLIST_LENGTH               (5)

import bool ProcessKey( uint8 key, string& text, uint8& letter ) from "client_gui";

CLoginScreen@     outLoginScreen;
CLoginInputBox@[] inputBoxs;
CLoginButton@     loginBtn;

string@[]@ uname;   //in login menu player view name
string@[]@ upass;   //password
string@[]@ ureal;   //player login

uint forumId = uint(-1);

class CLoginButton : IGUIElementCallbackMouseClick, IGUIElementCallbackInit
{

    IGUIElementOpt@ Options;

    void OnMouseClick(int click){
            CheckLogin();
    }

    void OnInit(){
            //IGUIElementOpt
            //@loginBtn = this;
            @Options = GUI_GetElementOptions();
    }

    void Release(){
            Options.Realese();
    }

    void CheckLogin(){
    MysqlInit();
            if(MysqlConnect()){
                if(MysqlSelectDb() == 0){
                        string login = inputBoxs[LOGIN_INPUTBOX_NAME_INDEX].GetText(), password = inputBoxs[LOGIN_INPUTBOX_PASS_INDEX].GetText();

                        if(login == "" || password == "") {Message("Null length login or password");return;}

                        int r = MysqlCheckLogin(login, password);

                        if(r < 0){
                            string error = "";
                            MysqlError(error);
                            Message("error "+error+" ext code "+r);
                        }else{
                            //Message("login exist. id "+r);



                            forumId = r;

                            if(GetChars(r) <= 0){
                                    uname.resize(0);
                                    upass.resize(0);
                                    ureal.resize(0);
                            }
                            //Message("login13");
                            ::ShowScreen(CLIENT_SCREEN_LOGIN_TNF, 0, 0, 0);
                        }
                    }
                    MysqlClose();
            }else{
                    Message("sql connect error");
            }
    }

    int GetChars(/*string& names, string& pass, */int r){

                            string namesView = "", pass = "", namesReal = "";

                            //int rP = MysqlGetCharsPass(uint(r), pass), rN = MysqlGetCharsName(uint(r), names);
                            int rP = MysqlGetAccountChars(uint(r), namesView, namesReal, pass);
                            if(rP < 0){
                                string error = "";
                                MysqlError(error);
                                Message("error "+error+" ext code "+rP);//+" ext msg "+namesView);
                            }else{

                                @uname = split( namesView, "&" );
                                @upass = split( pass, "&" );
                                @ureal = split( namesReal, "&");

                                if(uname.length() != upass.length() || upass.length() != ureal.length() || uname.length() != ureal.length()) {Message("array length error"); return -1;}

                                for(uint8 i = 0, j = uname.length(); i < j; ++i){
                                        string name = "names : "+uname[i]+" len " + uname[i].length() + " | login : "+ureal[i]+" len " + ureal[i].length() + " | pass : "+upass[i]+" len " + upass[i].length();

                                        Message("name "+name);

                                }
                            }

                            return rP;
    }
}

