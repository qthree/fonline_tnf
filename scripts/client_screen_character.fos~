class CCharacterStatDesc : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        uint8 Index;
        uint16 ParamIndex;
        string Text;

        int[] StatDescTextXY;

        CCharacterScreen@ Instance;
        IGUIElementOpt@ Options;

        CCharacterStatDesc(CCharacterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = (Index != 7 ? paramIndex : STR_UNXP_SPECIAL);
            Text = "";

            @Instance = instance;
            @Instance.StatDesc[Index] = this;
        }

        void OnMouseClick(int click){
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
/*
            string text = GetMsgStr(TEXTMSG_GAME, (Index != 7 ?STR_STAT_NAME+ParamIndex : (STR_STAT_FULL+ParamIndex) * 10));

            Options.Text(""+text, FONT_BIG, COLOR_WHITE, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
            Text = text;*/
        }

        void OnDraw(){

            int x = Options.GetPosX(), y = Options.GetPosY();

            uint color = COLOR_SAND;
            string text = GetMsgStr(TEXTMSG_GAME, (Index != 7 ?STR_STAT_NAME+ParamIndex : (STR_STAT_FULL+ParamIndex) * 10));

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

            //string text = Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
            //uint color = (Index != 7 ? COLOR_WHITE : (Instance.UnxpStat > 0 ? COLOR_WHITE : COLOR_RED));
            //Message("text = "+Text);
            //DrawText(""+Text, x+325, y+314, 600 , 600, color, FONT_BIG_NUM,  0);
            DrawText(""+text, x+StatDescTextXY[0], y+StatDescTextXY[1], 60 , 60, color, FONT_BIG,  FT_CENTERX | FT_CENTERY);
        }
}

class CCharacterStatShow : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
    uint8 Index;
    uint8 RealStat;
    uint16 ParamIndex;
    

    int[] StatShowTextXY;

    CCharacterScreen@ Instance;
    IGUIElementOpt@ Options;

    CCharacterStatShow(CCharacterScreen& instance, uint8 index, uint16 param){
        Index = index;
        ParamIndex = param;

        @Instance = instance;
        @Instance.StatShow[Index] = this;
    }

    void OnMouseClick(int click){
        Instance.SetHelp(ParamIndex);
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();
	
	RealStat = GetChosen().StatBase[ParamIndex];


        //Text(Instance.StatValue[Index]);
        //Text(5);
    }

    void OnDraw(){

        int statVal = (Index != 7 ? (Instance.Param[ParamIndex] + Instance.Param[ParamIndex+ST_STRENGTH_EXT]) : Instance.UnxpStat);
	
	if(statVal < 1) statVal = 1;

        //Message("st_ext "+ParamIndex+" value"+Instance.Param[ParamIndex+ST_STRENGTH_EXT]);

        string text = Text(uint8(statVal));
        uint color = (RealStat != Instance.Param[ParamIndex] ? COLOR_RED : COLOR_WHITE);//(Index != 7 ? COLOR_WHITE : (Instance.UnxpStat > 0 ? COLOR_WHITE : COLOR_RED));
	
	/*
        if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;} //gamemode
            else if(Instance.Param[QST_GAMEMODE] == GAME_SURVIVAL && statVal > STAT_SURV_MAX){color = COLOR_RED;}
                else if(Instance.Param[QST_GAMEMODE] == GAME_ADVENTURE){
                    if(!RaceParamCheck(Instance.Param[ST_GENDER], ParamIndex, statVal)){
                        color = COLOR_RED;
                    }
                }*/

        int x = Options.GetPosX(), y = Options.GetPosY();

        DrawText(""+text, x+StatShowTextXY[0], y+StatShowTextXY[1], 40 , 40, color, FONT_BIG_NUM,  0);
    }

    void SetValue(){}

    void Text_(uint8 value){
        //Options.Text( text, FONT_BIG_NUM, COLOR_LRED, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }

    string Text(uint8 value){
        string text = "";
        if(value < 10){text = "0";}
        text += value;

        return text;
    }
}

class CCharacterSkillDesc : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        uint8 Index;
        uint16 ParamIndex;

        int[] infoSkillDescTextXY;// = {225, 363};

        CCharacterScreen@ Instance;
        IGUIElementOpt@ Options;

        CCharacterSkillDesc(CCharacterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = paramIndex;

            @Instance = instance;
            @Instance.SkillDesc[Index] = this;
        }

        void OnMouseClick(int click){
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();

            infoSkillDescTextXY = GetIniValues2("TnfRegSkillDescText", infoSkillDescTextXY);

            //string text = GetMsgStr(TEXTMSG_GAME, STR_SKILL*10+Index*10+1);

            //Options.Text(""+text, FONT_FALLOUT, COLOR_GREEN, COLOR_GREEN, FT_CENTERY );
        }

        void OnDraw(){

            // string text = Instance.Param[ParamIndex];//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
            string text = GetMsgStr(TEXTMSG_GAME, STR_SKILL*10+Index*10+1);
            //(Instance.Param[ParamIndex])
	    
	    //Character screen comment
	    /*
	    bool isTagSet = Instance.TagBtn[Index].IsSet;
            uint color = (isTagSet ? COLOR_GRAY : COLOR_GREEN);

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode
*/

            int x = Options.GetPosX(), y = Options.GetPosY();

            DrawText(""+text, x+infoSkillDescTextXY[0], y+infoSkillDescTextXY[1], 200, 40, COLOR_GREEN, FONT_FALLOUT,  0);
        }
}

class CCharacterSkillShow : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
    uint8 Index;
    uint16 ParamIndex;

    int[] infoSkillShowTextXY;// = {225, 363};

    CCharacterScreen@ Instance;
    IGUIElementOpt@ Options;

   CCharacterSkillShow(CCharacterScreen& instance, uint8 index, uint16 param){
        Index = index;
        ParamIndex = param;

        @Instance = instance;
        @Instance.SkillShow[Index] = this;
    }

    void OnMouseClick(int click){
        Instance.SetHelp(ParamIndex);
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();

        infoSkillShowTextXY = GetIniValues2("TnfRegSkillShowText", infoSkillShowTextXY);
        //Text(Instance.StatValue[Index]);
        //Text(5);
    }

    void OnDraw(){
        // string text = Instance.Param[ParamIndex];//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
        //Character screen comment
        /*
	bool isTagSet = Instance.TagBtn[Index].IsSet;
        uint color = (isTagSet ? COLOR_GRAY : COLOR_GREEN);

        if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

*/

        int x = Options.GetPosX(), y = Options.GetPosY();




        DrawText(""+Text(Instance.Param[ParamIndex]), x+infoSkillShowTextXY[0], y+infoSkillShowTextXY[1], 40 , 40, COLOR_GREEN, FONT_FALLOUT,  0);
    }

    void SetValue(){}

    void Text_(uint8 value){
        //Options.Text( text, FONT_BIG_NUM, COLOR_LRED, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }

    string Text(uint8 value){
        string text = "";
        if(value < 100){text = "0";}
        if(value < 10){text += "0";}

        text += value+"%";

        return text;
    }
}

