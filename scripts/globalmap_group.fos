void unsafe_ExitGridClick( Critter& cr, int hexX, int hexY, int protoId, string@ param3, int[] @ param4 )
{
    if( cr.IsKnockout() || cr.IsDead() )
    {
        cr.Say( SAY_NETMSG, "Вы не можете перейти." );
        return;
    }
    if( cr.Timeout[ TO_TRANSFER ] > 0 )
    {
        cr.Say( SAY_NETMSG, "Таймаут на переходы. Ждите." );
        return;
    }
    Scenery@ grid = cr.GetMap().GetScenery( hexX, hexY, protoId );
    if( grid !is null )
    {
        uint8 length = cr.GetMap().GetPathLength( cr, grid.HexX, grid.HexY, 0 );
        // cr.Say(SAY_NETMSG, ""+(ABS(int(cr.HexX - grid.HexX)))+" "+(ABS(int(cr.HexY - grid.HexY))));
        if( ABS( int(cr.HexX - grid.HexX) ) <= EXIT_GRID_DISTATION && ABS( int(cr.HexY - grid.HexY) ) <= EXIT_GRID_DISTATION )
        {
            TransitCritterToCell( cr, grid );
            return;
        }
        cr.Say( SAY_NETMSG, "Вы слишком далеко от сетки выхода." );
        // cr.Say(SAY_NETMSG, "Выход заблокирован.");
    }

}

void unsafe_GetMapPid( Critter& cr, int hexX, int hexY, int protoId, string@ param3, int[] @ param4 )
{
    Scenery@ grid = cr.GetMap().GetScenery( hexX, hexY, protoId );
    if( grid !is null )
    {

        Cell @ cell = world.GetCell( cr );
        if( cell !is null )
        {
            int8   offsetCellX = 0, offsetCellY = 0, level = GetMapLevelByPid( cr.GetMap().GetProtoId() );
            uint8  direction = cr.GetMap().GetScenParam( hexX, hexY, protoId, 0 );          // grid.Val1;
            uint16 destCellX = cell.X, destCellY = cell.Y, oldHexX = 0, oldHexY = 0;
/*
            if( !GetMap( cell.Content.MapId[ CELL_LEVEL_DEFAULT + level ] ).GetEntireCoords( ENTIRE_NUM, 0, oldHexX, oldHexY ) )
            {
                cr.Say( SAY_NETMSG, "no ent" );
                return;
            }

            oldHexX = grid.HexX - oldHexX;
            oldHexY = grid.HexY - oldHexY;*/

            cr.StatBase[ ST_LOCALMAP_DIR ] = direction;
            if( SetMapDirection( direction, destCellX, destCellY, offsetCellX, offsetCellY ) )
            {
	      
		if(cell.Content !is null){
	      
			uint16 mapId = GetCellMap( destCellX * 10, destCellY * 10, level );
			if( mapId != -1 )
			{
				Map @ map = GetMap( mapId );                  // cell.Content.MapId); //
				if( map !is null )
				{
					cr.StatBase[ ST_LOCALMAP_PID ] = map.GetProtoId();
					// cr.Say(SAY_NETMSG, ""+map.GetProtoId());
					return;
				}
			}
		}else{
			Cell @ targetCell = world.GetCell(destCellX, destCellY);
			if(targetCell !is null){
				cr.StatBase[ ST_LOCALMAP_PID ] = targetCell.BiomMapPid;
			}
		}
            }
        }
    }
    cr.StatBase[ ST_LOCALMAP_PID ] = 0;
    return;
}

