/**
 телепортирует на локацию
 type=all, target
 param=2
 v0 - индификатор локации.
 v1 - номер карты на локации.
 машина разумееться не телепортируется
*/
int TransitToLocation(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	Location @ loc = GetLocationByPid(v0, 0);
	if(not valid(loc)) {Log("Location not found"); return 0;}
	Map @ map = loc.GetMapByIndex(v1);
	if(not valid(map)) {Log("Get map error or not found"); return 0;}
	FlushScreen(player, true, 3000);
	player.TransitToMap(map.Id, 0);
	return 0;
}

/**
 телепортирует на карту
 type=all, target
 param=1
 v0 - PID, индификатор прототипа карты.
 используйте только PID карт существующих в игре в одном экземпляре.
*/
int TransitToMap(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
