#include "_macros.fos"
/*import void InjureCritter(Critter& cr, uint dmg, uint dmgType, uint8 dir, uint attackerId) from "combat";*/
void _ItemInit(Item& item, bool FirstTime)
{
 item.SetEvent(ITEM_EVENT_USE, "_Reanimate");
 }

bool _Reanimate(Item& item, Critter& crit, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{

if(!valid(onCritter)) return false;

if(onCritter.IsLife())
{
//InjureCritter(onCritter, 50, 5, 0, crit.Id);
crit.SayMsg(SAY_NETMSG,TEXTMSG_GAME,12923);
return true;
}

if(crit.Param[SK_DOCTOR]<80)
{
crit.SayMsg(SAY_NETMSG,TEXTMSG_GAME,12920);
return true;
}
if(onCritter.IsDead())
{
	if(onCritter.CondExt==COND_DEAD_FRONT||onCritter.CondExt==COND_DEAD_BACK||onCritter.CondExt==COND_DEAD_BURST)
	{
	if(onCritter.CondExt==COND_DEAD_BURST) crit.ParamBase[ST_EXPERIENCE]+=300; else crit.ParamBase[ST_EXPERIENCE]+=200;
	onCritter.ToLife();
	crit.DeleteItem(PID_DEFIB,1);
	crit.SayMsg(SAY_NETMSG,TEXTMSG_GAME,12921);
	if(onCritter.IsNpc())onCritter.EraseEnemyFromStack(crit.Id);
	return true;
	}
	else 
	{
	crit.SayMsg(SAY_NETMSG,TEXTMSG_GAME,12922);
	return true;
	}
}
return false;
}