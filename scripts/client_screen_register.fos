class CRegisterScreen : IGUIScreenCallbackShow, IGUIScreenCallbackHide, IGUIScreenCallbackMove
{
    int8   UnxpStat;
    int8   UnxpTag;
    int8   UnxpTrait;

    uint16 Count;
    uint16 PerksIndexCurrent;

    uint16[] Perks;

    //uint8[] StatValue;
    //uint16[] SkillValue;

    int[]   Param;                  //all character params Critter::Param[]

    CRegisterStatButtonChange@[]    StatChg;
    CRegisterStatShow@[]            StatShow;
    CRegisterStatDesc@[]            StatDesc;

    CRegisterSkillShow@[]           SkillShow;
    CRegisterSkillDesc@[]           SkillDesc;

    CRegisterTagBtn@[]              TagBtn;

    CRegisterInfoShow@[]            InfoShow;
    CRegisterInfoDesc@[]            InfoDesc;

    CRegisterArchiveMask@[]         ArchiveMask;

    CRegisterTraitBtn@[]            TraitBtn;
    CRegisterTraitDesc@[]           TraitDesc;

    CRegisterPerkDesc@[]            PerkDesc;
    CRegisterPerkBtn@[]             PerkBtn;

    CRegisterPerkMoveBtn@[]         PerkMoveBtn;

    CRegisterName@                  NameBox;
    CRegisterAge@                   AgeBox;
    CRegisterConfirm@               ConfirmBtn;
    CRegisterArchivePic@            ArchivePic;
    CRegisterHelp@                  Help;
    CCharacterSkinSelectorImage@    SkinImage;

    IGUIScreenOpt@  ScreenOpt;
    //IGUIElementOpt@ InputBoxOpt;

    CRegisterScreen(){
        Param.resize(1000);

        PerkSetAvalible();
        PerksIndexCurrent = 0;

        UnxpStat = 5;
        UnxpTag = 3;
        UnxpTrait = 2;
    }


    void OnShow( int p0, int p1, int p2 )
    {
        @ScreenOpt = GUI_GetScreenOptions();

        //UnxpStat = 5;
        //UnxpTag = 3;

        ParamDrop();
        TagClear();
        TraitClear();
        PerkClear();

        Message("perks len" + Perks.length());
    }

    void OnHide( int p0, int p1, int p2 )
    {

    }

    void OnMove( int posX, int posY )
    {

    }

    void ParamUpdate(){
            CritterGenerate(Param);
    }

    void GetParam(){
            CritterGenerate(Param);
    }

    void SetRegStat(uint8 index){
            StatChg[index].ChangeValue();
    }

    void ChangeParamInc(uint16 index){
            if(index < Param.length()){
                    Param[index]++;
            }
    }

    void ChangeParamDec(uint16 index){
            if(index < Param.length()){
                    //Message("param inc");
                    Param[index]--;
            }
    }

    void SetParam(uint16 index, int val){
            if(index < Param.length()){
                    Param[index] = val;
            }
    }

    bool CheckStatUnxp(){
            return (UnxpStat > 0);
    }


    void ParamDrop(){
        Param.resize(1000);

        for(uint16 i = 0, j = Param.length(); i < j; ++i){
            //if(i == QST_GAMEMODE) continue;         //only gamemode skip
            Param[i] = 0;
        }

        for(uint8 i = 0; i < 8; ++i){
            Param[i] = 5;
        }

        ParamUpdate();

        //CritterGenerate(Param);

        UnxpStat = 5;
        Param[ST_AGE] = Random(AGE_HUMAN_MIN+1, AGE_HUMAN_MAX-1);
        Param[QST_GAMEMODE] = GAME_SURVIVAL;
    }

    void ParamDropSoft(){
        for(uint16 i = 7, j = Param.length(); i < j; ++i){

                if(i >= TAG_SKILL1 && i < TAG_SKILL4) continue;
                if(i >= TRAIT_BEGIN && i < TRAIT_END) continue;
                if(i == ST_GENDER || i == ST_AGE || i == QST_GAMEMODE) continue;

                Param[i] = 0;
        }

        ParamUpdate();
    }

    void ParamDropChageGamemode(){
        for(uint8 i = 0; i < 8; ++i){
            Param[i] = 5;
        }

        TagClear();
        TraitClear();
        PerkClear();

        //ParamUpdate();
    }

    void TagSet(uint16 paramIndex){

            for(uint16 i = TAG_SKILL1; i < TAG_SKILL4; ++i){
                if(Param[i] != 0) continue;

                Param[i] = paramIndex;
                UnxpTag--;

                CLAMP(UnxpTag, 0, 3);

                //Message("tag set "+i+" skill "+paramIndex+" tags "+UnxpTag);

                return;
            }
    }

    void TagUnset(uint16 paramIndex){
            //uint8 tag[] = {0,0,0};
            for(uint16 i = TAG_SKILL1; i < TAG_SKILL4; ++i){
                //tag[i] = Param[i+TAG_SKILL1];
                if(Param[i] != paramIndex) continue;

                Param[i] = 0;
                UnxpTag++;

                CLAMP(UnxpTag, 0, 3);
                //Message("tag unset "+i+" tags "+UnxpTag);

                return;
            }
            /*uint8 index = tag.find(paramIndex)
            tag[]*/
    }

    void TagClear(){
            for(uint8 i = 0, j = TagBtn.length(); i <j; ++i){
                    TagBtn[i].IsSet = false;
                    TagBtn[i].Switch(false);
            }

            for(uint16 i = TAG_SKILL1; i < TAG_SKILL4; ++i){
                    Param[i] = 0;
            }

            UnxpTag = 3;
    }

    void TraitSet(uint16 paramIndex){
            if(UnxpTrait > 0){
                Param[paramIndex] = 1;
                ParamDropSoft();
                UnxpTrait--;
            }

    }

    void TraitUnset(uint16 paramIndex){
            Param[paramIndex] = 0;
            ParamDropSoft();
            UnxpTrait++;

            UnxpTrait = CLAMP(UnxpTrait, 0 ,2);
    }

    void TraitClear(){
            for(uint8 i = 0, j = TraitBtn.length(); i <j; ++i){
                    TraitBtn[i].IsSet = false;
                    TraitBtn[i].Switch(false);
            }

            for(uint16 i = TRAIT_BEGIN; i < TRAIT_END; ++i){
                    Param[i] = 0;
            }

            UnxpTrait = 2;
    }

    int TraitUnxpCheck(){
            return UnxpTrait;
    }

    void PerkSet(uint16 paramIndex){
            Param[paramIndex] = 1;
            PerkUpReg(Param, paramIndex);
    }

    void PerkUnset(uint16 paramIndex){
            Param[paramIndex] = 0;
            PerkDownReg(Param, paramIndex);
    }

    bool PerkIsAvalible(uint16 paramIndex){

            //bool r = true;

            if(paramIndex > PE_MUTATE && paramIndex < PE_ADRENALINE_RUSH) return false; //skip // 354..379
            if(paramIndex == 418) return false;
            //if(paramIndex > PE_TERMINATOR && paramIndex < PE_GECKO_SKINNING) return false;
            if(paramIndex > PE_VAULT_CITY_TRAINING  && paramIndex < PE_GECKO_SKINNING) return false;
            if(paramIndex > PE_CANNIBAL) return false;

            return true;
    }

    void PerkSetAvalible(){
            for(uint16 i = PERK_BEGIN; i < PERK_END; ++i){

                if(PerkIsAvalible(i)){
                    Perks.insertLast(i);
                }
            }
    }

    void PerkClear(){
            for(uint16 i = PERK_BEGIN; i < PERK_END; ++i){

                if(!PerkIsAvalible(i)) continue;
                Param[i] = 0;
            }
    }

    void PerkMoveDown(){

            uint8 perkLen = PerkDesc.length();

            if(PerksIndexCurrent+perkLen >= Perks.length()-1) return;

            PerksIndexCurrent++;

            for(uint8 i = 0; i < perkLen; ++i){
                    PerkDesc[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
                    PerkBtn[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
            }
    }

    void PerkMoveUp(){

            uint8 perkLen = PerkDesc.length();

            if(PerksIndexCurrent <= 0) return;

            PerksIndexCurrent--;

            for(uint8 i = 0; i < perkLen; ++i){
                    PerkDesc[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
                    PerkBtn[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
            }
    }

    void ShowArchive(uint8 index){

        for(uint8 i = 0, j = TraitBtn.length(); i < j; ++i){
                 if(index == 0){

                     TraitDesc[i].Visible(false);
                     TraitBtn[i].Visible(false);

                     PerkDesc[i].Visible(false);
                     PerkBtn[i].Visible(false);

                     if(InfoDesc[i] is null) continue;

                     InfoDesc[i].Visible(true);
                     InfoShow[i].Visible(true);
            }else if(index == 1){

                     TraitDesc[i].Visible(true);
                     TraitBtn[i].Visible(true);

                     PerkDesc[i].Visible(false);
                     PerkBtn[i].Visible(false);

                     if(InfoDesc[i] is null) continue;

                     InfoDesc[i].Visible(false);
                     InfoShow[i].Visible(false);
            }else if(index == 2){

                     TraitDesc[i].Visible(true);
                     TraitBtn[i].Visible(true);

                     PerkDesc[i].Visible(true);
                     PerkBtn[i].Visible(true);

                     if(InfoDesc[i] is null) continue;

                     InfoDesc[i].Visible(false);
                     InfoShow[i].Visible(false);
            }
        }

        for(uint8 i = 0; i < 2; ++i){ //temprorary
             bool vis = (index == 2);
             PerkMoveBtn[i].Visible(vis);
        }

        ArchivePic.Switch(index);
    }

    void SetHelp(uint16 paramIndex){
        Help.SetParam(paramIndex);
    }

    void SetSkinImage( uint8 index, int8 dir )
    {
        SkinImage.SetPic( index, dir );
    }

    bool CheckGameMode(){
        return true;
    }
}

