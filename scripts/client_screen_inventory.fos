class InventoryItem
{
	InventoryItem()
	{
		Child = false;
		Rolled = false;
	}

	InventoryItem(uint id, uint16 count, string name, ItemCl& item)
	{
		Id.resize(1);
		Count.resize(1);

		Id[0] = id;
		Count[0] = count;
		Name = name;

		Child = true;

		tempItem.resize(1);
		@tempItem[0] = item;
		
		WearSlot = item.CritSlot;
		
		//Message("crit slot "+WearSlot+" pid "+item.GetProtoId());
	}

	InventoryItem(uint[] id, uint16[] count, string name, ItemCl@[]& item)
	{
		Id = id;
		Count = count;
		Name = name;

		Child = false;

		tempItem = item;
		
		//Message("crit slot "+WearSlot+" pid "+item[0].GetProtoId()+" "+item[0].CritSlot);
		
		WearSlot = item[0].CritSlot;
		
		/*for(uint i = 0, j = item.length(); i < j; ++i){
			WearSlot = SLOT_INV;
			if(item[i].CritSlot != SLOT_INV){WearSlot = item[i].CritSlot;}
		}*/
	}

	void GetItems(ItemCl@[]& items)
	{
		items = tempItem;
	}

	void RemoveArrLast(){
		RemoveArr(Id.length()-1);
	}

	void RemoveArr(uint8 index){
		Id.removeAt(index);
		Count.removeAt(index);
	}
	
	void ItemDec(uint id, uint count){
		for(uint i = 0, j = Id.length(); i < j; i++){
			Message("id "+Id[i]+":"+id);
			if(Id[i] == id){
				Message("found");
				if(Count[i] > count){
					Count[i] -= count;
				}else{
					RemoveArr(i);
				}
			}
		}
	}

	uint[] Id;
	uint16[] Count;
	uint16 ProtoId;
	uint8	WearSlot;
	string Name;
	
	bool Child;
	bool Rolled;

	int TextW0;
	int TextW1;
	string Text0;
	string Text1;

	ItemCl@[] tempItem;
}

void FormatText(string text0, string text1, IGUIElementOpt& opt, uint font, uint flags, int& rW, int& rH)
{
	int tw0 = 0, tw1 = 0, th0 = 0, th1 = 0, lines = 0;
	uint16 w = opt.GetSurfaceWidth(), h = opt.GetSurfaceHeight();
	GetTextInfo(text0, w, h, font, flags, tw0, th0, lines);
	GetTextInfo(text1, w, h, font, flags, tw1, th1, lines);
	rW = w - (tw0 + tw1);
	rH = tw0;//h - (th0 + th1);
	//Message(" "+w+" "+rW+" "+tw0+" "+tw1);
	return;
}

