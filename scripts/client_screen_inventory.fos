		//Options.Text(text,FONT_FALLOUT,COLOR_GREEN, COLOR_GREEN, 0);
		CritterCl@ choo = GetChosen();
		if(choo is null) return;
		
		bool originalText = false;
		bool haveDamage = false;
		uint multiplyer = 0;
		if(Type >= DAMAGE_BEGIN && DAMAGE_END >= Type) {multiplyer = 100000; originalText = true; haveDamage = (choo.Damage[Type] > 0 ? true : false);}
		else if(Type >= 451 && 454 >= Type) {multiplyer = 1; haveDamage = FLAG(choo.StatBase[ST_CRSTATUS], pow(2, Type));}
		
		string text = GetMsgStr(TEXTMSG_GAME,  (originalText ? multiplyer + (Type * 10) + 1 : Type+451));
		
		//Message(""+(pow(2, Type)));
		/*
		
		
		for(uint16 i = DAMAGE_BEGIN; i < DAMAGE_END; ++i)
		{
			text += GetMsgStr(TEXTMSG_GAME, 100000 + i * 10 + 1)+"\n";
		}
		
		for(uint8 i = 0; i < 4; ++i)
		{
			text += GetMsgStr(TEXTMSG_GAME, 451+i)+"\n";
		}
		*/
		Options.Text(text,FONT_FALLOUT,haveDamage ? COLOR_GREEN : COLOR_GRAY, COLOR_GREEN, FT_CENTERY);
	}
	
	/*void OnDraw()
	{
		int x = 0, y = 0, xOff = Instance.screenOpt.GetPosX() + Options.GetPosX(), yOff = Instance.screenOpt.GetPosY() + Options.GetPosY();
		string text = "";
