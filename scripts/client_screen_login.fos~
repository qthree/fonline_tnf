//EXPORT


void LoginSetText(uint8 key, uint8 letter){               //export to cient_gui.fos -> screen_key_press

	//Message("in "+inputBoxs.length());

        uint8 index = (inputBoxs[LOGIN_INPUTBOX_NAME_INDEX].Active ? LOGIN_INPUTBOX_NAME_INDEX : LOGIN_INPUTBOX_PASS_INDEX);
        /*if(key != DIK_BACK){
            inputBoxs[index].TextAdd(letter);
        }else{
            inputBoxs[index].TextRm();
        }*/
        uint8 testLetter = 0;
        string text = inputBoxs[index].GetText();
        ProcessKey(key, text, testLetter);
        inputBoxs[index].SetText(text);
        //inputBoxs[index].KeyPress(key);
}

void LoginTabPress(){
        uint8 index = (inputBoxs[LOGIN_INPUTBOX_NAME_INDEX].Active ? LOGIN_INPUTBOX_NAME_INDEX : LOGIN_INPUTBOX_PASS_INDEX);

        inputBoxs[index].SwitchState();
}

void LoginEnterPress(){
        if(!(loginBtn is null)){
                loginBtn.Release();
        }
}

void LoginInputCharName(uint8 key, uint8 letter){               //export to cient_gui.fos -> screen_key_press
    if(outLoginScreen is null) Message("null out screen");
    //Message(""+key+" "+letter);

    uint8 testLetter = 0;
    string text = outLoginScreen.CharCreateInput.GetText();
    ProcessKey(key, text, testLetter);
    outLoginScreen.CharCreateInput.SetText(text);
}

bool LoginIsRegActive(){
    return (outLoginScreen !is null && outLoginScreen.IsRegActive());
}
