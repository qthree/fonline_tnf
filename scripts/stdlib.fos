// обработчик воровства - ближайшие критеры атакуют
//bool s_steal(Critter& player, Scenery& scen, int skill, Item@ item)
// освещение подземелий вкл/выкл
//bool s_light_switch(Critter& player, Scenery& scen, int skill, Item@ item)
// освещение подземелий, включает при починке, выключает при поломке
//bool s_light_repair(Critter& player, Scenery& scen, int skill, Item@ item)

/**
 тайник
 на обнаружение тайника влияет Внимательность, Удача, навык Скитальца.
 param=0
 type=scenery
*/
int Secret(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
//#define Complexity#(P) (P.Stat[ST_PERCEPTION] * 10)
//#define Complexity#(P) (P.Stat[ST_PERCEPTION] * 10 + P.Skill[SK_OUTDOORSMAN])
#define Complexity#(P) (CLAMP((((P.Stat[ST_PERCEPTION] + P.Stat[ST_LUCK]) * 10) + P.Skill[SK_OUTDOORSMAN]), 0, 300))
	if(skill!=SK_STEAL) return FALSE;
	bool create=false;
	Map@ map=player.GetMap();
	Item@ hidingPlace=map.GetItem(scenery.HexX,scenery.HexY,PID_FLOOR_SAFE);
	if(not valid(hidingPlace))
	{
		int c = Complexity(player)/2 - Random(0,10-player.Stat[ST_LUCK])*10;
		if (c<0) return FALSE;
		@hidingPlace=map.AddItem(scenery.HexX, scenery.HexY, PID_FLOOR_SAFE, 1);
		if(not valid(hidingPlace)) {Log("ERROR AddItem");return FALSE;}
		SETFLAG(hidingPlace.Flags, ITEM_HIDDEN);
		hidingPlace.Update();
		player.Say(SAY_NETMSG, "Вы создали тайник");
		create=true;
		hidingPlace.LockerComplexity = CLAMP(c,0,200);
	}

	if(hidingPlace.GetType() == ITEM_CONTAINER &&
		hidingPlace.LockerComplexity < Complexity(player) )
	{
		map.OpenDoor(hidingPlace);
		player.ShowContainer(null,hidingPlace,hidingPlace.Proto.Container_IsGroundLevel()?TRANSFER_HEX_CONT_DOWN:TRANSFER_HEX_CONT_UP);
		if(not create) player.Say(SAY_NETMSG, "Вы нашли тайник");
		return TRUE;
	}
	return FALSE;
}

























