//!/ проверка на разведанность зон вокруг города.
// разведанной считается зона без тумана.
// VAL - радиус.
// bool d_ZoneCheck(Critter& player, Critter@ npc, int val)
// bool d_ZoneCheckXY(Critter& player, Critter@ npc, int val)

//!/ проверка навыка у группы (НЕДОСТУПНО)
// достаточно одного партийца у которого навык(VAL1) выше чем VAL2
bool d_GroupCheckStat(Critter& player, Critter@ npc, int val, int val2)
{
	Critter@[] groups;
	ArrayPushBack(groups,player);
	player.GetFollowGroup(FIND_LIFE,groups);
	for(uint i=0;i<groups.length();i++)
		if(player.Skill[val2] > val)
			return true;
	return false;
}

