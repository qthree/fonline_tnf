class CCharacterAgeBtn : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
{

    CCharacterScreen@ Instance;
    // InputCode @ Code;

    bool Increase;
    uint16 Age;

    IGUIElementOpt@ Options;

    // uint8 ButtonNumber;

    CCharacterAgeBtn( CCharacterScreen & instance, bool inc)
    {
        @Instance = instance;
        Increase = inc;
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();
    }

    void OnMouseClick( int click )
    {

            //GetOutParam(ST_AGE, Age);
            Age = Instance.Param[ST_AGE];

//            Message("INC "+Increase)

            if(Increase){
                if(Age < AGE_HUMAN_MAX){
                    Age++;
                }
            }else if(Age > AGE_HUMAN_MIN){
                Age--;
            }

            Instance.Param[ST_AGE] = Age;
            //SetOutParam(ST_AGE, Age);
    }
}

