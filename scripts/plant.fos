#include "_macros.fos"

import bool CheckGard(Map& map, uint16 hexX, uint16 hexY) from "farm";

bool hashes_inited=false;

#define HASHES_PLANT_RADCVET		(0)
#define HASHES_PLANT_MAX			(1)

uint[][] hashes_plant(HASHES_PLANT_MAX);

void init_hashes()
{
	string dir0="art/items/",
	dir1="art/inven/",
	frm=".frm",
	fofrm=".fofrm",
	png=".png";

	uint[]@ data=hashes_plant[HASHES_PLANT_RADCVET];
	data.resize(0);
	data.insertLast(GetStrHash(dir0+"plant_radcvet0"+fofrm));
	data.insertLast(GetStrHash(dir1+"radcvet"+png));
	data.insertLast(0);
	data.insertLast(0);
	data.insertLast(GetStrHash(dir0+"plant_radcvet2"+png));
	data.insertLast(GetStrHash(dir1+"brocflwr"+frm));
	data.insertLast(GetStrHash(dir0+"plant_radcvet3"+png));
	data.insertLast(GetStrHash(dir1+"plant_radcvet3"+png));
	
	hashes_inited=true;
}

/*
	Val0 - time event
	Val1 - стадия роста
	Val2 - 
	Val3 - 

	Стадии роста Рад-цвета:
	0 - семечко
	1 - семечко в земле
	2 - росток
	3 - взрослое растение
	
*/

void _InitPlant(Item& item, bool firstTime)
{
	if(firstTime)
	{
		uint16 proto = item.GetProtoId();
		
		if(proto!=PID_PLANT_RADCVET) return;
		
		if(!hashes_inited) init_hashes();
		
		//item.Val1=Random(0, 1)*3;
		
		uint[]@ data=hashes_plant[HASHES_PLANT_RADCVET];
		
		if(data[2*item.Val1]!=0) item.PicMap=data[2*item.Val1];
		if(data[2*item.Val1+1]!=0) item.PicInv=data[2*item.Val1+1];
		
		item.Val2=1;
		
		item.Info=item.Val1*10;
		
		item.Update();
	}
	
	if(item.Val1==0)
	{
		item.SetEvent(ITEM_EVENT_DROP, "_DropPlant");
		if(item.Accessory==ACCESSORY_HEX && item.Val0!=0) item.SetEvent(ITEM_EVENT_SKILL, "_SkillPlant");
	}
	
	if(item.Val1==0 || item.Val1==3)
	{
		SETFLAG(item.Flags, ITEM_CAN_USE);
	}
	else UNSETFLAG(item.Flags, ITEM_CAN_USE); 
	
	item.SetEvent(ITEM_EVENT_USE, "_UsePlant");
	
/*	
	if(!hashes_inited) init_hashes();
	uint[]@ data=hashes_plant[HASHES_PLANT_RADCVET];
	if(data[2*item.Val1]!=0) item.PicMap=data[2*item.Val1];
	if(data[2*item.Val1+1]!=0) item.PicInv=data[2*item.Val1+1];
	item.Update();
*/
}

import void AffectRadiation(Critter& cr, int value) from "radiation";
import void AffectPoison(Critter& cr, int value) from "poison";

bool _UsePlant(Item& item, Critter& cr, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{
	if(valid(onCritter) || valid(onItem) || valid(onScenery)) return false;
	
	if(item.Val1==0)
	{
		AffectRadiation(cr, 1);
		AffectPoison(cr, 1);
		
		int heal = cr.Param[ST_MAX_LIFE]-cr.Param[ST_CURRENT_HP],
		good=item.Val2;
		if(good>heal) good=heal;
		cr.ParamBase[ST_CURRENT_HP]+=good;
		DeleteItem(item);
	}
	else if(item.Val1==3)
	{
		for(uint i=0, len=Random(1, 3); i<len; i++)
		{
			Item@ pl = cr.AddItem(PID_PLANT_RADCVET, 1);
			pl.Val2=item.Val2+Random(0, 1);
		}
		DeleteItem(item);
	}
	else return false;
	
	return true;
}

void _DropPlant(Item& item, Critter& cr)
{
	Map@ map = cr.GetMap();
	if(map is null) return;
	
	if(item.Val1!=0) return;
	
	if(map.GetItems(cr.HexX, cr.HexY, null)>1)
	{
		if(cr.IsLife()) cr.Say(SAY_NETMSG, "Это тут не прорастет.");
		return;
	}
	
	item.SetEvent(ITEM_EVENT_SKILL, "_SkillPlant");
	uint time=0;
	if(CheckGard(map, cr.HexX, cr.HexY))
	{
		time=GAME_MINUTE(4);
		if(cr.IsLife()) cr.Say(SAY_NETMSG, "Плод посажен.");
	}
	else
	{
		time=GAME_DAY(2);
		if(cr.IsLife()) cr.Say(SAY_NETMSG, "Здесь плод будет проростать очень долго.");
	}
	
	item.Val0=CreateTimeEvent(__FullSecond+time, "e_ProcessPlant", item.Id, true);
}

bool _SkillPlant(Item& item, Critter& cr, int skill)
{
	if(skill==-1)
	{
		item.SetEvent(ITEM_EVENT_SKILL, null);
		if(item.Val0!=0)
		{
			EraseTimeEvent(item.Val0);
			item.Val0=0;
		}
	}
	return false;
}

uint e_ProcessPlant(uint[]@ values)
{
	if(values is null || values.length()!=1) return 0;
	
	Item@ item = GetItem(values[0]);
	
	if(item is null) return 0;
	
	uint16 pid=item.GetProtoId();
	
	if(pid!=PID_PLANT_RADCVET || item.Val0==0) return 0;
	
	if(item.Val1==0) item.SetEvent(ITEM_EVENT_DROP, null);
	else if(item.Val1>2) return 0;
	
	item.Val1+=1;
	uint Val1=item.Val1;
	
	if(!hashes_inited) init_hashes();
	
	uint[]@ data=hashes_plant[HASHES_PLANT_RADCVET];
	
	if(data[2*Val1]!=0) item.PicMap=data[2*Val1];
	if(data[2*Val1+1]!=0) item.PicInv=data[2*Val1+1];
	
	item.Info=item.Val1*10;
	
	if(item.Val2<=2) item.Val2+=Random(0, 1);
	else item.Val2+=Random(-2,2);
	
	if(Val1==1)
	{
		SETFLAG(item.Flags, ITEM_HIDDEN);
		item.Update();
		return GAME_HOUR(12);
	}
	else if(Val1==2)
	{
		UNSETFLAG(item.Flags, ITEM_CAN_USE); 
		UNSETFLAG(item.Flags, ITEM_HIDDEN);
		item.Update();
		return GAME_HOUR(12);
	}
	else if(Val1==3)
	{
		SETFLAG(item.Flags, ITEM_CAN_USE);
		item.Val0=0;
		item.Update();
		return 0;
	}
	
	return 0;
}