/**
 убивает NPC
 в параметрах указывается вид смерти и номер NpcRole.
 Убивает всех с этой ролью на карте!
 (карта используется та где стоит игрок в момент активации)
 v0-тип смерти
 v1-Role
 param=2
*/
int KillNpcByRole(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	Map@ map=player.GetMap();
	uint count=map.GetNpcCount(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC);
	for(uint i=0; i<count; i++)
		map.GetNpc(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC, i).ToDead(v0, null);
	return 0;
}

/**
 убивает NPC на определенной карте
 в параметрах указывается вид смерти, номер NpcRole и номер карты.
 Убивает всех с этой ролью на карте!
 v0-тип смерти
 v1-Role
 v2-Map PID
 param=3
*/
int KillNpcOnMapByRole(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	Map@ map=GetMapByPid(v2, 0);
	uint count=map.GetNpcCount(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC);
	for(uint i=0; i<count; i++)
		map.GetNpc(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC, i).ToDead(v0, null);
	return 0;
}

