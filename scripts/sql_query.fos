#define MYSQL_TABLE_CHARACTERS  ("CREATE TABLE `characters` (  `charId` int(10) unsigned NOT NULL AUTO_INCREMENT,  `forumId` decimal(10,0) DEFAULT NULL,  `charNameReal` tinytext,  `charNameView` tinytext,  `charPass` tinytext,  `charStatus` tinyint(1) DEFAULT NULL,  PRIMARY KEY (`charId`))")
#define MYSQL_TABLE_CHARACTERS_NAMES ("create table `tnf`.`characters_names`(  `id` int(10) ,   `name` text(20) ,   `hash` text(20) ) ;")

bool MysqlCreateTables(){

    MysqlInit();

    if(MysqlConnect(true)){
        if(MysqlSelectDb() == 0){

            string query = "";

            MysqlQuery(MYSQL_TABLE_CHARACTERS);
            MysqlQuery(MYSQL_TABLE_CHARACTERS_NAMES);

            MysqlClose();
        }
    }

    return true;
}

void createtables(Critter& cr, int, int, int){MysqlCreateTables();}

