class EffectStat
{
	int Stat;
	int Amount;
	
	EffectStat(int stat, int amount){
		Stat = stat;
		Amount = amount;
	}
	
	int GetStat(){return Stat;}
	int GetAmount(){return Amount;}
}

class EffectStage
{
	EffectStat[]		EfStats;
	
	uint8			StageType;
	
	uint			Duration;
	
	EffectStage(uint dur, uint8 type){
		Duration = dur;
		
		StageType = type;
		
		EfStats.resize(0);
	}
	
  
	EffectStage(EffectStat[] efStats, uint dur, uint8 type){
		Duration = dur;
		StageType = type;
		EfStats = efStats;
	}
	
	uint GetDuration(){return Duration;}
	
	uint GetStageType(){return StageType;}
	
	EffectStat@ GetEffectStat(uint8 index){
		if(index < EfStats.length()){
			return EfStats[index];
		}
		
		return null;
	}
	
	uint8	GetEffectStatLen(){
		return EfStats.length();
	}
	
	void InsertStat(EffectStat efStat){
		EfStats.insertLast(efStat);
	}
	
	void InsertStat(uint stat, uint amount){
		EfStats.insertLast(EffectStat(stat, amount));
	}
	
	void StageRelease(Critter& cr){
	  
		if(StageReleaseExt(cr)) return;
	  
		//fonline sdk code implemented for class
		for(uint8 i = 0, j = EfStats.length(); i < j; i++){
			
			int stat = EfStats[i].GetStat();
			int amount = EfStats[i].GetAmount();
		
			if( i == 1 && EfStats[0].GetStat() == -2 )
				amount = Random( EfStats[0].GetAmount(), amount );                                              // Take first
			if( stat < 0 )
				continue;

			int statVal = cr.Stat[ stat ];
		
			if( stat < STAT_EXT_BEGIN )
				cr.StatBase[ STAT_EXT_BEGIN + stat ] += amount;
			else if( stat == ST_CURRENT_HP ){
				cr.StatBase[ ST_CURRENT_HP ] = CLAMP( statVal + amount, -9999, cr.Stat[ ST_MAX_LIFE ] );
			
				if( amount < 0 && cr.Stat[ ST_CURRENT_HP ] < 0 ){
					cr.ToDead( Random( 0, 1 ) == 0 ? ANIM2_DEAD_FRONT : ANIM2_DEAD_BACK, null );
				}else if( stat == ST_POISONING_LEVEL ){
					AffectPoison( cr, amount );                                        // cr.SetStat(ST_POISONING_LEVEL,CLAMP(statVal+amount,0,2000));
				}else if( stat == ST_RADIATION_LEVEL ){
					AffectRadiation( cr, amount );                                     // cr.SetStat(ST_RADIATION_LEVEL,CLAMP(statVal+amount,0,2000));
				}
			}else
				continue;

			statVal = cr.Stat[ stat ] - statVal;
            
			if( statVal > 0 )
				cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_STAT_GAIN, "$name @msg game " + STR_PARAM_NAME( stat ) + "@$value" + statVal );
			else if( statVal < 0 )
				cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_STAT_LOSE, "$name @msg game " + STR_PARAM_NAME( stat ) + "@$value" + ( -statVal ) );
		}
	}
	
	//false to continue StageRelease() true to break
	bool StageReleaseExt(Critter& cr){
		return false;
	}
}

class EffectStageJetAntidote : EffectStage
{
	EffectStageJetAntidote(uint dur, uint type){
		Duration = dur;
		StageType = type;
	}
	
	bool StageReleaseExt(Critter& cr){
	
		uint[] rates;
		uint count = cr.GetTimeEvents( PID_JET, null, null, rates );
		for( uint i = 0; i < count; i++ )
			//FU!!!
			effects[EFFECT_JET_ANDTIDOTE].DropDrug( cr, PID_JET, this );
			cr.EraseTimeEvents( PID_JET );
			if( count > 0 && cr.Addiction[ ADDICTION_JET ] != 0 ){
				cr.AddictionBase[ ADDICTION_JET ] = 0;
				cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_ADDICTION_END );
			}else
				cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_NOTHING_HAPPENS );
		return true;
	}
}

class Effect
{
	EffectStage[]		Stages;
  
	int			AddictionID;
	int			AddictionPerc;
	
	Effect(int addiction, int addictionPerc){
		AddictionID = addiction;
		AddictionPerc = addictionPerc;
		
		Stages.resize(0);
	}
    
	Effect(int addiction, int addictionPerc, EffectStage[] stages){
		AddictionID = addiction;
		AddictionPerc = addictionPerc;
		
		Stages = stages;
	}
	
	void InsertStage(EffectStage stage){
		Stages.insertLast(stage);
	}
	
	bool Addiction(Critter& cr, uint16 drugPid){
		//original sdk code implemented for class
		
		uint flags = 0;
		
		if( cr.Trait[ TRAIT_CHEM_RELIANT ] != 0 )
			flags |= DRUG_EFFECT_DIV2_WITHDRAWAL | DRUG_EFFECT_MUL2_ADDICTION;
		
		if( cr.Trait[ TRAIT_CHEM_RESISTANT ] != 0 )
			flags |= DRUG_EFFECT_DIV2_ADDICTION | DRUG_EFFECT_DIV2_DURATION;
		
		// Other drugs
		uint[] indexes;
		uint[] rates;
		uint count = cr.GetTimeEvents( drugPid, indexes, null, rates );
		
		uint stageslen = Stages.length();
		
		uint stage = 0;
		
		// Check
		if( AddictionID >= 0 ){ // Addiction perk aviability
		
			uint positive = 0;
			uint negative = 0;

		
			for( uint i = 0; i < count; i++ ){
				 stage = RATE_TO_STAGE( rates[ i ] );
				 
				if(stage < stageslen){
			
					if( Stages[stage].GetStageType() <= STAGE_WITHDRAWAL )
						positive++;
					else if( Stages[stage].GetStageType() == STAGE_NORMALIZE )
						negative++;
				}
			}

			if( positive >= 2 - negative / 2 ){
			
				int addictProc = AddictionPerc;
		      
				if( FLAG( flags, DRUG_EFFECT_MUL2_ADDICTION ) )
					addictProc *= 2;
			
				if( FLAG( flags, DRUG_EFFECT_DIV2_ADDICTION ) )
					addictProc /= 2;
	      
				if( cr.Addiction[ AddictionID ] == 0 && Random( 1, 100 ) <= addictProc )
					cr.AddictionBase[ AddictionID ] = 1;
				else
					cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_NOTHING_HAPPENS );
				
				return true;
			}
		}
		
		// Clear active addictions
		uint deleted = 0;   // After erase indexes decrement on one position
		for( uint i = 0; i < count; i++ ){
			stage = RATE_TO_STAGE( rates[ i ] );
			
			if(stage < stageslen){
		      
				if( Stages[stage].GetStageType() >= STAGE_ADDICTION_BEGIN ){
					DropDrug( cr, drugPid, Stages[i] );
					cr.EraseTimeEvent( indexes[ i ] - deleted );
					deleted++;
				}
			}
		}
		
		//Log("run time!");
		// Set critter time event
		cr.AddTimeEvent( "cte_Drug", 0, drugPid, FORM_RATE( 0, flags ) );
		    
		return false;
	}
	
	void DropDrug(Critter& cr, uint16 drugPid, EffectStage stage){
	  
		
		//original sdk code implemented for class
		if( stage.GetStageType() == STAGE_INSTANT_EFFECT || stage.GetStageType() == STAGE_ADDICTION_BEGIN )
			return;                           // Instant effect not happens or already normalize or wait Addidional effect

		if( stage.GetStageType() == STAGE_WITHDRAWAL || // Instant effect already
		stage.GetStageType() == STAGE_NORMALIZE || // Withdrawal already
		stage.GetStageType() == STAGE_ADDICTION_END ){  // Addiction already
		
			for( uint i = 0, j = stage.GetEffectStatLen(); i < j; i++ ){
				int stat = stage.EfStats[i].GetStat();
				//wtf?!
				int amount = stage.EfStats[i].GetAmount() + ( stage.GetStageType() == 1 ? -1 : 0 ); // Turn
            
				if( stage.GetStageType() == STAGE_WITHDRAWAL )
					amount = -amount;
				if( stat < STAT_EXT_BEGIN )
					cr.StatBase[ STAT_EXT_BEGIN + stat ] += amount;
			}
		}
	}
	
	uint Stage(Critter& cr, uint8 stage, uint16 drugPid, uint flags){
		//int addict = DrugEffects[ index + TABLE_DRUG_ADDICT ];
		
		if(stage >= Stages.length()){cr.Say(SAY_NETMSG, "oops! wrong stage");Log("wrong stage id "+cr.Id); return 0;}
		
		//original sdk code implemented for class
		uint duration = 0;
		
		if( Stages[stage].GetStageType() == STAGE_INSTANT_EFFECT ){     // To withdrawal
			duration = Stages[stage].GetDuration();
			
			if( FLAG( flags, DRUG_EFFECT_DIV2_DURATION ) )
				duration /= 2;
	      
			// Try set addiction perk
			int addictProc = AddictionPerc;
			if( FLAG( flags, DRUG_EFFECT_MUL2_ADDICTION ) )
				addictProc *= 2;
            
			if( FLAG( flags, DRUG_EFFECT_DIV2_ADDICTION ) )
				addictProc /= 2;
	      
			if(AddictionID >= 0 && Random( 1, 100 ) <= addictProc )
				cr.AddictionBase[ AddictionID ] = 1;
			
		}else if( Stages[stage].GetStageType() == STAGE_WITHDRAWAL ){     // To normalize
			duration = Stages[stage].GetDuration();
	      
			if( FLAG( flags, DRUG_EFFECT_DIV2_DURATION ) )
				duration /= 2;
			
		}else if( Stages[stage].GetStageType() == STAGE_NORMALIZE && AddictionID >= 0 && cr.Addiction[ AddictionID ] != 0 ){ // To addiction
			// Find already processed addiction
			uint[] rates;
			uint count = cr.GetTimeEvents( drugPid, null, null, rates );
			bool isPresent = false;
			
			for( uint i = 0; i < count; i++ ){
				if( RATE_TO_STAGE( rates[ i ] ) >= 3 ){
					isPresent = true;
					break;
				}
			}
            
			if( not isPresent )
				duration = Stages[stage].GetDuration();
			
		}else if( Stages[stage].GetStageType() == STAGE_ADDICTION_BEGIN ){     // To end of addiction
			duration = Stages[stage].GetDuration();
            
			if( FLAG( flags, DRUG_EFFECT_DIV2_WITHDRAWAL ) )
				duration /= 2;
			
		}else if( Stages[stage].GetStageType() == STAGE_ADDICTION_END ){    // End of addiction
			cr.SayMsg( SAY_NETMSG, TEXTMSG_GAME, STR_DRUG_ADDICTION_END );
	      
			if( AddictionID >= 0 && cr.Addiction[ AddictionID ] != 0 )
				cr.AddictionBase[ AddictionID ] = 0;
		}
		
		return duration;
	}
}

