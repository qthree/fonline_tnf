//Flash grenade. Author binyan. version 0.5
#include "_macros.fos"
#include "_colors.fos"
import void FlushScreen(Critter& cr, uint fromColor, uint toColor, uint timeMs) from "effects";


void ApplyFlashEff(Critter& target, uint min)
{
uint perc = target.StatBase[ST_PERCEPTION], bLook = target.StatBase[ST_BONUS_LOOK];

if(target.IsPlayer())
{
uint ms = (min*60/__TimeMultiplier)*1000;
FlushScreen(target, COLOR_WHITE, COLOR_WHITE, ms);//Белим экран
target.StatBase[ST_BONUS_LOOK] = -100;//Ухушаем видимость
target.RefreshVisible();  
}

target.AddTimeEvent("ReturnLook",min,perc|(bLook<<16));//Добавляем таймаут на восстановление зрения
target.StatBase[ST_PERCEPTION]=0; //Сбиваем восприятие на нет
}

uint ReturnLook (Critter& cr, int val, uint& rate)
{
if(cr.IsPlayer())
  {
    cr.StatBase[ST_BONUS_LOOK] = (val>>16)&0xFFFF; //Возвращаем зрение
    cr.RefreshVisible(); 
  }
cr.StatBase[ST_PERCEPTION]= (val)&0xF;//Возвращаем восприятие
return 0;
}
