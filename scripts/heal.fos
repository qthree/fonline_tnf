                    }                                                           // cr.Say(SAY_NETMSG,"booze");
                }

                else if( drugProtoId == PID_MULTI_TOOL )                        // low multytool
                {
                    if( !FLAG( flag, HEAL_MULTYTOOL ) )
                    {
                        drugIndexs[ 1 ] = i;
