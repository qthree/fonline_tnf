import void InjureCritter(Critter& cr, uint dmg, uint dmgType, uint8 dir, uint attackerId) from "combat";
import bool AddAttackPlane(Critter& npc, uint priority, Critter& target) from "npc_planes";
import uint EraseAttackPlane(Critter& npc, Critter& target) from "npc_planes";

// радиус поиска НПС для предупреждения
#define WARN_DIST (10)

// 'помеченный' план
#define AI_PLANE_ATTACK_PRIORITY_MARK (AI_PLANE_ATTACK_PRIORITY+3)

/** выдать стандартное предупреждение
 Текст: "Стоять! Не подходи!" / "Hey you! Do not approach!"
 param=1
 type=trigger
*/
int Warn(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Critter@ _npc=GetNearCritterWithRole(player.GetMap(), x, y, WARN_DIST, v0);
	if(not valid(_npc)) return 0;
	_npc.SayMsg(SAY_NORM_ON_HEAD, TEXTMSG_TEXT, 1001);
	return 0;
}

/** сказать
 ищет ближайшего критерра в радиусе 10 клеток у которого роль равна v0
 после чего тот говорит из своего диалога строку с номером v1
 param=2
 type=trigger
*/
int Say(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Critter@ _npc=GetNearCritterWithRole(player.GetMap(), x, y, WARN_DIST, v0);
	if(not valid(_npc)) return 0;
	_npc.SayMsg(SAY_NORM_ON_HEAD, TEXTMSG_DLG, DLGSTR(npc.Stat[ST_DIALOG_ID],v1));
	return 0;
}

