}

class CCharacterGameModeSelect : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
{

    CRegisterScreen@ Instance;
    // InputCode @ Code;

    uint8       State;
    uint16      GameMode;

    string[]    BtnName;

    IGUIElementOpt@ Options;

    // uint8 ButtonNumber;

    CCharacterGameModeSelect( CRegisterScreen & instance)
    {
        @Instance = instance;
        GameMode = 2;//Instance.Param[QST_GAMEMODE];
        //GetOutParam(QST_GAMEMODE, GameMode);
        State = GameMode;
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();


        BtnName.insertLast("Приключенец");
        BtnName.insertLast("Выживалец");
        BtnName.insertLast("Аркада");


        //GetOutParam(QST_GAMEMODE, GameMode);
        //GameMode = Instance.Param[QST_GAMEMODE];

        //OnMouseClick( 0 );

        SetText();
    }

    void OnMouseClick( int click )
    {
            if(State < GAME_ARCADE){
                State++;
            }else{
                State = GAME_ADVENTURE;
            }

            Message("state "+State);

            //State = CLAMP(State, GAME_ADVENTURE, GAME_ARCADE);

            GameMode = State;
            //SetOutParam(QST_GAMEMODE, GameMode);
            Instance.Param[QST_GAMEMODE] = GameMode;

            SetText();

            Instance.ParamDropChageGamemode();
    }

    void SetText(){
            Message("text "+(State-GAME_ADVENTURE));
            Options.Text(""+BtnName[State-GAME_ADVENTURE], FONT_BIG, COLOR_SAND, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }
}


class CCharacterAgeBtn : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
