class CCharacterSkinSelectorImage : IGUIElementCallbackInit
{
    int8 Dir;

    CRegisterScreen@ Instance;
    IGUIElementOpt@            Options;

    CCharacterSkinSelectorImage( CRegisterScreen & instance )
    {
        @Instance = instance;
        @Instance.SkinImage = this;

        Dir = 3;
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();

        LoadAnimationIndex();
        //Instance.Count = __baseCrType;
        Instance.Count = 0;//Instance.Param[ST_BASE_CRTYPE];
        Instance.SetSkinImage( Instance.Count, 3 );
    }

    void SetPic( uint8 index, int8 dir )
    {
        //Options.Pic( "" + animIndex[ index ] + "AA.frm", PT_ART_CRITTERS );

        Dir = CLAMP(dir, 0, 5);

        uint hash = GetStrHash("art\\critters\\"+animIndex[ index ]+"AA.frm");
        Options.PicHash( hash, Dir );
        Options.PicSetFrmCount(1);
    }

    uint8 GetDir(){return Dir;}
}

class CCharacterSkinSelectButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
{

    CRegisterScreen@ Instance;
    // InputCode @ Code;

    uint8 ButtonClass;
    // uint8 ButtonNumber;

    CCharacterSkinSelectButton( CRegisterScreen & instance, uint8 btnClass )
    {
        @Instance = instance;
        ButtonClass = btnClass;
    }

    void OnInit()
    {}

    void OnMouseClick( int click )
    {

        int8 dir = Instance.SkinImage.GetDir();

        switch( ButtonClass )
        {
        case BUTTON_DONE:
            ::HideScreen( 0, 2, 2, 2 );
            break;
        case BUTTON_UP:
            Instance.Count >= animIndex.length() - 1 ? Instance.Count = 0 : Instance.Count++;
            Instance.SetSkinImage( Instance.Count,  dir);
            //__baseCrType = crTypes[ Instance.Count ];
            Instance.Param[ST_BASE_CRTYPE] = crTypes[Instance.Count];
            break;

        case BUTTON_DN:
            Instance.Count <= 0 ? Instance.Count = animIndex.length() - 1 : Instance.Count--;
            Instance.SetSkinImage( Instance.Count, dir );
            //__baseCrType = crTypes[ Instance.Count ];
            Instance.Param[ST_BASE_CRTYPE] = crTypes[Instance.Count];
            break;

        case BUTTON_LF:

            dir++;
            if(dir > 5) dir = 0;

            Instance.SetSkinImage( Instance.Count, dir );
            break;

        case BUTTON_RT:

            dir--;
            if(dir < 0) dir = 5;

            Instance.SetSkinImage( Instance.Count, dir );
            break;
        }
        // Message(""+Instance.Count+" "+__baseCrType+" "+crTypes[Instance.Count]);
    }
}

void SetCrtype( int[]& params )
{
    params[ ST_BASE_CRTYPE ] = __baseCrType;
    params[ ST_BODY_TYPE ] = __baseCrType;
}

void LoadAnimationIndex()
{
    string@[] @ temp_anim = split( GetMsgStr( TEXTMSG_GAME, STR_ANIM_INDEX ), " " );
    string@[] @ temp_crtype = split( GetMsgStr( TEXTMSG_GAME, STR_CRTYPE ), " " );

    uint8 len_anim = temp_anim.length();

    if( len_anim != temp_crtype.length() )
    {
        Message( "Length of critter types not equel, Send this message to developers" );
        return;
    }

    crTypes.resize( 0 );
    animIndex.resize( 0 );

    int temp = 0;
    for( uint8 i = 0; i < len_anim; i++ )
    {
        animIndex.insertLast( temp_anim[ i ] );
        StrToInt( temp_crtype[ i ], temp );
        crTypes.insertLast( temp );

        // Message(""+crTypes[i]+" "+temp_crtype[i]);
        // Message(""+crTypes[i]);
    }
}

class CCharacterGenderSelect : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
