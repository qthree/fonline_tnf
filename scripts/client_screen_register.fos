/*
    fields :
    health          7      ST_MAX_LIFE
    action points   8      ST_ACTION_POINTS
    armor class     9      ST_ARMOR_CLASS
    melee damage    10     ST_MELEE_DAMAGE
    carri weight    11     ST_CARRY_WEIGHT
    seqence         12     ST_SEQUENCE
    healing rate    13     ST_HEALING_RATE
    critical chance 14     ST_CRITICAL_CHANCE
    normal resist   23     ST_NORMAL_RESIST
    poison resist   31     ST_POISON_RESISTANCE
    rad     resist  30     ST_RADIATION_RESISTANCE

*/

/*
    prfsldof.frm - btnskill up
    prfsldof.frm - btnskill down
    prfxout.frm - perk btn up
    prfxin.frm - perk btn down

    snegoff.frm - minus btn up
    snegon.frm - minus btn down

    splsoff.frm - plus btn up
    splson.frm - plus btn down


    stnegoff.frm - minus btn up
    stnegon.frm - minus btn down

    stplsoff.frm - plus btn up
    stplson.frm - plus btn down

    tgskloff.frm - tag off
    tgsklon.frm - tag off

    tnf_reg_stat_box.png

    nameoff.frm - namebox;

    bigredup.frm - big red btn
    bigreddb.frm

    karmafdr.frm    - trait btn
    killsfdr.frm    - perks btn
    perksfdr.frm    - info  btn

    regInfoBtnMask.png
    regTraitBtnMask.png
    regPerkBtnMask.png

    femoff.frm  - girl btn
    femon.frm   - girl btn press
    maleoff.frm - mab btn
    maleon.frm  - man btn press

*/

CRegisterScreen@ outRegScreen;

void InitRegisterScreen()
{
    /*CLoginInputBox LoginInputPass(true);
    GUI_AddScreenElement( CLIENT_MAIN_SCREEN_LOGIN, "loginscreen_input_up.png", 120, 60 )
    .CallbackMouseClick( LoginInputPass )
    .CallbackInit(LoginInputPass)
    .DownPic( "loginscreen_input_dn.png" );*/

    CRegisterScreenShow regShow();
    GUI_AddScreenElement( CLIENT_MAIN_SCREEN_GAME, "ebut_out.frm", 300, -100 )
    .CallbackInit( regShow )
    .CallbackMouseClick( regShow )
    // .Position(GetIfaceIniStr("RegChaSel"))
    .DownPic( "ebut_in.frm" );

    CRegisterScreen RegScreen;
    GUI_CreateScreen( CLIENT_SCREEN_REG_TNF, "tnf_reg_screen.png" )
    .CallbackShow( RegScreen )
    .CallbackHide( RegScreen )
    //.CallbackMove( LoginScreen )
    .CanMove( false )
    // .Position(155,111)
    .Modal( false )
    .Multiinstance( true );

    @outRegScreen = RegScreen;

