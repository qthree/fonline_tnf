class CCharacterName : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackKeyPress
{
    string Name;
    CCharacterScreen@ Instance;
    IGUIElementOpt@ Options;

    CCharacterName(CCharacterScreen& instance){
        @Instance = instance;
        @Instance.NameBox = this;
    }

    void OnMouseClick(int click){
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();
	
	Options.Text( __Name, FONT_BIG, COLOR_SAND, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
    }
/*
     void OnKeyPress( uint8 key, uint8 letter ){
        if(letter == 'a'){Message("TEST!");}
    }*/

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
    }

    void OnKeyPress( uint8 key, uint8 letter )
    {
        string@ text = Options.GetText();
        // string@ text2 = ""+key;
        if( text.length() > 0 && text[ text.length() - 1 ] == '\n' )
            text.resize( text.length() - 1 );

        Options.Text( text, FONT_BIG, COLOR_SAND, COLOR_GREEN, FT_CENTERX | FT_CENTERY );

    }
}

