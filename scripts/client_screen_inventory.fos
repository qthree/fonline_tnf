		Instance.ListSelectedPr = Instance.ListSelected;

	}

	void OnDraw()
	{
		string text0 = ""/*"no item"*/, text1 = "", name = "";
		int offsX = 0, x = 0, y = 0, xOff = Instance.screenOpt.GetPosX() + Options.GetPosX(), yOff = Instance.screenOpt.GetPosY() + Options.GetPosY();
		if(InvItemIndex != uint16(-1) && Instance.InventoryItems.length() > InvItemIndex && Instance.InventoryItems[InvItemIndex] !is null) //< Instance.InventoryItems.length())
		{
			offsX = Instance.InventoryItems[InvItemIndex].TextW0+Instance.InventoryItems[InvItemIndex].TextW1;
			text0 = (Slot == SLOT_INV ? Instance.InventoryItems[InvItemIndex].Text0 : "");
			text1 = (Slot == SLOT_INV ? Instance.InventoryItems[InvItemIndex].Text1 : "");
			name  = Instance.InventoryItems[InvItemIndex].Name;
		}else{}

		DrawText(""+text0+name, 3+x+xOff, 5+y+yOff, 500 , 400, COLOR_SAND, FONT_FALLOUT,  0);
		DrawText(""+text1, x+xOff+offsX-5, 5+y+yOff, 500 , 400, COLOR_SAND, FONT_FALLOUT,  0);
	}

	void PressPic(bool press)
	{
		if(Slot != SLOT_INV){
			Options.UpPic(press/* && (Instance.ListSelected == Instance.ListSelectedPr)*/  ? "invItemDownMini.png" : "invItemUpMini.png");
		}else{
			Options.UpPic(press/* && (Instance.ListSelected == Instance.ListSelectedPr)*/ ? "invItemDn.png" : "invItemUp.png");
		}
	}
}

