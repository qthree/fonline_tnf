class CCharacterScreenShow : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
{
    IGUIElementOpt@ Options;

    // ScreenMain@ Instance;
    // InputCode @ Code;

    // uint8 ButtonClass;
    // uint8 ButtonNumber;
/*
        NumberButton(ScreenMain& instance)
        {
                @Instance=instance;
                @Instance.Button=this;
        }
 */
    void OnInit()
    {
        @Options = GUI_GetElementOptions();
        Options.SetVisible(GetChosen().Param[QST_GAMEMODE] == GAME_START);
    }

    void OnMouseClick( int click )
    {
        ::ShowScreen( CLIENT_SCREEN_CHARACTER, 0, 0, 0 );
    }
}

