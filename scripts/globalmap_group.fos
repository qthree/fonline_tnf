}

#define GMAP_DEEP	(1)
#define GMAP_WIDTH	(350)
#define GMAP_HEIGH	(600)
#define GMAP_CELL_SIZE	(10)
#define GMAP_SYMBOL_WATER (-1)
#define GMAP_SYMBOL_STATIC (-2)
#define GMAP_SYMBOL_ROAD (-3)
#define GMAP_SYMBOL_MOUNTAIN (-4)
#define GMAP_SYMBOL_RAILROAD (-5)

void ParseGlobalMapPic(bool parseStatic){

	//string line = "";

	Log("map x:y "+__GlobalMapWidth+" : "+__GlobalMapHeight);

	int[][] cellsxy;

	for(uint16 y = 0; y < /*__GlobalMapHeight*/GMAP_HEIGH; ++y){

		int[] a;
		cellsxy.insertLast(a);

		int[]@ cellx = cellsxy[y];

		ParseLine(cellx, y);

		//Log("cellsx.length "+cellx.length());

	/*	if(y % 10 == 0){
			line += "\n";
		}*/
	}

	int[]@ aa = cellsxy[cellsxy.length()-1];

	//Log("x "+aa.length()+" y "+cellsxy.length());

	int[][] cells;
	//cells.resize(

	for(uint16 y = 0, yy = cellsxy.length(); y < yy; ++y){

		bool isWater = false;
		bool isRoad = false;
		bool isMountain = false;
		bool isRailroad = false;
		int tempx = 0;

		int[] a;
		cells.insertLast(a);

		int[]@ temp = cellsxy[y];

		for(uint16 x = 0, xx = cellsxy[y].length(); x < xx; ++x){

            if(temp[x] == GMAP_SYMBOL_MOUNTAIN){
				isMountain = true;
			}else if(temp[x] == GMAP_SYMBOL_WATER){
				isWater = true;
			}else if(temp[x] == GMAP_SYMBOL_ROAD){
				isRoad = true;
			}else if(temp[x] == GMAP_SYMBOL_RAILROAD){
				isRailroad = true;
			}

			tempx +=  temp[x];

			if(x % GMAP_CELL_SIZE == 0){
				int[]@ cellsx = cells[y / GMAP_CELL_SIZE];

				if(isWater){
					cellsx.insertLast(parseStatic ? GMAP_SYMBOL_WATER : 0x0000ff);
					isWater = false;
				}else if(isRoad){
					cellsx.insertLast(parseStatic ? GMAP_SYMBOL_ROAD : 0xffffff);
					isRoad = false;
				}else if(isMountain){
					cellsx.insertLast(parseStatic ? GMAP_SYMBOL_MOUNTAIN : 0x000000);
					isMountain = false;
				}else if(isRailroad){
					cellsx.insertLast(parseStatic ? GMAP_SYMBOL_RAILROAD : 0xed1c24);
					isRailroad = false;
				}else{


					Cell@ cell = world.GetCell(x / GMAP_CELL_SIZE, y / GMAP_CELL_SIZE);
					bool isStatic = (parseStatic && cell !is null && cell.Content !is null && cell.Content.Type == CELLMAP_TYPE_STATIC);

					if(isStatic){

						cellsx.insertLast(GMAP_SYMBOL_STATIC);

					}else{
						//cellsx.insertLast(tempx / GMAP_CELL_SIZE / GMAP_DEEP);
						cellsx.insertLast(0);
					}

				}

				tempx = 0;
			}
		}
	}

	string line = "";

	for(uint16 j = 0, jj = cells.length(); j < jj; ++j){
		int[]@ a = cells[j];

		if(a.length() > GMAP_WIDTH * 0.1){
			a.resize(GMAP_WIDTH * 0.1);
		}

		string temp = ParseMakeLine(a);
		line+=temp;

	}

	if(line.length() != 0){
		ParseSave(line);
	}

}

void ParseLine(int[]& a, uint16 y){
	for(uint16 x = 0; x < /*__GlobalMapWidth*/GMAP_WIDTH; ++x){
			int hash = /*int(GetGlobalMapRelief(x, y));*/GetImageColor( IMAGE_RELIEF_TNF, x, y );
			//uint@[] cell = cells[y];

            if(hash == 0x000000) {hash = GMAP_SYMBOL_MOUNTAIN; Log("mount");}
			if(hash == 0xffffff) {hash = GMAP_SYMBOL_ROAD;/* Log("road");*/}
			if(hash == 0x0000ff) {hash = GMAP_SYMBOL_WATER;/* Log("water");*/}
			if(hash == 0xed1c24) {hash = GMAP_SYMBOL_RAILROAD;/* Log("water");*/}


			a.insertLast(hash);
			/*if(x != 0 && x % 10 == 0){

				uint summ = 0;

				for(uint8 i = 0, j = cell.length(); i < j; ++i){
					summ += cell[i];
				}

				summ /= cell.length();

				line += summ+"\t";

			}*/
			//Log("X:Y "+x+":"+y+"\ncolor "+hash);
		}
}

string ParseMakeLine(int[]& a){
	string rtn = "";
	//Log("a size "+a.length());
	for(uint i = 0, j = a.length(); i < j; ++i){

		string addSymbol = "";

		switch(a[i]){
			case GMAP_SYMBOL_WATER : addSymbol = "W"; break;
			case GMAP_SYMBOL_STATIC : addSymbol = "S"; break;
			case GMAP_SYMBOL_ROAD : addSymbol = "R"; break;
			case GMAP_SYMBOL_MOUNTAIN : addSymbol = "M"; break;
			case GMAP_SYMBOL_RAILROAD : addSymbol = "L"; break;
			//case GMAP_SYMBOL_FOREST : addSymbol = "F"; break;
			//case GMAP_SYMBOL_RUINS : addSymbol = "U"; break;
			default : addSymbol = ""+((a[i] > 0 ? a[i] & 0xF : a[i])); break;
		}

		rtn += addSymbol+(i+1 != j ? "\t" : "\n");
	}

	/*
	rtn.resize(rtn.length()-1);
	rtn.insertLast('\n');
	*/
	return rtn;
}

void ParseSave(string line){

	file f;

	if(f.open(".\\global_parse.txt", "w") != -1){
		//string line = "";

		f.writeString(line);

		Log("SAVE");

		f.close();
	}
}

#define ONLY_ROAD	(true)

#define FILE_GLOBAL_BIOM	(".\\global_parse.txt")
#define FILE_GLOBAL_HEIGH	(".\\global_parse_heigh.txt")

#define FILE_GLOBAL_BIOM_OUT	(".\\global_map_biom.txt")
#define FILE_GLOBAL_HEIGH_OUT	(".\\global_map_heigh.txt")

bool saveglobalmaptofile(){
	string lineB = "", lineH = "";
	for(uint i = 0; i < (world.CellsW * world.CellsH); i++){
		lineB += world.Cells[i].BiomType+"\t";
		lineH += world.Cells[i].DefaultLevel+"\t";
		
		if(i % world.CellsW == 0){
			lineB[lineB.length()-1] = '\n';
			lineH[lineH.length()-1] = '\n';
		}
	}
	
	file mapBiom;
	file mapHeigh;
	
	if(mapBiom.open(FILE_GLOBAL_BIOM_OUT, "w") != -1){
		mapBiom.writeString(lineB);
	}
	
	if(mapHeigh.open(FILE_GLOBAL_HEIGH_OUT, "w") != -1){
		mapHeigh.writeString(lineH);
	}
	
	return true;
}
