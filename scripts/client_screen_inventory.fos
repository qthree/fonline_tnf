		uint8 prevIndex = Instance.ItemList.prevIndex;
		
		InventoryItem tempInvItem = Instance.ItemList.InventoryItems[Instance.InventoryButtons[prevIndex].InvItemIndex];
		
		switch(Type)
		{
			case INVENTORY_ITEMS_LIST_UP 		: Instance.ItemList.MoveItemList(true, false); break;
			case INVENTORY_ITEMS_LIST_DOWN		: Instance.ItemList.MoveItemList(false, false); break;
			case INVENTORY_ITEMS_LIST_UP_FORCED	: Instance.ItemList.MoveItemList(true, true); break;
			case INVENTORY_ITEMS_LIST_DOWN_FORCED	: Instance.ItemList.MoveItemList(false, true); break;
			case INVENTORY_ITEMS_LIST_LEFT 		: {if(tempInvItem.Rolled)  {Instance.ItemList.RollUpItemArrow(prevIndex); /*Instance.InventoryButtons[prevIndex].Rolled = false;*/} break;}
			case INVENTORY_ITEMS_LIST_RIGHT 	: {if(!tempInvItem.Rolled && !tempInvItem.Child){Instance.ItemList.DropItem(prevIndex); /*Instance.InventoryButtons[prevIndex].Rolled = true;*/} break;}
			default : break;
		}
		/*
		for(uint8 i = 0, j = Instance.InventoryButtons.length(); i < j; ++i)
		{
			Message("inv undex "+Instance.InventoryButtons[i].InvItemIndex);
		}*/
		
		//Options.Text(text,FONT_FALLOUT,COLOR_GREEN, COLOR_GREEN, 0);
	}
	
	
