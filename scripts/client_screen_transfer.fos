void FormatText(string text0, string text1, IGUIElementOpt& opt, uint font, uint flags, int& rW, int& rH)
{
	int tw0 = 0, tw1 = 0, th0 = 0, th1 = 0, lines = 0;
	uint16 w = opt.GetSurfaceWidth(), h = opt.GetSurfaceHeight();
	GetTextInfo(text0, w, h, font, flags, tw0, th0, lines);
	GetTextInfo(text1, w, h, font, flags, tw1, th1, lines);
	rW = w - (tw0 + tw1);
	rH = tw0;//h - (th0 + th1);
	//Message(" "+w+" "+rW+" "+tw0+" "+tw1);
	return;
}

//ItemCl@[] contItems;
ItemTransfer@[] contItems;

void ShowTransferScreen(int param0, int param1, int param2, string@ param3, int[] @ param4){
  
    //if(param4 is null) {Message("null p4"); return;}
  
    uint itemsLen = (param4 is null ? 0 : param4.length());

    if(itemsLen % ITEM_TRANSFER_MEMBERS != 0 && itemsLen != 0) return;

    contItems.resize(0);

    uint8 temp = 0;

    //Message("pl "+itemsLen);

    //ItemCl@ tempI = null;
    ItemTransfer@ tempI = null;

    for(uint i = 0; i<itemsLen; ++i){
        //@tempI = GetItem(uint(param4[i]));
        //Message("id "+uint(param4[i]));
        if(i % ITEM_TRANSFER_MEMBERS == 0){
            @tempI = ItemTransfer(uint(param4[i]), uint(param4[i+1]), uint(param4[i+2]));//, uint(param4[i++]), uint(param4[i++]));
            if(tempI is null) continue;
            contItems.insertLast(tempI);
        }



        temp = i;
    }

    //Message("load! "+temp+" param1 "+param1);
    if(param0 > 0){
        ShowScreen(CLIENT_SCREEN_TRANSFER_TNF, 0, 0, 0);
    }else{
        screenTransfer.ItemList[0].FullRefrash();
        screenTransfer.ItemList[1].FullRefrash();
    }
}

