class CharInfoSlot : IGUIElementCallbackInit
{
	IGUIElementOpt@ Options;
	ScreenCharInfo @ Instance;
	int SlotType;
	
	CharInfoSlot(ScreenCharInfo& instance, int slot)
	{
		@Instance = instance;
		SlotType = slot;
	}
	
	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		//@Instance.ItemDesc = this;
		uint slotPicHash = 0;//GetChosen().GetSlotPtoro(SlotType);//.PicInv;
		ItemCl@[] slotItem;
		GetChosen().GetItems(SlotType, slotItem);
		if(slotItem.length() > 0) slotPicHash = slotItem[0].Proto.PicInv;
		Options.PicHash(slotPicHash, 0);
	}
}

class CharSlotDesc : IGUIElementCallbackInit, IGUIElementCallbackDraw
{
	IGUIElementOpt@ Options;
	ScreenCharInfo@ Instance;
	int TextW0;
	int TextW1;
	int SlotType;
	string Text0;
	string Text1;
	
	CharSlotDesc(ScreenCharInfo& instance, int slotType)
	{
		@Instance = instance;
		SlotType = slotType;
	}
	
	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		
		ItemCl@[] slotItem;
		GetChosen().GetItems(SlotType, slotItem);
		
		switch(SlotType)
		{
			case SLOT_ARMOR : Text0 = "Броня "; break;
			case SLOT_HAND1 : Text0 = "Рука1 "; break;
			case SLOT_HAND2 : Text0 = "Рука2 "; break;
			default : break;
		}
		
		if(slotItem.length() > 0) 
		{
			Text1 = GetMsgStr(TEXTMSG_ITEM,slotItem[0].GetProtoId()*100);
		}else
		{
			Text1 = "Нет предмета";
		}
		
		FormatText(Text0, Text1, Options, FONT_FALLOUT, FT_CENTERY, TextW0, TextW1);
	}
	
	void OnDraw()
	{
		int x = 0, y = 0, xOff = Instance.screenOpt.GetPosX() + Options.GetPosX(), yOff = Instance.screenOpt.GetPosY() + Options.GetPosY();
		DrawText(""+Text0, x+xOff, 2+y+yOff, 500 , 400, COLOR_GREEN, FONT_FALLOUT, 0);
		DrawText(""+Text1, x+xOff+TextW0+TextW1, 2+y+yOff, 500 , 400, COLOR_GREEN, FONT_FALLOUT, 0);
	}
}

