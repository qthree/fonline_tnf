void FastPanelAddToPocket(uint itemId, uint8 pocket){
    panel.Cells[PANEL_CELL_COUNT+pocket].PanelId = itemId;
}

void FastPanelKeyPress(uint8 key){
    panel.Buttons[key - 2].Options.Realese();
}

void FastPanelCellClear(){
    panel.CellsClear();
}

void ShowPanel(bool show){
    panel.ShowPanel(show);
}
