        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 0, 0, false,  PID_MARIJUANA+1));//"marijuana_low.fofrm"));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 5, 0, false,  PID_MARIJUANA+2));//"marijuana_med.fofrm"));//
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 5, PID_MARIJUANA, true,   PID_MARIJUANA+2));//"marijuana_med.fofrm"));//
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 10, PID_MARIJUANA, true,  PID_MARIJUANA+3));//"marijuana_high.fofrm"));//
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 1, 1, 10, PID_MARIJUANA, true,  PID_MARIJUANA+3));//"marijuana_high.fofrm"));//
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 1, 1, 10, PID_MARIJUANA, true,  PID_MARIJUANA+3));//"marijuana_high.fofrm"));//
        Cycles.insertLast(CPlantCycleDropSeeds(GAME_HOUR(1), 0, 1, 10, PID_MARIJUANA, true,  PID_MARIJUANA+3));//"marijuana_high.fofrm"));//
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 0, 0, false,  PID_MARIJUANA+9));
    }
}

void PlantRemoveId(uint id){
    for(uint i = 0, j = garden.length(); i < j; ++i){
        if(!(garden[i] is null) && garden[i].ItemId != id) continue;

        garden.removeAt(i);

    }
}
