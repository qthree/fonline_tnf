    void PerkSet(uint16 paramIndex){
            Param[paramIndex] = 1;
            PerkUpReg(Param, paramIndex);
    }

    void PerkUnset(uint16 paramIndex){
            Param[paramIndex] = 0;
            PerkDownReg(Param, paramIndex);
    }

    bool PerkIsAvalible(uint16 paramIndex){

            //bool r = true;

            if(paramIndex > PE_MUTATE && paramIndex < PE_ADRENALINE_RUSH) return false; //skip // 354..379
            if(paramIndex == 418) return false;
            //if(paramIndex > PE_TERMINATOR && paramIndex < PE_GECKO_SKINNING) return false;
            if(paramIndex > PE_VAULT_CITY_TRAINING  && paramIndex < PE_GECKO_SKINNING) return false;
            if(paramIndex > PE_CANNIBAL) return false;

            return true;
    }

    void PerkSetAvalible(uint16[]& perks){

            perks.resize(0);

            for(uint16 i = PERK_BEGIN; i < PERK_END; ++i){

                if(PerkIsAvalible(i)){
                    perks.insertLast(i);
                }
            }
    }

    void PerkClear(){
            for(uint16 i = PERK_BEGIN; i < PERK_END; ++i){

                if(!PerkIsAvalible(i)) continue;
                Param[i] = 0;
            }

            /*for(uint8 i = 0, j = PerkBtn.length(); i <j; ++i){
                    PerkBtn[i].IsSet = false;
                    PerkBtn[i].Switch(false);

                    PerkDesc[i].IsSet = false;
                    PerkDesc[i].Switch(false);
            }*/
    }

    void PerkMoveDown(){


            uint16      infoLen         = InfoDesc.length(),
                        infoCurrIndex   = InfoIndexCurrent[ArchiveIndex];
            uint16[] @  avalibleParam   = InfoArrayGet();

            if(infoCurrIndex+infoLen >= avalibleParam.length()-1) return;

            infoCurrIndex++;

            for(uint8 i = 0; i < infoLen; ++i){
                    //PerkDesc[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
                    //PerkBtn[i].SetParamIndex(Perks[PerksIndexCurrent+i]);
                    InfoDesc[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
                    InfoShow[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
                    //InfoBtn[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
            }

            InfoIndexCurrent[ArchiveIndex] = infoCurrIndex;
    }

    void PerkMoveUp(){

            uint16      infoLen         = InfoDesc.length(),
                        infoCurrIndex   = InfoIndexCurrent[ArchiveIndex];
            uint16[] @  avalibleParam   = InfoArrayGet();

            if(infoCurrIndex <= 0) return;

            infoCurrIndex--;

            for(uint8 i = 0; i < infoLen; ++i){
                    InfoDesc[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
                    InfoShow[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
                    //InfoBtn[i].SetParamIndex(avalibleParam[infoCurrIndex+i]);
            }

            InfoIndexCurrent[ArchiveIndex] = infoCurrIndex;
    }

    uint16[]@ InfoArrayGet(){
        return @Info[ArchiveIndex];
    }

    uint16[]@ InfoArrayGet(uint8 index){
        return @Info[index];
    }

    void SetInfo(){

        Info.resize(3);

        for(uint8 i = 0; i < 3; ++i){
            uint16[]@ arr = InfoArrayGet(i);
            if(arr != null){
                if(i == INFO_INDEX_INFO){
                    InfoSetAvalible(arr);
                }else
                if(i == INFO_INDEX_STATUS){
                    //TraitSetAvalible(arr);
                    StatusSetAvalible(arr);
                }else
                if(i == INFO_INDEX_PERK){
                    //PerkSetAvalible(arr);
                }else{
                    continue;
                }
            }
        }
    }

