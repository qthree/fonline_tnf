class CCharacterGenderSelect : IGUIElementCallbackInit, IGUIElementCallbackMouseClick // , IGUIElementCallbackDraw
{

    CCharacterScreen@ Instance;
    // InputCode @ Code;

    uint8       State;
    uint16      Gender;

    string BtnMark; //temprorary for test

    string[]    PicOff;
    string[]    PicOn;

    IGUIElementOpt@ Options;

    // uint8 ButtonNumber;

    CCharacterGenderSelect( CCharacterScreen& instance)
    {
        @Instance = instance;
        if(Instance is null) Message("null instance");
        //@Instance.GenderSelectBtn = this;
        //GetOutParam(ST_GENDER, Gender);
        Gender = 0;
        State = Gender;

        BtnMark = "";
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();

        PicOff.insertLast(GetIfaceIniStr("TnfRegGenderBtnPic0"));   //man
        PicOn.insertLast(GetIfaceIniStr("TnfRegGenderBtnPicDn0"));

        PicOff.insertLast(GetIfaceIniStr("TnfRegGenderBtnPic1"));    //girl
        PicOn.insertLast(GetIfaceIniStr("TnfRegGenderBtnPicDn1"));

        PicOff.insertLast(GetIfaceIniStr("TnfRegGenderBtnPic2"));    //robot
        PicOn.insertLast(GetIfaceIniStr("TnfRegGenderBtnPicDn2"));

        PicOff.insertLast(GetIfaceIniStr("TnfRegGenderBtnPic3"));    //supermutant
        PicOn.insertLast(GetIfaceIniStr("TnfRegGenderBtnPicDn3"));

        PicOff.insertLast(GetIfaceIniStr("TnfRegGenderBtnPic4"));    //ghoul
        PicOn.insertLast(GetIfaceIniStr("TnfRegGenderBtnPicDn4"));


        //Gender = Instance.Param[ST_GENDER];
        //Message("gender "+Gender);
        //State = Gender;

        //GetOutParam(ST_GENDER, Gender);
        SetPic();
    }

    void OnMouseClick( int click )
    {

            uint8 maxGender = GENDER_MAX;

            switch(Instance.Param[QST_GAMEMODE]){
                case GAME_ADVENTURE     : break;
                case GAME_SURVIVAL      : maxGender = 2; break;
                case GAME_ARCADE        : maxGender = 1; break;
                default                 : maxGender = 2; break;
            }

            if(State < maxGender-1){
                State++;
            }else{
                State = 0;
            }

            Gender = State;
            uint8 bodyType = 0;


            //if(Gender > 1){//for other races
                switch(Gender){
                    case GENDER_MALE        :
                    case GENDER_FEMALE      :  bodyType = BT_MEN; BtnMark = ""; break;
                    case GENDER_IT          :  bodyType = BT_ROBOT; BtnMark = "R"; break;
                    case GENDER_SUPERMUTANT :  bodyType = BT_SUPER_MUTANT; BtnMark = "M"; break;
                    case GENDER_GHOUL       :  bodyType = BT_GHOUL; BtnMark = "G"; break;
                    default                 :  bodyType = BT_MEN; break;
                }
            //}

            Instance.Param[ST_BODY_TYPE] = bodyType;
            Instance.Param[ST_GENDER] = Gender;
            //SetOutParam(ST_GENDER, Gender);
            SetPic();

            uint16 genderIndex = Instance.Param[ST_GENDER];//STR_CRTYPE_MALE + (Instance.GenderSelectBtn.GetGender() * 2);//Instance.GetGenderIndex();
            Instance.LoadAnimationIndex(genderIndex);
            Instance.SetSkinImage( 0, 3 );

            //Instance.ParamDropSoft();

    }

    void SetPic(){

            Options.UpPic(PicOff[State]);
            Options.DownPic(PicOn[State]);

            Options.Text(""+BtnMark, FONT_BIG, COLOR_GREEN, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }

    void DropBtn(){
            Gender = 0;
            State = Gender;

            SetPic();
    }

    uint16 GetGender(){return Gender;}
}

