/**
 выставляет у группы указанную в v0 квестовую переменную в v1.
 param=2
 выставляет для всей группы!
*/
int GroupSetVar(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	Critter@[] groups;
	ArrayPushBack(groups,player);
	player.GetFollowGroup(FIND_ALL,groups);
	for(uint i=0;i<groups.length();i++)
	{
		GameVar@ quest = GetLocalVar(v1, groups[i].Id);
		if (not valid(quest)) return 0;
		quest=v2;
		groups[i].SendQuestVar(quest);
	}
	return 0;
}

