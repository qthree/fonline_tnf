class CCharacterTraitBtn : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        bool IsSet;
        uint8 Index;
        uint16 ParamIndex;

        CCharacterScreen@ Instance;
        IGUIElementOpt@ Options;

        CCharacterTraitBtn(CCharacterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = paramIndex;
            IsSet = false;

            @Instance = instance;
            @Instance.TraitBtn[Index] = this;

        }

        void OnMouseClick(int click){

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {return;}   //gamemode

            if(IsSet){
                Instance.TraitUnset(ParamIndex);
                Switch();
            }else{
                if(Instance.UnxpTrait > 0){
                    Instance.TraitSet(ParamIndex);
                    Switch();
                }
            }

            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnDraw(){

            //int x = Options.GetPosX(), y = Options.GetPosY();

            //string text = GetMsgStr(TEXTMSG_GAME, (STR_STAT_FULL+ParamIndex)*10+1);//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);

            //DrawText(""+text, x+325, y+314, 40 , 40, COLOR_GREEN, FONT_FALLOUT,  0);
        }

        void Switch(){
            Options.Switch(!IsSet);
            IsSet = !IsSet;
            Instance.TraitDesc[Index].IsSet = IsSet;
        }

        void Switch(bool set){
            Options.Switch(set);
        }

        void Visible(bool vis){
            Options.SetVisible(vis);
        }
