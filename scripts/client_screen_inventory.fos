class CharDamageDesc : IGUIElementCallbackInit/*, IGUIElementCallbackDraw*/
{
	IGUIElementOpt@ Options;
	ScreenCharInfo @ Instance;
	uint16 Type;
	uint8 BtnNum;
	
	CharDamageDesc(ScreenCharInfo& instance, uint16 type)
	{
		@Instance = instance;
		Type = type;
