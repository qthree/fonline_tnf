#define _DecItem        # ( x, count )x.GetCount() > count ? x.SetCount( x.GetCount() - count ) : DeleteItem( x )
#define HEAVY_DAMAGE    ( 507 )

void ProccessFirstAidSkill( Critter& cr, Critter& targetCr )
{
    if( targetCr.Stat[ ST_CURRENT_HP ] <= 0 )
    {
        cr.Say( SAY_NETMSG, "Это уже не поможет." );
        return;
    }

    bool   isPlayer = cr.IsPlayer();

    int    sk = cr.Skill[ SK_FIRST_AID ];
    uint8  mode = 0;
    uint16 activePid = cr.GetSlotProto( SLOT_HAND1, mode ).ProtoId;

    // Требование на материал при лечении
    // if (activePid!=PID_FIRST_AID_KIT && activePid!=PID_FIELD_MEDIC_KIT && activePid!=PID_MEDICAL_SUPPLIES)
    if( activePid != PID_FIRST_AID_KIT )
    {
        cr.Say( SAY_NETMSG, "Вам нужны медицинские препараты, аптечка или аптечка военфельдшера для применения этого навыка." );
        return;
    }

    bool[] isHaveItem = { false, false, false };   // antiseptic / healing / bandage

    uint16 statusFlag = cr.StatBase[ ST_CRSTATUS ];

    // if(FLAG(statusFlag, CR_STATUS_BLOOD_TOXIC)) isNeedItem[0] = true;
    // if(FLAG(statusFlag, CR_STATUS_BLEED)) isNeedItem[2] = true; //pm edit
    // if(targetCr.Stat[ST_CURRENT_HP]<targetCr.Stat[ST_MAX_LIFE]) isNeedItem[1] = true;

    // uint16 drugsIndex = 0;
    uint8[] drugIndexs = { 0, 0, 0 };

    Item@ activeHand = _CritGetItemHand( cr );
    if( @activeHand == null || activeHand.GetType() != ITEM_TYPE_CONTAINER )
    {
        cr.Say( SAY_NETMSG, "Техническая ошибка, итема нет. Обратитесь к геиммастеру." );
        return;
    }
    Item@[] drugs;
    activeHand.GetItems( -1, drugs );

    uint16 firstAidFlag = activeHand.Val4;
    if( FLAG( statusFlag, CR_STATUS_HEAVY_DMG ) )
    {
        cr.Say( SAY_NETMSG, "Здесь нужен врач." );
        return;
    }

    if( !FindItemInCont( drugs, drugIndexs, isHaveItem, firstAidFlag, true ) )
    {
        cr.Say( SAY_NETMSG, "Аптечка пуста" );
        return;
    }



    // else

    // cr.Say(SAY_NETMSG, ""+(drugsIndex&0x4)+" "+((drugsIndex>>4)&0x4));
    cr.Say( SAY_NETMSG, "" + drugIndexs[ 0 ] + " " + drugIndexs[ 1 ] + " " + drugIndexs[ 2 ] );



    bool isBandaged = ( targetCr.GetTimeEvents( CTE_HEAL, null, null, null ) > 0 );

    if( targetCr.Stat[ ST_CURRENT_HP ] < targetCr.Stat[ ST_MAX_LIFE ] )
    {

        // uint[] timeIndexs;


        if( drugs[ drugIndexs[ 1 ] ].GetProtoId() == PID_STIMPAK )
        {
            ItemStimpackUse( cr, drugs[ drugIndexs[ 1 ] ] );
            cr.Say( SAY_NETMSG, "Упарываемся." );
        }                                                                                                                                            // heal with stempack
        else if( drugs[ drugIndexs[ 1 ] ].GetProtoId() == PID_HEALING_POWDER )
        {
            ItemPowderUse( cr, drugs[ drugIndexs[ 1 ] ] );
        }

        if( isBandaged )
        {
            cr.Say( SAY_NETMSG, "Персонаж и так уже забинтован." );
            targetCr.Say( SAY_NETMSG, "Вы уже забинтованы. Ждите." );
            //	break;
        }

        if( isHaveItem[ 0 ] )     // blood toxic
        {
            uint16 drugProtoId = drugs[ drugIndexs[ 0 ] ].GetProtoId();
            if( drugProtoId == PID_BOOZE )
            {
                // CR_STATUS_HEAVY_DMG
                int16  hpCurrent = cr.StatBase[ ST_CURRENT_HP ];
                uint16 hpMax = ( cr.StatBase[ ST_MAX_LIFE ] + cr.StatBase[ ST_STRENGTH ] * 4 + cr.StatBase[ ST_ENDURANCE ] * 8 );
                uint8  chance = targetCr.Stat[ ST_STRENGTH ] * 3 + targetCr.Stat[ ST_ENDURANCE ] * 4 + targetCr.Stat[ ST_HEALING_RATE ] * 10 * ( ( hpMax * 0.01 ) * ( hpCurrent * 0.01 ) );
                chance = CLAMP( chance, 0, 95 );
                if( Random( 1, 100 - ( targetCr.Stat[ ST_LUCK ] * Random( 1, 3 ) ) ) > chance )
                {
                    ChangeStatus( cr, CR_STATUS_BLOOD_TOXIC, 0, true );
                }
            }
            else if( Random( 0, 100 ) > 95 )
                ChangeStatus( cr, CR_STATUS_BLOOD_TOXIC, 0, true );

            _DecItem( drugs[ drugIndexs[ 0 ] ], 1 );

        }
        else if( Random( 100 - ( ( targetCr.Stat[ ST_LUCK ] * 2 ) + targetCr.Stat[ ST_HEALING_RATE ] * 5 ), 100 ) > 95 )
            ChangeStatus( cr, CR_STATUS_BLOOD_TOXIC, 0, true );



        // Расходный материал - коричневая сумка. Нужно поправить прототип с описанием. И в крафт её добавить.
        if( activePid == PID_MEDICAL_SUPPLIES )
        {
            cr.DeleteItem( PID_MEDICAL_SUPPLIES, 1 );
        }

        if( isHaveItem[ 2 ] )
        {

            int mod = 11 - cr.Stat[ ST_LUCK ];
            mod = CLAMP( mod, 1, 10 );
            int heal = Random( sk / mod, sk );
            if( heal < 1 )
                heal = 1;

            int curHp = targetCr.Stat[ ST_CURRENT_HP ];
            int maxHp = targetCr.Stat[ ST_MAX_LIFE ];
            if( curHp + heal > maxHp )
                heal = maxHp - curHp;


            int16 aidTime = 80 + ( heal * 10 ) - ( targetCr.Stat[ ST_HEALING_RATE ] * 3 ) - targetCr.Stat[ ST_ENDURANCE ] + Random( -10, 10 );
            if( aidTime < 0 )
                aidTime = 0;
            // cr.AddTimeEvent("cte_IncreaseStudyExp", (60*15)*__TimeMultiplier, CTE_STUDY, 0);
            targetCr.AddTimeEvent( "cte_Heal", aidTime, CTE_HEAL, heal );



            // cr.Say(SAY_NETMSG,"Вылечено: "+heal);
            cr.Say( SAY_NETMSG, "Наложил бинты." );
            // if(not is_self) targetCr.Say(SAY_NETMSG,"Вылечено: "+heal);

            if( isPlayer )
            {
                GameVar@ firstAidCount = ::GetUnicumVar( UVAR_first_aid_count, cr.Id, targetCr.Id );
                if( firstAidCount < 10 )
                {
                    cr.StatBase[ ST_EXPERIENCE ] += heal;                 // если общий таймаут кончился
                }
                firstAidCount += 1;

                cr.TimeoutBase[ TO_SK_FIRST_AID ] = FIRST_AID_TIMEOUT( cr );
                cr.AddScore( SCORE_DOCTOR, 1 );
            }
        }
        else
        {
            cr.Say( SAY_NETMSG, "В аптечке нет бинтов." );
        }
    }
    else
    {
        cr.Say( SAY_NETMSG, "Не нуждается в лечении." );
    }
}

