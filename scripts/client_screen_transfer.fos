			invActionArr[0] = CHOSEN_MOVE_ITEM_CONT;
			//invActionArr[1] = Instance.ItemList.InventoryItems[Instance.InventoryButtons[Instance.ItemList.prevIndex].InvItemIndex].Id[0];
			invActionArr[1] = Side > 0 ? 0 : 1;
			invActionArr[2] = temp.Id;
			//invActionArr[2] = Instance.ItemList[Side].InventoryItems[Instance.ItemList[Side].InventoryButtons[Instance.ItemList[Side].prevIndex].InvItemIndex].tempItem[0].Id;
			//invActionArr[3] = Instance.ItemList[Side].InventoryItems[Instance.ItemList[Side].InventoryButtons[Instance.ItemList[Side].prevIndex].InvItemIndex].tempItem[0].Count;
			invActionArr[3] = temp.Count;
			for(uint8 ii = 4; ii < 7; ++ii) {invActionArr[ii] = 0;}

			//SetActions(invActionArr);

			SetChosenActions(invActionArr);

