    CCharacterScreen(){
        Param.resize(1000);

        //PerkSetAvalible();
        SetInfo();
        InfoIndexCurrent.resize(3);// = 0;

        for(uint8 i = 0, j = InfoIndexCurrent.length(); i<j;++i){
            InfoIndexCurrent[i] = 0;
        }

        UnxpStat = 5;
        UnxpTag = 3;
        UnxpTrait = 2;
    }


    void OnShow( int p0, int p1, int p2 )
    {
        @ScreenOpt = GUI_GetScreenOptions();
	
	DropSelectSkin();

        //UnxpStat = 5;
        //UnxpTag = 3;


        //ParamDrop();
        //TagClear();
        //TraitClear();
