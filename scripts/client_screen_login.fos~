string@[] uname;   //in login menu player view name
string@[] upass;   //password
string@[] ureal;   //player login
string@[] ustat;   //player status

uint forumId = uint(-1);

void OutCheckLogin(){
    MysqlInit();
            if(MysqlConnect(__SqlLocalCall)){
                if(MysqlSelectDb() == 0){

                        if(inputBoxs[LOGIN_INPUTBOX_NAME_INDEX] is null || inputBoxs[LOGIN_INPUTBOX_PASS_INDEX] is null) {Message("FUCKUSTIPIDCOWFUCKER!!!");}

                        string login = inputBoxs[LOGIN_INPUTBOX_NAME_INDEX].GetText(), password = inputBoxs[LOGIN_INPUTBOX_PASS_INDEX].GetText();
                        //string login = "text", password = "123";

                        if(login == "" || password == "") {Message("|0xFF0000 Нулевая длинна логина или пароля.");return;}

                        int r = MysqlCheckLogin(login, password);

                        if(r < 0){
                            string error = "";
                            MysqlError(error);
                            Message("Ошибка sql "+error+" . Дополнительный код : "+r);
                        }else{
                            //Message("login exist. id "+r);



                            forumId = r;

                            if(OutGetChars(r) <= 0){
                                    uname.resize(0);
                                    upass.resize(0);
                                    ureal.resize(0);
                                    ustat.resize(0);
                            }
                            //Message("login13");
                            ::ShowScreen(CLIENT_SCREEN_LOGIN_TNF, 0, 0, 0);
                        }
                    }
                    MysqlClose();
            }else{
                    Message("|0xFF0000 Ошибка подключения к серверу mysql. Сервер либо недоступен, либо у Вас закрыт 3306 порт.");
            }
}

int OutGetChars(/*string& names, string& pass, */int r){

                            string namesView = "", pass = "", namesReal = "", status = "";

                            //int rP = MysqlGetCharsPass(uint(r), pass), rN = MysqlGetCharsName(uint(r), names);
                            int rP = MysqlGetAccountChars(uint(r), namesView, namesReal, pass, status);
                            if(rP < 0){
                                string error = "";
                                MysqlError(error);
                                Message("Ошибка sql "+error+" . Дополнительный код : "+rP);//+" ext msg "+namesView);
                            }else{

                                uname = split( namesView, "&" );
                                upass = split( pass, "&" );
                                ureal = split( namesReal, "&");
                                ustat = split( status, "&");

                                if(uname.length() != upass.length() || upass.length() != ureal.length() || uname.length() != ureal.length()/* || uname.length() != ustat.length()*/) {Message("array length error"); return -1;}
#ifdef __DEBUG
                                for(uint8 i = 0, j = uname.length(); i < j; ++i){

                                        //upass[i].resize(7);

                                        string name = "names : "+uname[i]+" len " + uname[i].length() + " | login : "+ureal[i]+" len " + ureal[i].length() + " | pass : "+upass[i]+" len " + upass[i].length();

                                        Message("name "+name);

                                }
#endif //__DEBUG
                            }

                            return rP;
}

class CLoginButton : IGUIElementCallbackMouseClick, IGUIElementCallbackInit
{

    IGUIElementOpt@ Options;

    void OnMouseClick(int click){
            CheckLogin();
    }

    void OnInit(){
            //IGUIElementOpt
            @loginBtn = this;
            @Options = GUI_GetElementOptions();
    }

    void Release(){
            Options.Realese();
    }

    void CheckLogin(){
        OutCheckLogin();
    }

    int GetChars(/*string& names, string& pass, */int r){
        return OutGetChars(r);
    }


}
