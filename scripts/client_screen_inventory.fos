	ScreenInventory()
	{
		prevIndex = uint8(-1);
		FromIndex = 0;
		GroupType = 0;
		
		Skill = 0;
		
		ListSelected = true;
		IsSkillShow = false;
	}

	void OnShow(int p0, int p1, int p2)
	{
		CritterCl @ choo = (p0 != 0 ? GetCritter(uint(p0)) : GetChosen());
		if(choo is null){
			Message("Critter error");
			HideScreen(CLIENT_SCREEN_INVENTORY_TNF, 0, 0, 0);
			return;
		}
		@screenOpt=GUI_GetScreenOptions();
		//ListSelected = true;
		ClearButtons();
		LoadInventory(choo);
		ShowList(0);
		ShowListWear();
		SelectItem(0);
	}

	void OnHide(int p0, int p1, int p2)
	{
	}
	
