    CCharacterTraitDesc@[]           TraitDesc;

    CCharacterPerkDesc@[]            PerkDesc;
    CCharacterPerkBtn@[]             PerkBtn;
*/
    CCharacterArchiveMask@[]         ArchiveMask;

