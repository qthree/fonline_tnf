void e_PutiDrop(Item& item, Critter& cr)
{
	if(cr.CountItem(PID_ROPE_USED)!=0 || cr.CountItem(PID_HANDCUFFS_USED)!= 0)
	{
		cr.AddItem(PID_PUTI, 1);
		cr.Say(SAY_NETMSG, "Вы не можете снять путы");
	}
	DeleteItem(item);
}

