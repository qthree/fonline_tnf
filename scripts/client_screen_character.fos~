class CCharacterSkinSelectorImage : IGUIElementCallbackInit, IGUIElementCallbackDraw
{
    int8 Dir;
    int	X;
    int Y;
    int XX;
    uint Counter;
    Sprite Spr;

    CCharacterScreen@ 	Instance;
    IGUIElementOpt@            Options;

    CCharacterSkinSelectorImage( CCharacterScreen & instance )
    {
        @Instance = instance;
        @Instance.SkinImage = this;

        Dir = 3;
        Counter = 0;
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
	
	//Character screen comment

        /*uint16 genderIndex = STR_CRTYPE_MALE + (Instance.GenderSelectBtn.GetGender() * 2);//Instance.GetGenderIndex();

        Instance.LoadAnimationIndex(genderIndex);
        //Instance.Count = __baseCrType;
        Instance.Count = 0;//Instance.Param[ST_BASE_CRTYPE];
        Instance.SetSkinImage( Instance.Count, 3 );
	
	X  = Instance.SkinSelectBtn[BUTTON_UP].Options.GetPosX();
	XX = Instance.SkinSelectBtn[BUTTON_DN].Options.GetPosX()+Instance.SkinSelectBtn[BUTTON_DN].Options.GetSurfaceWidth();
	Y  = Instance.SkinSelectBtn[BUTTON_UP].Options.GetPosY()+Instance.SkinSelectBtn[BUTTON_UP].Options.GetSurfaceHeight();*/
	
	
	
	Instance.SetSkinImage(0/*Instance.Param[ST_BASE_CRTYPE]*/, 3);
	
	//Message("XXXX "+X+" "+XX+" "+Y);
    }

    void OnDraw(){
        int /*x = Options.GetPosX()+310, y = Options.GetPosY()+300,*/ xOff = 0, yOff = 60, sprOff = 0;
/*
        if(Dir == 1 || Dir == 4){
            xOff = 10;
        }else if(Dir == 4){
            xOff = -10;
        }*/

	xOff = (XX - X) * 0.5;
	
	sprOff = Spr.Width * 0.5;

        DrawSprite( Spr.Id, 0, X+xOff-sprOff+200, Y+yOff, 0 );

        Counter++;

        if(Counter == 50){
            RotateSpr();
            Counter = 0;
            //Message("test draw rotate");
        }
    }

    void SetPic( uint8 index, int8 dir )
    {
        //Options.Pic( "" + animIndex[ index ] + "AA.frm", PT_ART_CRITTERS );
/*
        Dir = CLAMP(dir, 0, 5);

        uint hash = GetStrHash("art\\critters\\"+animIndex[ 0 ]+"AA.frm");
        //Options.PicHash( hash, Dir );
        //Options.PicSetFrmCount(1);

        Spr.Load(hash, uint8(Dir));
        //Spr.FrmCount = 1;
        Spr.DrawFrame = 0;

        Instance.Param[ST_BASE_CRTYPE] = crTypes[index];
*/
    }

    void RotateSpr(){
        Dir++;

        if(Dir > 5){
            Dir = 0;
        }

        Spr.Load(Spr.Hash, uint8(Dir));
        //Spr.FrmCount = 1;
        //Spr.DrawFrame = 0;

    }

    uint8 GetDir(){return Dir;}
}
