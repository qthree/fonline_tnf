bool ChechNearCellForPlayer(uint16 x, uint16 y)
{
	for(int8 i = -1; i <= 1; i++){
		for(int8 j = -1; j <= 1; j++)
		{
			if(j != 0 && i != 0){
				Cell @ cell = world.GetCell(x+j, y+i);
				if(cell is null || cell.Content is null) continue;

				if(cell.Content.Type == CELLMAP_TYPE_STATIC || (cell.Content.Type == CELLMAP_TYPE_ENCOUTER && cell.Content.GetCrittersCount(-1) > 0 )){
						return true;
				}
			}
		}
	}

	return false;
}

bool ChechNearCellStatic(uint16 x, uint16 y)
{
	for(int8 i = -1; i <= 1; i++){
		for(int8 j = -1; j <= 1; j++)
		{
			if(j != 0 && i != 0){
				Cell @ cell = world.GetCell(x+j, y+i);
				if(cell is null || cell.Content is null) continue;

				if(cell.Content.Type == CELLMAP_TYPE_STATIC){
						return true;
				}
			}
		}
	}

	return false;
}


bool CheckMonsterTransitePlace(Critter& cr, Map& map, uint16 hexX, uint16 hexY){
	if(!(map is null)){

		Critter@[] mobs;

		uint8 radius = cr.Skill[SK_OUTDOORSMAN] / SKILL_OUTDORSMAN_MOD;
		uint8 temp = map.GetCrittersHex(hexX, hexY, radius, FIND_LIFE, null);

		if(temp > 0){
			return true;
		}
	}
	return false;
}

void ShowAnswerScreenTransit(Critter& cr){
	cr.ShowScreen( SCREEN_DIALOGBOX, 2, "answer_Transit" );
        cr.Say( SAY_DIALOGBOX_TEXT, "Перейти на глобальную карту?\n(ДА-выход/НЕТ-локально)" );
        cr.Say( SAY_DIALOGBOX_BUTTON( 0 ), "Да" );
	cr.Say( SAY_DIALOGBOX_BUTTON( 1 ), "Нет" );
	//cr.Say( SAY_DIALOGBOX_BUTTON( 2 ), "Отмена" );
}

void answer_Transit(Critter& cr, uint answerI, string& answerS)
{
	if(answerI == 1){
		Map @ map = GetMap(cr.StatBase[ST_ITEM_PID]);
		if(map is null) {cr.Say(SAY_NETMSG, "Mapid error.");return;}

		cr.SetWorldPos(map.GetLocation().WorldX, map.GetLocation().WorldY);
		cr.TransitToMap(map.Id, cr.StatBase[ST_ITEM_HEXX], cr.StatBase[ST_ITEM_HEXY], cr.StatBase[ST_OBJECT_TYPE]);
		
	}else if(answerI == 0){
		cr.TransitToGlobal(true);
	}else{}
}



