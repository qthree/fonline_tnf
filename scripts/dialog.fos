//bool d_DayAfterStart(Critter& player, Critter@ npc, int val)    { return dx_GroupCheckStat(player, npc, val, 17); }

// НПЦ жив?
// в v0 указываем NpcRole НПЦ (на карте должен быть в 1 экземпляре)
// в v1 указываем PID карты (карта должна быть в игре в одном экземпляре)
bool d_IsLife(Critter& player, Critter@ npc, int v0, int v1)
{
	Map @ map = GetMapByPid(v1, 0);
	if(not valid(map)) { Log("error");return false;}
	Critter @ crit = map.GetNpc(v0, FIND_ALL|FIND_ONLY_NPC, 0);
	if(not valid(crit)) { Log("error");return false;}
	if(crit.IsLife())
		return true; else
		return false;
}

// НПЦ мертв?
bool d_IsDead(Critter& player, Critter@ npc, int v0, int v1)
{
	return not d_IsLife(player,npc,v0,v1);
}

uint16 ItemToProt(Item@ item) //lib
{
  if (not valid(item))
	return 0; else
	return item.GetProtoId();
}


//стат больше чем локальная переменная для игрока
// stat - номер стата (характеристики)
// varNum - номер переменной
bool d_StatMoreThanLVar (Critter & player, Critter @ npc, uint stat, uint varNum)
{
	if (stat<STAT_BEGIN||stat>STAT_END) return false;
	GameVar @ v = GetLocalVar(varNum, player.Id);
	if (!valid(v)) return false;

	return player.StatBase[stat]>v.GetValue();

}
// стат меньше чем локальная переменная
bool d_StatLessThanLVar (Critter & player, Critter @ npc, uint stat, uint varNum)
{
	if (stat<STAT_BEGIN||stat>STAT_END) return false;
	GameVar @ v = GetLocalVar(varNum, player.Id);
	if (!valid(v)) return false;

	return player.StatBase[stat]<v.GetValue();

}
// стат равен локальной переменной
bool d_StatEqualsLVar (Critter & player, Critter @ npc, uint stat, uint varNum)
{
	if (stat<STAT_BEGIN||stat>STAT_END) return false;
	GameVar @ v = GetLocalVar(varNum, player.Id);
	if (!valid(v)) return false;

	return player.StatBase[stat]==v.GetValue();

}
