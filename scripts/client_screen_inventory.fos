			{
				//Instance.MoveItemList(true, false);
				//Instance.MoveItemListScroll(true);
			}else
			if(click == MOUSE_CLICK_WHEEL_DOWN)
			{
				//Instance.MoveItemList(false, false);
				//Instance.MoveItemListScroll(false);
