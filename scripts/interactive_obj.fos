{
    if( usedItem is null )
        return false;
    
    uint thisIndex = used_map_obj.GetIndexByItemId(item.Id), genIndex = 0;
	if(thisIndex == uint(-1)) return false;

    uint pid = usedItem.GetProtoId();
	
	if ( !check_parts( used_map_obj.cumos[thisIndex], cr, usedItem )) return true;
	
    return false;
}

