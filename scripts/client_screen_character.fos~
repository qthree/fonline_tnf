    void InfoSetAvalible(uint16[]& infos){

            infos.resize(0);

            for(uint16 i = ST_MAX_LIFE; i <= ST_MAX_CRITICAL; ++i){
                    infos.insertLast(i);
            }

            infos.insertLast(ST_NORMAL_RESIST);
            infos.insertLast(ST_POISON_RESISTANCE);
            infos.insertLast(ST_RADIATION_RESISTANCE);
    }
    
    void StatusSetAvalible(uint16[]& status){

            status.resize(0);
	    
	    status.insertLast(ST_HUNGER);
	    status.insertLast(ST_THRIST);
	    status.insertLast(ST_DYSPNEA);

            for(uint16 i = DAMAGE_BEGIN; i < DAMAGE_END; ++i){
                    status.insertLast(i);
            }
            
            //crstatus
            for(uint16 i = 0; i < 5; ++i){
                    status.insertLast(CRSTATUS_OFFSET + i);
            }
            
            
    }
