{
    private void process()
    {
        CritterCl @chosen = GetChosen();
        if( valid( chosen ) )
        {
            if( chosen.Param[ ST_VAR5 ] > 3 )
            {
                Message( "Antiflood." );
            }
            else
            {
                RunServerScriptUnsafe( "activation@unsafe_save",  0, 0, 0, null, null );
            }
        }
    }
}

