// message

#define CH_P #(CHN, str)      (parts[CHN]==str)

#define CH_P_NUM #(CHN)     (num_args_b[CHN])

#define ARG_NUM #(CHN)	(num_args[CHN])

#define ARG #(CHN)	parts[CHN]

string[] parts;
uint num = 0;
bool[] num_args_b;
int[] num_args;

bool gm_msg_cmd(string& message)
{
	CritterCl@ chosen=GetChosen();
	if(!valid(chosen)) return false;

	if(num==1)
	{
		if(CH_P(0, "#r"))
		{
			message = "~respawn "+chosen.Id;
			return true;
		}
		else if(CH_P(0, "#t"))
		{
			uint16 x=0, y=0, hexX=0, hexY=0;
			GetMonitorHex(x, y, hexX, hexY);
			message = "~move " + chosen.Id + " " + hexX + " " + hexY + " 1";
			return true;
		}
		else if(CH_P(0, "#delmob"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			message = "~run debug deleteCritter " + target.Id + " 0 0";
			return true;
		}
		else if(CH_P(0, "#zc"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			RunServerScript("raiders@controlMob",  target.Id, 0, 0, null, null);
			return false;
		}
		else if(CH_P(0, "#za"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			if(valid(target)) RunServerScript("raiders@attackMob",  target.Id, 0, 0, null, null);
			else {uint16 hexX=0, hexY=0; GetMonitorHex(x, y, hexX, hexY); RunServerScript("raiders@moveMob",  0, hexX, hexY, null, null);}
			return false;
		}
		else if(CH_P(0, "#zp"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			RunServerScript("raiders@chaseMob",  target.Id, 0, 0, null, null);
			return false;
		}
		else if(CH_P(0, "#lex"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			message = "~run gm lex " + target.Id + " 0 0";
			return true;
		}
		else if(CH_P(0, "#gm_calm"))
		{
			uint16 x=__MouseX, y=__MouseY;
			CritterCl@ target = GetMonitorCritter (x, y);
			message = "~run debug CalmDown " + target.Id + " 0 0";
			return true;
		}
		else if(CH_P(0, "#delitem"))
		{
			uint16 x=__MouseX, y=__MouseY;
			ItemCl@ item = GetMonitorItem (x, y);
			message = "~run debug delItem 0 " + item.Id + " 0";
			return true;
		}
		else if(CH_P(0, "#save"))
		{
			if(chosen.Param[ST_VAR5]>3)
			{
				Message("Antiflood.");
				return false;
			}
			RunServerScriptUnsafe  ("activation@unsafe_save",  0, 0, 0, null, null);
			return false;
		}
		else if(CH_P(0, "#zomb"))
		{
			RunServerScriptUnsafe("client_unsafe@unsafe_zombie",  0, 0, 0, null, null);
			return false;
		}
		else if(CH_P(0, "#global_grid"))
		{
			__global^=CONF_GLOB_GRID;
			Message("Сетка на глобальной карте теперь "+((__global&CONF_GLOB_GRID!=0)?"влючена.":"выключена."));
			return false;
		}
		else if(CH_P(0, "#global_wild"))
		{
			__global^=CONF_GLOB_WILD;
			Message("Карта дикости на глобальной карте теперь "+((__global&CONF_GLOB_WILD!=0)?"влючена.":"выключена."));
			return false;
		}
	}
	else if(num==2)
	{
		if(CH_P_NUM(1))
		{
			if(CH_P(0, "#mob"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				message = "~run raiders sendAttack " + ARG_NUM(1) +" "+ hexX +" "+ hexY;
				return true;
			}
			else if(CH_P(0, "#mob2"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				message = "~run raiders sendAttack2 " + ARG_NUM(1) +" "+ hexX +" "+ hexY;
				return true;
			}
			else if(CH_P(0, "#addnpc"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				message = "~addnpc " + hexX + " " + hexY + " 1 " + ARG_NUM(1);
				return true;
			}
			else if(CH_P(0, "#spawnnpc"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				RunServerScript("raiders@spawnNPC",  ARG_NUM(1), hexX, hexY, null, null);
				return false;
			}
			else if(CH_P(0, "#additem"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				message = "~additem " + hexX + " " + hexY + " " + ARG_NUM(1) + " 1";
				return true;
			}
			else if(CH_P(0, "#mobs"))
			{
				uint16 x=0, y=0, hexX=0, hexY=0;
				GetMonitorHex(x, y, hexX, hexY);
				message = "~run raiders sendMob " + ARG_NUM(1) +" "+ hexX +" "+ hexY;
				return true;
			}
			else if(CH_P(0, "#gm_say"))
			{
				uint16 x=__MouseX, y=__MouseY;
				CritterCl@ target = GetMonitorCritter (x, y);
				message = "~run gm say " + target.Id + " " + ARG_NUM(1) + " 0";
				return true;
			}
			else if(CH_P(0, "#act"))
			{
				message = "~setvar 6100 0 " + ARG_NUM(1) + " 0 2";
				return true;
			}
			else if(CH_P(0, "#gm_cr2me"))
			{
				RunServerScript("debug@_ctd",  ARG_NUM(1), 0, 0, null, null);
				return false;
			}
			else if(CH_P(0, "#gm_me2cr"))
			{
				RunServerScript("debug@_ctd",  ARG_NUM(1), 0, 1, null, null);
				return false;
			}
			else if(CH_P(0, "#me2cr"))
			{
				message = "~run debug ctd "+ ARG_NUM(1) + " 0 1";
				return true;
			}
			else if(CH_P(0, "#cr2me"))
			{
				message = "~run debug ctd "+ ARG_NUM(1) + " 0 0";
				return true;
			}
			else if(CH_P(0, "#w"))
			{
				message = "~run warning Warn "+ ARG_NUM(1) + " 0 0";
				return true;
			}
			else if(CH_P(0, "#restore"))
			{
				if(chosen.Param[ST_VAR5]>3)
				{
					Message("Antiflood.");
					return false;
				}
				RunServerScriptUnsafe("activation@unsafe_restore",  ARG_NUM(1), 0, 0, parts[2], null);
				return false;
			}
			else if(CH_P(0, "#sinf"))
			{
				RunServerScript("gm@_sinf",  ARG_NUM(1), 0, 0, null, null);
				return false;
			}
		}
	}
	else if(num==3)
	{
		if(CH_P_NUM(1))
		{
			if(CH_P(0, "#restore"))
			{
				if(chosen.Param[ST_VAR5]>3)
				{
					Message("Antiflood.");
					return false;
				}
				RunServerScriptUnsafe("activation@unsafe_restore",  ARG_NUM(1), 0, 0, parts[2], null);
				return false;
			}
		}
	}
	else if(num==4 || num==5)
	{
		if(CH_P_NUM(1))
		{
			if(CH_P(0, "#build")) // && CH_P_NUM(2) && CH_P_NUM(3))
			{
				string@ str= null;
				if(num==5) @str=parts[4];
				RunServerScript("qmap_debug@_client_build",  ARG_NUM(1), ARG_NUM(2), ARG_NUM(3), str, null);
			}
		}
	}
/*	else if(num==8)
	{
		if(CH_P(0, "#chac") && ((__sinf&SINF_TOOLS)!=0))
		{
			for(uint k=1; k<=7; k++)
			{
				if(!CH_P_NUM(k)) break;
				if(k!=7) continue;
				
				uint[] actions;
				GetChosenActions(actions);
				
				for(uint i=1; i<8; i++)
				{
					actions.insertLast(ARG_NUM(i));
				}
				
				SetChosenActions(actions);
				Message("Action added.");
			}
		}
		else if(CH_P(0, "#chacf") && ((__sinf&SINF_TOOLS)!=0))
		{
			for(uint k=1; k<=7; k++)
			{
				if(!CH_P_NUM(k)) break;
				if(k!=7) continue;
				
				uint[] actions;
				GetChosenActions(actions);
				
				for(uint i=7; i>0; i--)
				{
					actions.insertFirst(ARG_NUM(i));
				}
				
				SetChosenActions(actions);
				Message("Action added.");
			}
		}
	}
*/
	return false;
}


bool gm_msg_run(string& message)
{
	if(num<2 || num>5) return false;

	if(CH_P(0, "%d")) parts[0]="~run debug";
	else if(CH_P(0, "%t")) parts[0]="~run test";
	else if(CH_P(0, "%ac")) parts[0]="~run activation";
	else if(CH_P(0, "%sk")) parts[0]="~run skins";
	else if(CH_P(0, "%qd")) parts[0]="~run qmap_debug";
	//else return false;
	else
	{
		string@ module_name = substring(parts[0], 1, parts[0].length()-1);
		parts[0]="~run "+module_name;
	}

	if(num==2)
	{
		num=5;
		parts.resize(5);
		parts[2]="0";
		parts[3]="0";
		parts[4]="0";
	}
	else if(num==3)
	{
		num=5;
		parts.resize(5);
		parts[3]="0";
		parts[4]="0";
	}
	else if(num==4)
	{
		num=5;
		parts.resize(5);
		parts[4]="0";
	}

	string@[] parts_temp2;

	parts_temp2.resize( parts.length() );

	for(uint i=0; i<parts.length(); i++)
	{
		@parts_temp2[i]=@parts[i];
	}
	
	message = join(parts_temp2, " ");

	return true;
}

