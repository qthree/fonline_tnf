// системная секция

void door_ctrl(int ent, Critter& player, bool open)
{
	uint x=0,y=0;
	Map@ map=player.GetMap();
	if(map.GetEntireCoords(ent, 0, x, y))
	{
		Item@ door=map.GetDoor(x,y);
		if(valid(door))
			if(open)
				map.OpenDoor(door); else
				map.CloseDoor(door);
	}
}

void item_geck(Item& item)
{
	if (item.IsGrouped()) return;
	SETFLAG(item.Flags, ITEM_GECK);
	item.Update();
}

void item_hide(Item& item)
{
	SETFLAG(item.Flags, ITEM_HIDDEN);
	item.Update();
}

void item_selector(Item& item)
{
	int x,y;
	Map@ map = item.GetMapPosition(x,y);
	if(not valid(map)) return;
	//map.GetItems ...
	// ...
}

void item_rnd_del(Item& item)
{
	if(uint(Random(1,100))<=CLAMP(item.Val1,0,100))
		DeleteItem(item);
}

void item_spawn(Item& item)
{

}

// взять ближайшего криттера
// если критеров нет то возвращаем null
// Это стало бессмысленно после апдейта: (покачто оставлю, пусть будет)
// http://fonline.ru/forum/showpost.php?p=85438&postcount=95
// "найденные криттеры будут отсортированы по отдалению от базовой точки или криттера."
Critter@ GetNearCritter(Map@ map, int x, int y, int radius) //lib
{
	Critter@[] critters;
	uint count=map.GetCrittersHex(x, y, radius, FIND_ALL|FIND_LIFE_AND_KO, critters);
	uint minDist=10000;
	Critter@ nearCrit=null;
	for(uint i=0; i<count; i++)
	{
		uint d=GetDistantion(x,y,critters[i].HexX,critters[i].HexY);
		if(d<minDist)
		{
			minDist=d;
			@nearCrit=critters[i];
		}
	}
	return nearCrit;
}

// взять ближайшего криттера
// если критеров нет то возвращаем null
Critter@ GetNearCritterWithRole(Map@ map, int x, int y, int radius, int role) //lib
{
     Critter@[] critters;
     uint count=map.GetCrittersHex(x, y, radius, FIND_LIFE, critters);
     uint minDist=10000;
     Critter@ nearCrit=null;
     for(uint i=0; i<count; i++)
          if(critters[i].StatBase[ST_NPC_ROLE]==role) {
               uint d=GetDistantion(x,y,critters[i].HexX,critters[i].HexY);
               if(d<minDist)
               {
                    minDist=d;
                    @nearCrit=critters[i];
               }
          }
     return nearCrit;
}

