	void DropItem(uint8 index)
	{

		uint16 	invItemIndex = InventoryButtons[index].InvItemIndex,
			dropLen = 0,
			itemsLen = InventoryItems.length();

		if(itemsLen > invItemIndex &&  InventoryItems[invItemIndex].Id.length() <= 1) return; // !drop 1 length items

		if(invItemIndex+1 < itemsLen){
			if(InventoryItems[invItemIndex+1].Child){
				return;
			}
		}

		if(!InventoryItems[invItemIndex].Child)
		{
			dropLen = InventoryItems[invItemIndex].Id.length();

			for(uint16 i = 0; i < dropLen; ++i)
			{
				InventoryItem tempInvItem(InventoryItems[invItemIndex].Id[i], InventoryItems[invItemIndex].Count[i], InventoryItems[invItemIndex].Name, InventoryItems[invItemIndex].tempItem[i]);
				InventoryItems.insertAt(index+i+1, tempInvItem);
			}

			ShowList(InventoryButtons[0].InvItemIndex);
		}
	}

	void RollUpItem(uint8 index)
	{


			uint16 itemsLen = InventoryItems.length();

			if(index+1 < itemsLen){
				if(!(!InventoryItems[index].Child && InventoryItems[index+1].Child)){
					return;
				}
			}

			index++;

			while(index < InventoryItems.length() && InventoryItems[index].Child)
			{
				InventoryItems.removeAt(index);
			};

			ShowList(InventoryButtons[0].InvItemIndex);
	}

	void RollUpItemArrow(uint8 index)
	{
		uint8 tempIndex = index;
		while(InventoryItems[InventoryButtons[tempIndex].InvItemIndex].Child)
		{
			--tempIndex;
		};

		RollUpItem(tempIndex);
		SelectItem(tempIndex);
	}
	
	void RollUpItemForce(){
		for(uint i = 0, j = InventoryItems.length(); i < j; ++i){
			RollUpItem(i);
		}
	}

	void MoveItemList(bool up, bool forced)
	{

			uint8 realIndex = prevIndex + 1;
			uint16 itemsLen = InventoryItems.length();
			
			FromIndex = InventoryButtons[0].InvItemIndex;

			if(forced)
			{
				if(up)
				{
					if(InventoryButtons[0].InvItemIndex != uint16(-1))
					{
						ShowList(0);
						SelectItem(0);
					}

				}else
				{
					int lastItem = (itemsLen - INVENTORY_ITEMS_LIST_COUNT);
					uint8 realIndex = itemsLen -1 ;

					if(lastItem > 0)
					{
						ShowList(lastItem);
						realIndex = INVENTORY_ITEMS_LIST_COUNT-1;
					}

					SelectItem(realIndex);
				}

				return;
			}

			if(up)
			{
				bool list = (InventoryButtons[0].InvItemIndex > 0);
				if(realIndex <= INVENTORY_ITEMS_LIST_COUNT)
				{
					if(list)
					{
						ShowList(InventoryButtons[0].InvItemIndex - 1);
					}
					SelectItem(prevIndex + (list ? 0 : -1));
				}
			}else
			if(realIndex < itemsLen)
			{

				if(InventoryButtons[INVENTORY_ITEMS_LIST_COUNT-1].InvItemIndex != uint16(-1) && InventoryButtons[INVENTORY_ITEMS_LIST_COUNT-1].InvItemIndex + 1 >= itemsLen) return;

				bool list = (realIndex == INVENTORY_ITEMS_LIST_COUNT && itemsLen > INVENTORY_ITEMS_LIST_COUNT);

				if(list)
				{
					ShowList(InventoryButtons[0].InvItemIndex + 1);
				}

				SelectItem(list ? prevIndex : realIndex);
			}else	{return;}

	}
	
	void MoveItemListScroll(bool up){
		if(up){
			if(prevIndex > 0){
				//ShowList(--prevIndex);
			}
		}else{
			//
			//ShowList(++prevIndex);
			SelectItem(++prevIndex);
		}
	}
	
	//void Roll

	void Sort(uint8 sortType, bool reverse)
	{
	      RollUpItemForce();
	  
	      InventoryItem tempInvItem;

	      if(sortType == INVENTORY_SORT_COUNT)
	      {

			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++)
			{
				j = i;

				while (j > 0 && InventoryItems[j - 1].Id.length() > InventoryItems[j].Id.length())
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}
		}else
		if(sortType == INVENTORY_SORT_ABC)
		{
			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++)
			{
				j = i;
				
				//Message(InventoryItems[i].Name);

				while (j > 0 && InventoryItems[j - 1].Name > InventoryItems[j].Name)
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}


		}else
		if(sortType == INVENTORY_SORT_SLOT)
		{

			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++)
			{
				j = i;

				while (j > 0 && InventoryItems[j - 1].tempItem[0].CritSlot > InventoryItems[j].tempItem[0].CritSlot)
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}
		}else
		if(sortType == INVENTORY_SORT_NOP)
		{
			//FullRefreshItemList();
			LoadInventory(GetChosen());
		}else return;

		if(reverse) InventoryItems.reverse();
		ShowList(InventoryButtons[0].InvItemIndex);
	}

	bool IsRolled(uint8 index){
		return (InventoryItems[index].Count[0] > 0);
	}
	
	void SkillShow(bool vis){
		for(uint8 i = 0, j = Skills.length(); i < j; i++){
			Skills[i].SetVisible(vis);
		}
	}
	
	void GroupSetState(uint8 type){
		for(uint8 i = 0, j = ItemGroups.length(); i < j; ++i){
			ItemGroups[i].SetState((ItemGroups[i].Type == type));
		}
	}
	
	void ItemDec(uint index, uint id, uint count){
	  //Message("good0");
		if(index < InventoryItems.length()){
			//Message("good");
			ActionDropReal(index, count);
			InventoryItems[index].ItemDec(id, count);
		}
	}
	
	void ActionUse()
	{
		if(InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_ITEM;
			invActionArr[1] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].Id[0];
			invActionArr[2] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].tempItem[0].GetProtoId();
			invActionArr[3] = TARGET_SELF;
			invActionArr[4] = GetChosen().Id;
			invActionArr[5] = ITEM_MODE_USE;
			for(uint8 ii = 6; ii < 7; ++ii) {invActionArr[ii] = 0;}
			SetActions(invActionArr);
		}
			//RefreshItemList();
	}
	
	void ActionSkillShow(){
		IsSkillShow = !IsSkillShow;
		SkillShow(IsSkillShow);
		
	}
	
	void ActionSkill()
	{
		uint16 skill = Skill;
	  
		if(InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_SKL_ON_ITEM;
			invActionArr[1] = 1;
			invActionArr[2] = skill;
			invActionArr[3] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].Id[0];
			invActionArr[4] = 0;
			invActionArr[5] = 0;

			SetActions(invActionArr);
		}
	}
	
	void ActionWear(uint type)
	{
		uint[] invActionArr(7);
		invActionArr[0] = CHOSEN_MOVE_ITEM;
		invActionArr[1] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].Id[0];
		invActionArr[2] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].tempItem[0].GetCount();
		invActionArr[3] = type;
		invActionArr[4] = 0;
		invActionArr[5] = 0;

		SetActions(invActionArr);
		
		InventoryItems[InventoryButtons[prevIndex].InvItemIndex].WearSlot = type;
	}

	void ActionUnloadWeap()
	{
		if(InventoryItems.length() > 0)
		{
			uint[] invActionArr(7);
			invActionArr[0] = CHOSEN_USE_ITEM;
			invActionArr[1] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].Id[0];
			invActionArr[2] = InventoryItems[InventoryButtons[prevIndex].InvItemIndex].tempItem[0].GetProtoId();
			invActionArr[3] = TARGET_SELF;
			invActionArr[4] = GetChosen().Id;
			invActionArr[5] = ITEM_MODE_RELOAD;
			for(uint8 ii = 6; ii < 7; ++ii) {invActionArr[ii] = 0;}

			SetActions(invActionArr);
		}
	}
	
	void ActionDropReal(uint index, uint count){
		uint[] invActionArr(7);
		invActionArr[0] = CHOSEN_MOVE_ITEM;
		invActionArr[1] = InventoryItems[InventoryButtons[index].InvItemIndex].Id[0];
		invActionArr[2] = count;
		invActionArr[3] = 0xFF;
		for(uint8 ii = 4; ii < 7; ++ii) {invActionArr[ii] = 0;}

		SetActions(invActionArr);
	}
	
	void ActionDrop(){
		ShowCounterScreen(InventoryItems[InventoryButtons[prevIndex].InvItemIndex].tempItem[0], GetChosen(), CLIENT_SCREEN_INVENTORY_TNF, prevIndex);
		//::ShowScreen(CLIENT_SCREEN_COUNT_DIALOG, 
		//     prevIndex, 
		//     int(InventoryItems[InventoryButtons[prevIndex].InvItemIndex].Id[0]),
		//     CLIENT_SCREEN_INVENTORY_TNF);
	  
	}
	
	void SetActions(uint[] actions)
	{
		SetChosenActions(actions);
	}

}

class InventoryRefresh : IGUIElementCallbackInit, IGUIElementCallbackDraw
{
	ScreenInventory@ Instance;
	
	uint Timer;
  
	InventoryRefresh(ScreenInventory& instance){
		@Instance = instance;
		
		Timer = 0;
	}
	
	void OnInit(){}
	
	void OnDraw(){
		Timer++;
		
		if(Timer > INVENTORY_UPDATE_TIMER){
		  
			//Instance.LoadInventory();
			Instance.SoftRefresh();
		  
			Timer = 0;
			
			//Message("Loop");
		}
	}
}

class InventoryItemButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick, IGUIElementCallbackDraw
{
