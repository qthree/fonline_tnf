//int DoorUnLock(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)t v0)

/**
 управление дверью
 param=2
 type=all
*/
int DoorControl(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	uint _x=0,_y=0;
	Map@ map=player.GetMap();
	if(map.GetEntireCoords(v0, 0, _x, _y))
	{
		Item@ door=map.GetDoor(_x,_y);
		if(valid(door))
		{
			if(v1==1) map.OpenDoor(door); else
			if(v1==2) map.CloseDoor(door);
		}
	}
	return 0;
}

/**
 запустить диалог
 param=1
 type=trigger,scenery
*/
int DialogNpc(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return FALSE;
	Critter@ _npc=GetNearCritterWithRole(player.GetMap(), x, y, WARN_DIST, v0);
	if(not valid(_npc)) return FALSE;
	player.Wait(0);
	int dist = _npc.StatBase[ST_TALK_DISTANCE];
	_npc.StatBase[ST_TALK_DISTANCE] = (v0>10?10:v0);
 	RunDialog(player, _npc, false);
	_npc.StatBase[ST_TALK_DISTANCE] = dist;
	return TRUE;
}
























