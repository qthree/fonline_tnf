		else if(AArmed && VArmed && fromCr.IsPlayer() && VCitizen!=2 && ACitizen!=2 || AArmed && !VArmed && fromCr.Skill[SK_UNARMED]>100 && VCitizen!=2 && ACitizen!=2)
		{
			cr.SetDir(dir);
			uint VBadRep=VThiefRep+VAgrRep;
