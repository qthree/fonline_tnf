void saveglobaltofile(Critter& cr, int, int, int){
	saveglobalmaptofile();
}

void setbiommap(Critter& cr, int x, int y, int biomMap){
  
	//if(biomType > BIOM_TYPE_MOUNTAIN) return;
  
	world.Cells[x*y].BiomMapPid = biomMap;
}


void setbiomtype(Critter& cr, int x, int y, int biomType){
  
	if(biomType > BIOM_TYPE_MOUNTAIN) return;
  
	world.Cells[x*y].BiomType = biomType;
}

void setheighlvl(Critter& cr, int x, int y, int heighlvl){
  
	world.Cells[x*y].DefaultLevel = heighlvl;
}


string ParseLoad(string file){

	//uint16 y = 0;
	string s = "";
	file f;

	if(f.open(file, "r") != -1){



		while(!f.isEndOfFile()){
				string line = "";
				f.readLine(line);
				//string@[] @ layer = split( word2, LINE_TOKEN );
				s+=line;

			//++y;
		}
	}

	return s;
}

uint ParseCellSet(){
	string sIn = ParseLoad(FILE_GLOBAL_BIOM);//, oldLine = "";
	string sInHeigh = ParseLoad(FILE_GLOBAL_HEIGH); //heigh
	
	uint mountCount = 0;
	
	Log("LENGHT "+sIn.length()+" "+sInHeigh.length());

	 //heigh
	if(sIn.length() > 0 && (sInHeigh.length() == sIn.length())){
		string@[]@ sLine = split(sIn, "\n");
		string@[]@ sHeigh = split(sInHeigh, "\n"); //heigh
		
		 //heigh
		if(sLine.length() != sHeigh.length()){Log("PARSE BIOMS : WRONG LENGTH. EXIT"); return 0;}
		
		

		uint16 yy = sLine.length();

		int[][] cellsbioms;
		int[][] cellsheigh; //heigh

		yy = (yy > GMAP_HEIGH * 0.1 ? GMAP_HEIGH * 0.1 : yy);

		cellsbioms.resize(yy);
		cellsheigh.resize(yy); //heigh

		for(uint16 y = 0; y < yy; ++y){

			string@[]@ sA = split(sLine[y], "\t");
			string@[]@ sH = split(sHeigh[y], "\t"); //heigh
			//string@[]@ sO = split(oldLine, "\t");

			uint16 xx = sA.length();
			int[]@ iA = cellsbioms[y];
			int[]@ iH = cellsheigh[y]; //heigh

			xx = (xx > GMAP_WIDTH * 0.1 ? GMAP_WIDTH * 0.1 : xx);

			iA.resize(xx);
			iH.resize(xx); //heigh

			for(uint16 x = 0; x < xx; ++x){
				/*
				Cell @ cell = world.GetCell(x, y);
				if(cell is null) continue;

				cell.BiomFlags = 0;
				*/
				/*if(sA[x].length() > 1){
				
				  if(sA[x] == "ML"){
				    iA[x] = BIOM_TYPE_MOUNTAIN_LEFT;
				  }else if(sA[x] == "MR"){
				    iA[x] = BIOM_TYPE_MOUNTAIN_RIGHT;
				  }else if(sA[x] == "MD"){
				    iA[x] = BIOM_TYPE_MOUNTAIN_DOWN;
				  }else if(sA[x] == "MT"){
				    iA[x] = BIOM_TYPE_MOUNTAIN_TOP;
				  }
				  
				  mountCount++;
				  
				}else*/
				
				if(sA[x] == "R"){
					iA[x] = BIOM_TYPE_ROAD;
				}else if (sA[x] == "I"){
					iA[x] = BIOM_TYPE_RAILROAD;
				}else if (sA[x] == "W"){
					iA[x] = BIOM_TYPE_RIVER;
				}else if (sA[x] == "L"){
					iA[x] = BIOM_TYPE_LAKE;
				}else if (sA[x] == "M"){
					iA[x] = BIOM_TYPE_MOUNTAIN;
				}else if (sA[x] == "U"){
					iA[x] = BIOM_TYPE_RUINS;
				}else if (sA[x] == "F"){
					iA[x] = BIOM_TYPE_FOREST;
				}else{
					//SETFLAG(cell.BiomFlags, BIOM_TYPE_WASTELAND);
					iA[x] = BIOM_TYPE_WASTELAND;
				}
				
				//heigh
				int iTemp = 0;
				StrToInt(sH[x], iTemp);
				iH[x] = iTemp;
			}

			//oldLine = sLine[y];
		}

		for(uint16 y = 0; y < yy; ++y){
			int[]@ iA = cellsbioms[y];
			int[]@ iH = cellsheigh[y]; //heigh

			uint16 xx = iA.length();

			for(uint16 x = 0; x < xx; ++x){

				Cell @ cell = world.GetCell(x, y);
				if(cell is null) continue;
	   
				//heigh
				cell.DefaultLevel = iH[x];

				cell.BiomFlags = 0;

				int[]@ iAp;
				int[]@ iAn;
				
				//heigh
				int[]@ iHp;
				int[]@ iHn;

				if(y > 0){
					@iAp = cellsbioms[y-1];
					//heigh
					@iHp = cellsheigh[y-1];
				}

				if(y+1 < yy){
					@iAn = cellsbioms[y+1];
					//heigh
					@iHn = cellsheigh[y+1];
				}

				uint biomFlag = 0;
				
// 				if(iA[x] >= BIOM_TYPE_MOUNTAIN_LEFT && iA[x] <= BIOM_TYPE_MOUNTAIN_TOP){
				/*if(_ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, iA[x])){
				  
					if(x > 0 && _ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, iA[x-1])){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_LEFT);
						//SETFLAG(cell.BiomFlags, BIOM_HORIZONTAL_L);
					}
					
					if(x+1 < xx && _ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, iA[x+1])){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_RIGHT);
						//SETFLAG(cell.BiomFlags, BIOM_HORIZONTAL_R);
					}
					
					if(iAp !is null && _ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, iAp[x])){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_TOP);
						//SETFLAG(cell.BiomFlags, BIOM_VERTICAL_T);
					}
					if(iAn !is null && _ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, iAn[x])){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_DOWN);
						//SETFLAG(cell.BiomFlags, BIOM_VERTICAL_D);
					}
				}else{*/
				
					if(x > 0 && iA[x-1] == iA[x]){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_LEFT);
						//SETFLAG(cell.BiomFlags, BIOM_HORIZONTAL_L);
					}
				
					if(x+1 < xx && iA[x+1] == iA[x]){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_RIGHT);
						//SETFLAG(cell.BiomFlags, BIOM_HORIZONTAL_R);
					}
				
					if(iAp !is null && iAp[x] == iA[x]){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_TOP);
						//SETFLAG(cell.BiomFlags, BIOM_VERTICAL_T);
					}
				  
					if(iAn !is null && iAn[x] == iA[x]){
						SETFLAG(biomFlag, BIOM_HAS_CHILD_DOWN);
						//SETFLAG(cell.BiomFlags, BIOM_VERTICAL_D);
					}
				
					if(iA[x] == BIOM_TYPE_RIVER || iA[x] == BIOM_TYPE_LAKE){
						if(iAp !is null && iAp[x-1] == iA[x])
							SETFLAG(biomFlag, BIOM_HAS_CHILD_TL);
						if(iAp !is null && iAp[x+1] == iA[x])
							SETFLAG(biomFlag, BIOM_HAS_CHILD_TR);
						if(iAn !is null && iAn[x-1] == iA[x])
							SETFLAG(biomFlag, BIOM_HAS_CHILD_DL);
						if(iAn !is null && iAn[x+1] == iA[x])
							SETFLAG(biomFlag, BIOM_HAS_CHILD_DR);
					}
					
					//heigh
					if(iA[x] == BIOM_TYPE_MOUNTAIN){
					  
						string msg = "";
					  
						if(x > 0 && iH[x-1] < iH[x]){
							SETFLAG(biomFlag, BIOM_MOUNTAIN_LEFT);
							msg += "left ";
						}
						
						if(x+1 < xx && iH[x+1] < iH[x]){
							SETFLAG(biomFlag, BIOM_MOUNTAIN_RIGHT);
							msg += "right ";
						}
				
						if(iHp !is null && iHp[x] < iH[x]){
							SETFLAG(biomFlag, BIOM_MOUNTAIN_TOP);
							msg += "top ";
						}
						
						if(iHn !is null && iHn[x] < iH[x]){
							SETFLAG(biomFlag, BIOM_MOUNTAIN_DOWN);
							msg += "down ";
						}
						
						//Log("MOUNTAINT "+msg);
					}
				
				//}

				if((iA[x] == BIOM_TYPE_RIVER/* || iA[x] == BIOM_TYPE_LAKE*/)  && ((iAp !is null && iAp[x] == BIOM_TYPE_ROAD && iAn !is null && iAn[x] == BIOM_TYPE_ROAD)) || 
				  (xx > x+1 && iA[x+1] == BIOM_TYPE_ROAD && x > 0 && iA[x-1] == BIOM_TYPE_ROAD)){
				    SETFLAG(biomFlag, BIOM_HAS_BRIDGE);
				    Log("BRIDGE");
				}

				if(cell.Content !is null && cell.Content.Type == CELLMAP_TYPE_STATIC){
					//nope
				}else{

				    if(iA[x] != BIOM_TYPE_WATER){
				        cell.BiomType = iA[x];
				    }else{

                            bool[] cross = {FLAG(biomFlag, BIOM_HAS_CHILD_DOWN), FLAG(biomFlag, BIOM_HAS_CHILD_TOP), FLAG(biomFlag, BIOM_HAS_CHILD_LEFT), FLAG(biomFlag, BIOM_HAS_CHILD_RIGHT)};
                            bool[] sides = {FLAG(biomFlag, BIOM_HAS_CHILD_TL), FLAG(biomFlag, BIOM_HAS_CHILD_TR), FLAG(biomFlag, BIOM_HAS_CHILD_DL), FLAG(biomFlag, BIOM_HAS_CHILD_DR)};

                            /*bool    isHorr  = (FLAG(biomFlag, BIOM_HAS_CHILD_DOWN) && FLAG(biomFlag, BIOM_HAS_CHILD_TOP)),
                                    isVert  = (FLAG(biomFlag, BIOM_HAS_CHILD_LEFT) && FLAG(biomFlag, BIOM_HAS_CHILD_RIGHT)),
                                    isWN    = (FLAG(biomFlag, BIOM_HAS_CHILD_TOP) && FLAG(biomFlag, BIOM_HAS_CHILD_RIGHT)),
                                    isWS    = (FLAG(biomFlag, BIOM_HAS_CHILD_DOWN) && FLAG(biomFlag, BIOM_HAS_CHILD_RIGHT)),
                                    isSE    = (FLAG(biomFlag, BIOM_HAS_CHILD_DOWN) && FLAG(biomFlag, BIOM_HAS_CHILD_LEFT)),
                                    is*/

                            //bool[] sides = {isHorr, isVert, }

                            uint8 countCross = 0, countSides = 0;

                            for(uint8 i = 0, j = cross.length(); i < j; ++i){
                                if(cross[i]) countCross++;
                            }

                            for(uint8 i = 0, j = sides.length(); i < j; ++i){
                                if(sides[i]) countSides++;
                            }

                          if((countCross <= 2 && countSides <= 2)){// || (countCross < 2 && countSides <= 2))   {
                                cell.BiomType = BIOM_TYPE_RIVER;
                         }else{
                                cell.BiomType = BIOM_TYPE_LAKE;
                         }
				    }

				    cell.BiomFlags = biomFlag;
				    cell.BiomMapPid = GetBiomMapPid(cell.BiomType, cell.BiomFlags);

                }
                
                //Log("HEIGH "+cell.DefaultLevel+" xy "+cell.X+":"+cell.Y);
                
                if(cell.BiomType == BIOM_TYPE_LAKE){
                    //Log("BIOM TYPE"+cell.BiomType+" PID "+cell.BiomMapPid+ " FLAGS "+cell.BiomFlags + " XY " + x + ":"+y);
                    }
				/*}else if(iA[x] == BIOM_TYPE_ROAD){
					SETFLAG(cell.BiomFlags, BIOM_TYPE_ROAD);
				}else if(iA[x] == BIOM_TYPE_WASTELAND){
					SETFLAG(cell.BiomFlags, BIOM_TYPE_WASTELAND);
				}*/

			}
		}

	}else{Log("ERROR NULL LENGTH");}
	
	//Log("MOUNTAINT MAPS "+mountCount);

	return 0;

}

/*

shift%
wasteland - 0
forest      1
ruins       2
road        3
rr          4
mountain    5
water       6

= LOCATION_BIOM_SHIFT * 0 - horrizont
= LOCATION_BIOM_SHIFT * 1 - vert
= LOCATION_BIOM_SHIFT * 2 - n-e
= LOCATION_BIOM_SHIFT * 3 - s-e
= LOCATION_BIOM_SHIFT * 4 - s-w
= LOCATION_BIOM_SHIFT * 5 - n-w
*/

uint GetBiomMapPid(uint biomType, uint biomFlags){

    //if(biomType == BIOM_TYPE_WASTELAND || biomType == BIOM_TYPE_RUINS || biomType == BIOM_TYPE_FOREST){     //if simple type - return
    if(biomType <= BIOM_TYPE_RUINS){     //if simple type - return
            return LOCATION_BIOM_START + (LOCATION_BIOM_RANGE * biomType);
    }

    if(biomType == BIOM_TYPE_RIVER && FLAG(biomFlags, BIOM_HAS_BRIDGE)){
        if(FLAG(biomFlags, BIOM_HAS_CHILD_LEFT) && FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)){
            return 1001;
        }else{return 1000;}
    }
    
    /*if(_ValColl(BIOM_TYPE_MOUNTAIN_LEFT, BIOM_TYPE_MOUNTAIN_TOP, biomType)){
	return 1100 + 5 * (BIOM_TYPE_MOUNTAIN_LEFT - biomType);
    }*/

    bool[] biomMap = {
                        (FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)     && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)), //horr
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)),  //vert
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)), //n-e
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)     && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)), //s-e
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)     && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)), //s-w
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)), //n-w

                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN) && FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)), //ens
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT) && FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)), //nwe
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT) && FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)), //swe
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN) && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)) //wns
                        };

    bool[] lakeMap = {  //lake 12

                        (FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_HAS_CHILD_TOP)      && (FLAG(biomFlags, BIOM_HAS_CHILD_TL)  || FLAG(biomFlags, BIOM_HAS_CHILD_TR))  && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)     && (FLAG(biomFlags, BIOM_HAS_CHILD_DL)  || FLAG(biomFlags, BIOM_HAS_CHILD_DR))  && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)     && (FLAG(biomFlags, BIOM_HAS_CHILD_TL)  || FLAG(biomFlags, BIOM_HAS_CHILD_DL))  && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)    && (FLAG(biomFlags, BIOM_HAS_CHILD_TR)  || FLAG(biomFlags, BIOM_HAS_CHILD_DR))  && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)),

                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && FLAG(biomFlags, BIOM_HAS_CHILD_TL)       && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN) && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)     &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)     && FLAG(biomFlags, BIOM_HAS_CHILD_TL)  && FLAG(biomFlags, BIOM_HAS_CHILD_TR) &&   FLAG(biomFlags, BIOM_HAS_CHILD_DL) && !FLAG(biomFlags, BIOM_HAS_CHILD_DR)),

                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_HAS_CHILD_TR)       && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN) && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)     &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)     && FLAG(biomFlags, BIOM_HAS_CHILD_TL)  && FLAG(biomFlags, BIOM_HAS_CHILD_TR) &&   FLAG(biomFlags, BIOM_HAS_CHILD_DR) && !FLAG(biomFlags, BIOM_HAS_CHILD_DL)),

                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && FLAG(biomFlags, BIOM_HAS_CHILD_DL)       && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP) && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)     &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)     && FLAG(biomFlags, BIOM_HAS_CHILD_TL)  && FLAG(biomFlags, BIOM_HAS_CHILD_DL) &&   FLAG(biomFlags, BIOM_HAS_CHILD_DR) && !FLAG(biomFlags, BIOM_HAS_CHILD_TR)),

                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)    && FLAG(biomFlags, BIOM_HAS_CHILD_DR)      && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP) && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)     &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)     && FLAG(biomFlags, BIOM_HAS_CHILD_TR)  && FLAG(biomFlags, BIOM_HAS_CHILD_DL) &&   FLAG(biomFlags, BIOM_HAS_CHILD_DR) && !FLAG(biomFlags, BIOM_HAS_CHILD_TL))
                    };
		                    //(FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN && ) FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT), //ens


	bool[] mountMap = {

			(FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_MOUNTAIN_TOP)     && !FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)), //top we
			(FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT) &&  !FLAG(biomFlags, BIOM_MOUNTAIN_TOP)     && FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)), //down we
			
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && FLAG(biomFlags, BIOM_MOUNTAIN_LEFT)    && !FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)),  //left ns
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && !FLAG(biomFlags, BIOM_MOUNTAIN_LEFT)    && FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)),  //right ns
                       
                       
			(FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)   && !FLAG(biomFlags, BIOM_MOUNTAIN_LEFT) && !FLAG(biomFlags, BIOM_MOUNTAIN_TOP) && !FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)), //en
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)   && !FLAG(biomFlags, BIOM_MOUNTAIN_LEFT) && !FLAG(biomFlags, BIOM_MOUNTAIN_TOP) && !FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)), //es
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)   && !FLAG(biomFlags, BIOM_MOUNTAIN_LEFT) && !FLAG(biomFlags, BIOM_MOUNTAIN_TOP) && !FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)), //sw
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)   && !FLAG(biomFlags, BIOM_MOUNTAIN_LEFT) && !FLAG(biomFlags, BIOM_MOUNTAIN_TOP) && !FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)), //nw
                       
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)    && FLAG(biomFlags, BIOM_MOUNTAIN_LEFT)), //ne
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && FLAG(biomFlags, BIOM_MOUNTAIN_TOP)     && FLAG(biomFlags, BIOM_MOUNTAIN_LEFT)), //se
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && FLAG(biomFlags, BIOM_MOUNTAIN_TOP)     && FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)), //ws
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && FLAG(biomFlags, BIOM_MOUNTAIN_DOWN)    && FLAG(biomFlags, BIOM_MOUNTAIN_RIGHT)) //wn
                        
                        

			
// 			(FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)     && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)), //en
//                         (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)   && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)     && !FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)), //es
//                         (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)   &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_TOP)     && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)), //sw
//                         (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)    &&  FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)    && !FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)    && !FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT)) //nw


	      };
                        /* depraceted
                        //road && railroad only
                        (FLAG(biomFlags, BIOM_HAS_CHILD_TOP)),                                              //top
                        (FLAG(biomFlags, BIOM_HAS_CHILD_DOWN)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_LEFT)),
                        (FLAG(biomFlags, BIOM_HAS_CHILD_RIGHT))

n		+		left + right + top + (tl || tr)                 +
s		+		left + right + down + (dl || dr)                +
w		+		top + down + left + (tl || dl)                  +
e		+		top + down + right + (tr || dr)                 +
nw		+		top + down + left + right + (tl && tr && dl)    +
wn		+		top + left + tl                                 +
ne		+		top + down + left + right + (tl && tr && dr)    +
en		+		top + right + tr                                +
sw		+		top + down + left + right + (tl && dl && dr)    +
ws		+		down + left + dl
se		+		top + down + left + right + (tr && dl && dr)    +
es		+		down + right + dr
                        */

    bool[] bArr;// = (biomType != BIOM_TYPE_LAKE ? biomMap : lakeMap);
    
    switch(biomType){
      case BIOM_TYPE_LAKE : bArr = lakeMap; break;
      case BIOM_TYPE_MOUNTAIN : bArr = mountMap; break;
      default : bArr = biomMap; break;
    }

    uint addPid = 0;

    for(uint i = 0, j = bArr.length(); i < j; ++i){
        if(i >= j - 4 && biomType == BIOM_TYPE_RIVER) break;  //break if simple
        //if(i >= j - 12 && biomType != BIOM_TYPE_LAKE) break;  //break if simple

        if(bArr[i]){
            addPid = LOCATION_BIOM_SHIFT * i;

            /*if(biomType == BIOM_TYPE_MOUNTAIN)
                Log("BIOM FIND "+biomType+" :: "+LOCATION_BIOM_RANGE + " "+(LOCATION_BIOM_RANGE * biomType)+ " " + addPid+" ::: "+i);
            //break;
            */
        }
    }
 
    return LOCATION_BIOM_START + (LOCATION_BIOM_RANGE * biomType) + addPid;
}
