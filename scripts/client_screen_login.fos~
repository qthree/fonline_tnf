class CLoginInputBox :  IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackKeyPress
{
    bool Mode;
    bool Active;

    string Text;

    IGUIElementOpt@ Options;

    CLoginInputBox(bool mode){
            Mode = mode;
    }

    void OnMouseClick(int click){

        //SetActive();
        SwitchState();

        if(Mode){
        }else{
        }
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();

        uint8 index = (Mode?LOGIN_INPUTBOX_PASS_INDEX:LOGIN_INPUTBOX_NAME_INDEX);

        @inputBoxs[index] = this;

        if(index == LOGIN_INPUTBOX_NAME_INDEX){
                //SetActive();
                //State();
                Active = true;
                //SwitchState();
        }else{Active = false;}
    }

    void OnKeyPress( uint8 key, uint8 letter ){
        if(letter == 'a'){Message("TEST!");}
    }

    bool KeyPress(uint8 key){
           return true;//Options.KeyPress(key);
    }

    void SetText(string text){
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
    }

    string GetText(){
           return Options.GetText();
    }

    void TextAdd(uint8 letter){
            string text = Options.GetText();

            //text.insertLast(letter);

            StrInsLast(text, letter);
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
    }

    void TextRm(){

            string text = Options.GetText();
            if(text.length() > 0){

                //text.removeLast();
                StrRmLast(text);
                Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
            }
    }

    void StrInsLast(string& str, uint8 letter){
            uint len = str.length();
            str.resize(len+1);
            str[len] = letter;

    }

    void StrRmLast(string& str){
            uint len = str.length()-1;
            if(len >= 0) str.resize(len);
    }

    void SetActive(){
           Active = !Active;
    }

    void State(){
            Options.Switch(Active);
    }

    void SwitchState(){
        SetActive();
        State();

        uint8 index = (!Mode?LOGIN_INPUTBOX_PASS_INDEX:LOGIN_INPUTBOX_NAME_INDEX);
        inputBoxs[index].SetActive();
        inputBoxs[index].State();
        //inputBoxs[index].SwitchState();

    }
}

uint8[] lang = {'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'};

class CLoginScreenButton : IGUIElementCallbackMouseClick, IGUIElementCallbackInit
{

    uint8 Mode;
    CLoginScreen@ Instance;
    IGUIElementOpt@ Options;

    CLoginScreenButton(CLoginScreen& instance, uint8 mode){
            @Instance = instance;
            Mode = mode;
    }

    void OnMouseClick(int click){

        string name = "", pass = "";
        Instance.UserDataGet(name, pass);

        if(Mode == LOGIN_SCREEN_BTN_ENTER){
                //in-game login actions
                if(name.length() <= 0 || pass.length() <= 0) return;
#ifdef __DEBUG
                Message("login "+name+" "+pass);
#endif //__DEBUG

                NetLogin(2, name, pass);

        }else if(Mode == LOGIN_SCREEN_BTN_REG){
                //register
                //if(name.length() <= 0 || pass.length() <= 0) return;

                if(forumId == uint(-1)) {Message("wrong forum id. contact with developer"); return;}

                name = Instance.CharCreateInput.GetText();
                if(name == "") {Message("null char name"); return;}

                uint nameHash = 0;

                for(uint i = 0, j = name.length(); i < j; ++i){
                    nameHash += name[i] * 1000;
                }

                Message(""+nameHash);

                if(CheckCharName(name)){

                    string rName;// = (name+""+Random(1000,9999));
                    string pass = ""+Random(1000000, 9999999);

                    //rName = nameHash;

                    rName.resize(30);
                    pass.resize(14);

                    for(uint8 i = 0, j = rName.length(); i<j; ++i){
                        rName[i] = lang[Random(0,25)];

                        if(i>=14) continue;
                        pass[i] = lang[Random(0,25)];
                    }
#ifdef __DEBUG
                    Message("rand name "+rName);
#endif //__DEBUG

                    //pass.resize(7);

                    //if(NetLogin(3, name, pass) == 0

                        if(MysqlInsertCharData(forumId, name, rName, pass) == 0){

                            //if(Instance.CharListRefresh()){
                            if(OutGetChars(forumId) != -1){

                                if(NetLogin(3, rName, pass) == 0){
                                        ::ShowScreen(CLIENT_SCREEN_LOGIN_TNF, 0, 0, 0);
                                        Message("|0xFF0000 Персонаж создан успешно.");
                                }
                                //NetLogin(3, name, pass);
                            }else{Message("|0xFF0000 Ошибка. Персонаж не создан. Обратитесь к Геим Мастеру.");}
                            //NetLogin(3, name, "test");
                        }else{
                            string error = "";
                            MysqlError(error);
                            Message("Ошибка sql "+error);
                        }
                }
        }else if(Mode == LOGIN_SCREEN_BTN_EXIT){
                if(Instance.IsRegActive()){
                        ShowReg();
                }else{
                        ::HideScreen(CLIENT_SCREEN_LOGIN_TNF, 0, 0, 0);
                }
        }else if(Mode == LOGIN_SCREEN_BTN_REGSHOW){
                ShowReg();
        }else if(Mode == LOGIN_SCREEN_BTN_REMOVE_CHAR){Message("|0x000000 Функционал не реализован.");}
    }

    void OnInit(){
            @Options = GUI_GetElementOptions();
    }

    bool CheckCharName(string name){

            if(MysqlConnect(__SqlLocalCall)){
                if(MysqlSelectDb() == 0){

                        int r = MysqlCheckCharName(name);

                        Message("r = "+r);

                        if(r != 0){
                            /*string error = "";
                            MysqlError(error);
                            Message("error "+error+" ext code "+r);*/
                            Message("char exist. enter new name");
                        }else{

                            return true;
                        }
                }

                MysqlClose();
            }else{
                    Message("sql connect error");
            }

        return false;
    }
