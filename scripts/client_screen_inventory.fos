class InventoryItem
{
	InventoryItem()
	{
		Child = false;
		Rolled = false;
	}
	
	InventoryItem(uint id, uint16 count, string name, ItemCl& item)
	{
		Id.resize(1);
		Count.resize(1);
		
		Id[0] = id;
		Count[0] = count;
		Name = name;
		
		Child = true;
		
		tempItem.resize(1);
		@tempItem[0] = item;
	}
	
	InventoryItem(uint[] id, uint16[] count, string name, ItemCl@[]& item)
	{
		Id = id;
		Count = count;
		Name = name;
		
		Child = false;
		
		tempItem = item;
	}
	
	void GetItems(ItemCl@[]& items)
	{
		items = tempItem;
	}
	
	void RemoveArrLast(){
		RemoveArr(Id.length()-1);
	}
	
	void RemoveArr(uint8 index){
		Id.removeAt(index);
		Count.removeAt(index);
	}
		
	uint[] Id;
	uint16[] Count;
	uint16 ProtoId;
	string Name;
	bool Child;
	bool Rolled;
	
	int TextW0;
	int TextW1;
	string Text0;
	string Text1;
	
	ItemCl@[] tempItem;
}

