		InventoryButtons.resize(INVENTORY_ITEMS_LIST_COUNT);
		InventoryButtonsWear.resize(INVENTORY_ITEMS_SLOT_COUNT);
		//Message("btns len "+InventoryButtons.length()+":"+InventoryButtonsWear.length());
	}
