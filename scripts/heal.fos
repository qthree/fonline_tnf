bool FindItemInCont( Item@[]& drugs, uint8[]& drugIndexs, bool[]& isHaveItem, uint16 flag, bool isFirstAid )
{
    uint8 drugsLength = drugs.length();
    if( drugsLength > 0 )
    {
        for( uint8 i = 0; i < drugsLength; i++ )
        {

            uint16 drugProtoId = drugs[ i ].GetProtoId();

            if( isFirstAid )
            {


                if( drugProtoId == PID_BOOZE )
                {
                    if( !FLAG( flag, HEAL_ANTISEPTIC ) )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }
                    else if( !isHaveItem[ 0 ] )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }
                }
                else if( drugProtoId == PID_ANTISEPTIC )
                {
                    if( FLAG( flag, HEAL_ANTISEPTIC ) )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }
                    else if( !isHaveItem[ 0 ] )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }
                }

                else if( drugProtoId == PID_HEALING_POWDER )
                {
                    if( !FLAG( flag, HEAL_HEALING ) )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                    else if( !isHaveItem[ 1 ] )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                }
                else if( drugProtoId == PID_STIMPAK )
                {
                    if( FLAG( flag, HEAL_HEALING ) )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                    else if( !isHaveItem[ 1 ] )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                }

                else if( drugProtoId == PID_RAGS )
                {
                    if( !FLAG( flag, HEAL_BANDAGE ) )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                    else if( !isHaveItem[ 2 ] )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                }
                else if( drugProtoId == PID_BANDAGE )
                {
                    if( FLAG( flag, HEAL_BANDAGE ) )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                    else if( !isHaveItem[ 2 ] )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                }

                // {drugIndexs[1] = i; isHaveItem[1] = true;}

/*
                                 && !FLAG(flag, HEAL_ANTISEPTIC))
                                {
                                        drugIndexs[0] = i; isHaveItem[0] = true; //cr.Say(SAY_NETMSG,"booze");
                                }
                                else if(drugProtoId == PID_ANTISEPTIC && FLAG(flag, HEAL_ANTISEPTIC))
                                {
                                        drugIndexs[0] = i; isHaveItem[0] = true; //cr.Say(SAY_NETMSG,"booze");
                                }
                                else if(drugProtoId == PID_ANTISEPTIC || drugProtoId == PID_BOOZE)
                                {
                                        drugIndexs[0] = i; isHaveItem[0] = true; //cr.Say(SAY_NETMSG,"booze");
                                }
                                if(!isHaveItem[1])
                                if(drugProtoId == PID_HEALING_POWDER && !FLAG(flag, HEAL_HEALING))
                                {
                                        drugIndexs[1] = i; isHaveItem[1] = true; //cr.Say(SAY_NETMSG,"powder");
                                }
                                else if(drugProtoId == PID_STIMPAK && FLAG(flag, HEAL_HEALING))
                                {
                                        drugIndexs[1] = i; isHaveItem[1] = true; //cr.Say(SAY_NETMSG,"stimpack");
                                }
                                else if(drugProtoId == PID_HEALING_POWDER || drugProtoId == PID_STIMPAK)
                                {
                                        drugIndexs[1] = i; isHaveItem[1] = true; //cr.Say(SAY_NETMSG,"stimpack");
                                }

                                if(drugProtoId == PID_RAGS && !FLAG(flag, HEAL_BANDAGE))
                                {
                                        drugIndexs[2] = i; isHaveItem[2] = true; //cr.Say(SAY_NETMSG,"rags");
                                }
                                else if(drugProtoId == PID_BANDAGE && FLAG(flag, HEAL_BANDAGE))
                                {
                                        drugIndexs[2] = i; isHaveItem[2] = true; //cr.Say(SAY_NETMSG,"bandage");
                                }
                                else if(drugProtoId == PID_RAGS || drugProtoId == PID_BANDAGE)
                                {
                                        drugIndexs[2] = i; isHaveItem[2] = true; //cr.Say(SAY_NETMSG,"bandage");
                                }*/
            }
            else
            {
                if( drugProtoId == PID_BOOZE )
                {
                    if( !FLAG( flag, HEAL_ANTISEPTIC ) )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }                                                                                                   // low antiseptic ; low anestetic
                    else if( !isHaveItem[ 0 ] )
                    {
                        drugIndexs[ 0 ] = i;
                        isHaveItem[ 0 ] = true;
                    }                                                                                      // cr.Say(SAY_NETMSG,"booze");

                    if( !FLAG( flag, HEAL_ANESTETIC ) )
                    {
                        drugIndexs[ 4 ] = i;
                        isHaveItem[ 4 ] = true;
                    }
                    else if( !isHaveItem[ 4 ] )
                    {
                        drugIndexs[ 4 ] = i;
