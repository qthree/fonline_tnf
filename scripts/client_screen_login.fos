        CRegButton(CLoginScreen& instance){
                @Instance = instance;
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnMouseClick(int click){
            NetLogin(3, "test_guy", "test");
        }
}
