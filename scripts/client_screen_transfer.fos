import string item_description(ItemCl& item, int lookType) from "client_main";
import string generic_description(int descType, int& offsX, int& offsY) from "client_main";


#define INVENTORY_ITEMS_LIST_COUNT		(20)
#define INVENTORY_ITEMS_LIST_DOWN		(0)
#define INVENTORY_ITEMS_LIST_UP			(1)
#define INVENTORY_ITEMS_LIST_LEFT		(2)
#define INVENTORY_ITEMS_LIST_RIGHT		(3)
#define INVENTORY_ITEMS_LIST_DOWN_FORCED	(4)
#define INVENTORY_ITEMS_LIST_UP_FORCED		(5)

#define INVENTORY_SORT_COUNT			(0)
#define INVENTORY_SORT_ABC			(1)
#define INVENTORY_SORT_SLOT			(2)
#define INVENTORY_SORT_NOP			(3)

#define INVENTORY_SORT_COUNT			(0)
#define INVENTORY_SORT_ABC			(1)
#define INVENTORY_SORT_SLOT			(2)
#define INVENTORY_SORT_NOP			(3)

#define INVENTORY_GROUP_NOP			(0)
#define INVENTORY_GROUP_ARMOR			(1)
#define INVENTORY_GROUP_DRUG			(2)
#define INVENTORY_GROUP_WEAPON			(3)
#define INVENTORY_GROUP_AMMO			(4)
#define INVENTORY_GROUP_MISC			(5)

#define SIDE_LEFT                       (0)
#define SIDE_RIGHT                      (1)

#define ITEM_TRANSFER_MEMBERS           (3)

#define DEBUG_ITEM_INV_NAME		("no item")

class ItemTransfer
{
    //uint8 Type;

    uint16 Pid;

    uint Id;
    uint Count;

    //uint PicInv;
    //uint Weight

    ItemTransfer(uint16 pid, uint id, uint count){//, uint picInv, uint8 type){
        Pid = pid;
        Id = id;
        Count = count;
        //PicInv = picInv;
        //Type = type;
    }
}

class InventoryItem
{
	InventoryItem()
	{
		Child = false;
		Rolled = false;
	}

	//InventoryItem(uint id, uint16 count, string name, ItemCl& item)
	InventoryItem(uint id, uint16 count, string name, ItemTransfer& item)
	{
		Id.resize(1);
		Count.resize(1);

		Id[0] = id;
		Count[0] = count;
		Name = name;

		Child = true;

		tempItem.resize(1);
		@tempItem[0] = item;
	}

	//InventoryItem(uint[] id, uint16[] count, string name, ItemCl@[]& item)
	InventoryItem(uint[] id, uint16[] count, string name, ItemTransfer@[]& item)
	{
		Id = id;
		Count = count;
		Name = name;

		Child = false;

		tempItem = item;
	}

	void GetItems(ItemTransfer@[]& items)
	{
		items = tempItem;
	}

	void RemoveArrLast(){
		RemoveArr(Id.length()-1);
	}

	void RemoveArr(uint8 index){
		Id.removeAt(index);
		Count.removeAt(index);
	}

	uint[] Id;
	uint16[] Count;
	uint16 ProtoId;
	string Name;
	bool Child;
	bool Rolled;

	int TextW0;
	int TextW1;
	string Text0;
	string Text1;

	//ItemCl@[] tempItem;
	ItemTransfer@[] tempItem;
}

class ScreenTransfer : IGUIScreenCallbackShow, IGUIScreenCallbackHide
