import void DropItem(uint index, uint id, uint count) from "client_screen_inventory";

#define MAX_COUNT		(10000)

#define BUTTON_EXIT		(0)
#define BUTTON_DONE		(1)
#define BUTTON_ALL		(2)


//MOVEMULT.FRM
//SEXOFF
//SKLDXOFF
//ALLBON
