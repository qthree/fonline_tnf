void _BlankKeyInit(Item& item, bool firstTime)
{
  if(firstTime)
  {
    item.SetLexems("$KeyLex"+"unnamed key");
    item.SetEvent(ITEM_EVENT_USE, "e_BlankKeyUse");
  }
}



Item @ key;


bool ItemLockedCont(Item& item)
{
  if(item.GetType() == ITEM_CONTAINER)
  {
    uint16 proto = item.GetProtoId();
    if(41 < proto && proto < 46) {return true;}
    if(127 < proto && proto < 140) {return true;}
    if(180 < proto && proto < 190) {return true;}
    if(366 < proto && proto < 371) {return true;}
    switch(proto)
    {
     case 245: return true;
     case 501: return true;
     case 502: return true;
     case 521: return true;
    }
  }
  return false;
}


bool e_BlankKeyUse(Item& item, Critter& cr, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{
  if(valid(onItem))
  {
    if(onItem.GetType() == ITEM_DOOR || ItemLockedCont(onItem))
    {
      if(_LockerIsClose(onItem))/*onItem.LockerCondition == LOCKER_ISOPEN*/
      {
	if(onItem.LockerCondition != LOCKER_LOCKED && onItem.LockerComplexity == 0)
	{
// 	  cr.Say(SAY_NETMSG, "if passed");	
	  uint keyNumber = Random(0, 65534);	  
	  onItem.LockerCondition = LOCKER_LOCKED;
	  onItem.LockerComplexity = cr.StatBase[SK_LOCKPICK];
	  onItem.LockerId = keyNumber;
	  item.LockerId = keyNumber;
	  @key = item;
	  cr.ShowScreen(SCREEN_SAY , 0, "item@KeyUseScreen");
	  return true;
	}
	else
	{
	  cr.Say(SAY_NETMSG, "Door allready locked. Lockpick it first");
	  return true;
	}
      }
      else
      {
	cr.Say(SAY_NETMSG, "Plz close locker 	first");
	return true;
      }
    }
     else
      {
	cr.Say(SAY_NETMSG, "This item can't be locked");
	return true;
      }
//     cr.Say(SAY_NETMSG, "if 2 not passed");
  }

//   cr.Say(SAY_NETMSG, "all if not passed");

  return false;
}

