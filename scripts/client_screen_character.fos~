bool SetOutParam(uint16 paramIndex, uint16 paramValue){
        if(outCharScreen is null) return false;
        outCharScreen.Param[paramIndex] = paramValue;
        return true;
}

bool GetOutParam(uint16 paramIndex, uint16& paramValue){
        if(outCharScreen is null || paramIndex >= outCharScreen.Param.length()) return false;
        //Message("param out "+paramIndex);
        paramValue = outCharScreen.Param[paramIndex];
        return true;
}
