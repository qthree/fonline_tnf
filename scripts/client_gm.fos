        if( itemArg.getType() == INTEGER && txArg.getType() == INTEGER && tyArg.getType() == INTEGER)
        {
            //uint16  x = __MouseX, y = __MouseY;
            //ItemCl@ item = GetMonitorItem( x, y );
            
            int mapId = (argAmount() >= 4 ? getArg(3).getIntData() : 0);
            
