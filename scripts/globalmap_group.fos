void Ttransit(Critter& cr, Scenery& trigger, bool entered, uint8 dir)
{
	cr.Say(SAY_NETMSG, ""+dir);
	TransitCritterToCell(cr, dir);
}

void Ttransit(Item& item, bool firstTime)
{
	item.SetEvent(ITEM_EVENT_WALK, "e_WalkTrigger");
}

void e_WalkTrigger(Item& item, Critter& cr, bool entered, uint8 dir)
{
	TransitCritterToCell(cr, item.Val0);
}

int GetCellMap(uint16 x, uint16 y)
{
	Cell @ cell = world.GetCell(x*0.1, y*0.1);
	if(@cell == null) return -1;
	return cell.Content.MapId;
}