	void RollUpItem(uint8 index)
	{
		//if(prevIndex == index)
		//{
			//Message("index0 "+index);
			
			uint16 itemsLen = InventoryItems.length();
			
			if(index+1 < itemsLen){
				if(!(!InventoryItems[index].Child && InventoryItems[index+1].Child)){
					return;
				}
			}
			
			index++;
			//Message("index "+index);
			while(index < InventoryItems.length() && InventoryItems[index].Child)
			{
			//	Message("index "+index+" "+InventoryItems.length());
				InventoryItems.removeAt(index);
			};
				
			//Instance.InventoryButtons[prevIndex].Rolled = false;
			ShowList(Instance.InventoryButtons[0].InvItemIndex);
			
		//}
	}
	
	void RollUpItemArrow(uint8 index)
	{
		uint8 tempIndex = index;
		while(InventoryItems[Instance.InventoryButtons[tempIndex].InvItemIndex].Child)
		{
			--tempIndex;
			Message("tmpIndx "+tempIndex);
		};
		
		RollUpItem(tempIndex);
		SelectItem(tempIndex);
	} 
	
	void MoveItemList(bool up, bool forced)
	{
		
			//Instance.InventoryButtons[prevIndex] = InventoryItems[prevIndex+1];
			//Message(""+prevIndex);
			
			uint8 realIndex = prevIndex + 1;
			uint16 itemsLen = InventoryItems.length();
			//uint16 invItemIndex = Instance.InventoryButtons[0].InvItemIndex
			
			if(forced)
			{
				if(up)
				{
					if(Instance.InventoryButtons[0].InvItemIndex != uint16(-1))
					{
						ShowList(0);
						SelectItem(0);
					}
					
				}else
				{
					int lastItem = (itemsLen - INVENTORY_ITEMS_LIST_COUNT);
					uint8 realIndex = itemsLen -1 ;
					
					if(lastItem > 0)
					{
						ShowList(lastItem);
						realIndex = INVENTORY_ITEMS_LIST_COUNT-1;
					}
					
					SelectItem(realIndex);
				}
				
				return;
			}
			
			if(up)
			{  
				bool list = (Instance.InventoryButtons[0].InvItemIndex > 0);
				if(realIndex <= INVENTORY_ITEMS_LIST_COUNT)
				{
					if(list)
					{
						ShowList(Instance.InventoryButtons[0].InvItemIndex - 1);
					}
					SelectItem(prevIndex + (list ? 0 : -1));
				}
			}else
			if(realIndex < itemsLen)
			{
				
				if(Instance.InventoryButtons[INVENTORY_ITEMS_LIST_COUNT-1].InvItemIndex != uint16(-1) && Instance.InventoryButtons[INVENTORY_ITEMS_LIST_COUNT-1].InvItemIndex + 1 >= itemsLen) return;
				
				bool list = (realIndex == INVENTORY_ITEMS_LIST_COUNT && itemsLen > INVENTORY_ITEMS_LIST_COUNT); //&& Instance.InventoryButtons[realIndex].InvItemIndex != uint16(-1));
				
				//if(Instance.InventoryButtons[realIndex].InvItemIndex == uint16(-1))
				//Message("prev "+prevIndex+" item "+itemsLen+" list "+INVENTORY_ITEMS_LIST_COUNT+" bool "+list);
				
				if(list)
				{
					ShowList(Instance.InventoryButtons[0].InvItemIndex + 1);
				}
				
				SelectItem(list ? prevIndex : realIndex);
			}else	{return;}
			
	}
	
	void Sort(uint8 sortType, bool reverse)
	{
		//InventoryItem[] tempInvItems;
		//tempInvItems.resize(InventoryItems.length());
		/*
		for(uint16 i = 0, j = InventoryItems.length(); i < j; ++i)
		{
			uint16 itemIndex = 0;
			
			while(InventoryItems[i].Count[0] > tempInvItems[tempInvItems.length()-1].Count[0] || itemIndex != j)
			{
				++itemIndex;
			};
			
			//tempInvItems.insertAt(itemIndex, InventoryItems[i]);
		}*/
		
	      //int i, j, tmp;
	      InventoryItem tempInvItem;
	      
	      Message(""+sortType);
	      
	      if(sortType == INVENTORY_SORT_COUNT)
	      {
	      
			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++) 
			{
				j = i;
			
				//Message(""+InventoryItems[j].Name+" "+InventoryItems[j-1].Name);
				//Message(""+InventoryItems[j].Count[0]+" "+InventoryItems[j-1].Count[0]);
			
				while (j > 0 && InventoryItems[j - 1].Id.length() > InventoryItems[j].Id.length()) 
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}
		}else
		if(sortType == INVENTORY_SORT_ABC)
		{
			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++) 
			{
				j = i;
		
				while (j > 0 && InventoryItems[j - 1].Name > InventoryItems[j].Name) 
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}

			
		}else
		if(sortType == INVENTORY_SORT_SLOT)
		{
			
			for (uint16 i = 1, j = 0; i < InventoryItems.length(); i++) 
			{
				j = i;
		
				while (j > 0 && InventoryItems[j - 1].tempItem[0].CritSlot > InventoryItems[j].tempItem[0].CritSlot) 
				{
					tempInvItem = InventoryItems[j];
					InventoryItems[j] = InventoryItems[j - 1];
					InventoryItems[j - 1] = tempInvItem;
					j--;
				}
			}
		}else
		if(sortType == INVENTORY_SORT_NOP)
		{
			FullRefreshItemList();
		}else return;
		
		if(reverse) InventoryItems.reverse();
		ShowList(Instance.InventoryButtons[0].InvItemIndex);
	}
	
	bool IsRolled(uint8 index){
		return (InventoryItems[index].Count[0] > 0);
	}
  
  }

class InventoryItemButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick, IGUIElementCallbackDraw
{
	IGUIElementOpt@ Options;
	ScreenInventory @ Instance;
	
	//bool	Rolled;
	
	uint8  Index;
	uint16 InvItemIndex;
	
	InventoryItemButton(ScreenInventory& instance, uint8 index)
	{
		@Instance = instance;
		Index = index;
		//Rolled = false;
	}
	
	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		//@Instance.Hand_[HandType] = this;
		Instance.InventoryButtons.insertAt(Index, this);
		
		
	}
	
	void OnMouseClick(int click)
	{
	  /*	uint[] Id;
	uint16[] Count;
	uint16 ProtoId;
	string Name;
	bool Child;*/
	  
		bool rolled = Instance.ItemList.InventoryItems[InvItemIndex].Rolled;
		
		Instance.ItemList.SelectItem(Index);
		
		InventoryItem tempInvItem = Instance.ItemList.InventoryItems[InvItemIndex];
	  
		string msg = ("id "+tempInvItem.Id[0]+"\ncount "+tempInvItem.Count[0]+"\npID "+tempInvItem.ProtoId+"\nchild "+tempInvItem.Child+"\nrolled "+rolled);
		//Message(msg);
	  
		
		if(click == MOUSE_CLICK_LEFT)
		{	
				!rolled ? Instance.ItemList.DropItem(InvItemIndex) : Instance.ItemList.RollUpItem(InvItemIndex);
				//Rolled = (Rolled ? false : true);
		}else
 		if(click == MOUSE_CLICK_RIGHT)
		{
			ItemCl@[] items;
			Instance.ItemList.InventoryItems[InvItemIndex].GetItems(items);
			//Message("bla bla lba "+items.length());
			ItemInventoryArray(items);
			__subMenuNum = SUBMENU_INVENTORY;
			::ShowScreen(CLIENT_SCREEN_CONTMENU,__MouseX,__MouseY,0);
		}else
		if(click == MOUSE_CLICK_WHEEL_UP)
		{
			Instance.ItemList.MoveItemList(true, false);
		}else
		if(click == MOUSE_CLICK_WHEEL_DOWN)
		{
			Instance.ItemList.MoveItemList(false, false);
		}
		/*if(Rolled)
		{
			Instance.ItemList.RollUpItem(Index);
		}*/
		
		Instance.ItemList.InventoryItems[InvItemIndex].Rolled = !rolled;
		
	}
	
	void OnDraw()
	{
		string text0 = "no item", text1 = "", name = "";
		int offsX = 0, x = 0, y = 0, xOff = Instance.screenOpt.GetPosX() + Options.GetPosX(), yOff = Instance.screenOpt.GetPosY() + Options.GetPosY();
		if(InvItemIndex != uint16(-1) && Instance.ItemList.InventoryItems.length() > InvItemIndex) //< Instance.ItemList.InventoryItems.length())
		{
			offsX = Instance.ItemList.InventoryItems[InvItemIndex].TextW0+Instance.ItemList.InventoryItems[InvItemIndex].TextW1;
			text0 = Instance.ItemList.InventoryItems[InvItemIndex].Text0;
			text1 = Instance.ItemList.InventoryItems[InvItemIndex].Text1;
			name  = Instance.ItemList.InventoryItems[InvItemIndex].Name;
		}	
		
		DrawText(""+text0+name, x+xOff, 2+y+yOff, 500 , 400, COLOR_SAND, FONT_FALLOUT,  0);
		DrawText(""+text1, x+xOff+offsX, 2+y+yOff, 500 , 400, COLOR_SAND, FONT_FALLOUT,  0);
	}
	
	void PressPic(bool press)
	{
		Options.UpPic(press ? "invItemDown.png" : "invItemUp.png");
	}
}

