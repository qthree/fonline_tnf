        @Instance.MoveBtn[Side] = this;
    }

    void OnMouseClick(int click){

        ItemTransfer @ temp = Instance.ItemList[Side].GetTransferItem();
        if(temp is null) {Message("transfer item error");return;}

        RunServerScriptUnsafe("general_unsafe@unsafe_moveItemsCont", temp.Id, temp.Count, Side > 0 ? 0 : 1, null, null);
        //ActionCreate();
/*
        for(uint8 i = 0; i < 2; ++i){
			    Instance.ItemList[i].FullRefrash();
