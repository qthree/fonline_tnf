#define FILE_NAME      "FastPanel.cfg"
#define LINE_TOKEN     "!"
#define SPACE_TOKEN    "*"
#define ID_TOKEN       "&"


uint GetColor( uint8 sayType )
{
    uint color = 0;
    switch( sayType )
    {
    case 1:
        color = COLOR_SAND;
        break;
    case 2:
        color = COLOR_LRED;
        break;
    case 3:
        color = COLOR_LGREEN;
        break;
    case 4:
        color = COLOR_LBLUE;
        break;
    case 5:
        color = COLOR_LGRAY;
        break;
    default:
        color = COLOR_WHITE;
        break;
    }
    return color;
}

//int MysqlSetPanel(unsigned int id, ScriptString& cellId, ScriptString& type, ScriptString& subType, ScriptString& panelId, ScriptString& text, ScriptString& desc, ScriptString& spriteUp, ScriptString& spriteDown)
void SavePanel20(){

    CritterCl @ choo = GetChosen();
    if(choo is null) return;

    string[] cellsData;
    cellsData.resize(8);

    MysqlInit();

    if(MysqlConnect(__SqlLocalCall)){
        if(MysqlSelectDb() == 0){

                //for(uint8 i = 0, j = panel.Cells.length(); i<j; ++i){

                uint8 cellId = (PANEL_BUTTON_COUNT * panel.Layer + panel.ButtonLast);

                //if(panel.Cells[cellId].PanelId == 0/* || panel.Cells[i].Text == "" || panel.Cells[i].Desc == ""*/) return;



                cellsData[0] = panel.Cells[cellId].Id;
                cellsData[1] = panel.Cells[cellId].Type;
                cellsData[2] = panel.Cells[cellId].SubType;
                cellsData[3] = panel.Cells[cellId].PanelId;
                cellsData[4] = panel.Cells[cellId].Text;
                cellsData[5] = panel.Cells[cellId].Desc;
                cellsData[6] = panel.Cells[cellId].SpriteUp;
                cellsData[7] = panel.Cells[cellId].SpriteDown;

                int r = MysqlSetPanel(choo.Id, cellsData[0], cellsData[1], cellsData[2], cellsData[3], cellsData[4], cellsData[5], cellsData[6], cellsData[7]);

                if(r != 0){
                    string temp;
                    MysqlError(temp);
                    Message( "sql error : "+temp+ " " +r);
                }
            //}

        }
        MysqlClose();
    }
}

void LoadPanel20(){

    string[]    cellsData;

    CritterCl @ choo = GetChosen();
    if(choo is null) return;

    FastPanelCellClear();

    //Message("got chosen");

    cellsData.resize(8);

    MysqlInit();

    if(MysqlConnect(__SqlLocalCall)){
        if(MysqlSelectDb() == 0){

            //Message("connect db");

            //string query = "";

            int r = MysqlGetPanel(choo.Id, cellsData[0], cellsData[1], cellsData[2], cellsData[3], cellsData[4], cellsData[5], cellsData[6], cellsData[7]);

            if(r < 0){
                string temp;
                MysqlError(temp);
                Log( "sql error : "+temp);
            }else{
                //action here
                string@[]@ cellField;

                Message("yep");

                //for each member of FastCell
                //for(uint8 i = 0, j = cellsData.length(); i<j; ++i){
                    //@cellField = split(cellsData[i], "&");
                    //if(cellField is null) continue;

                    string@[]@ cellId_ = split(cellsData[0], "&");
                    string@[]@ type_ = split(cellsData[1], "&");
                    string@[]@ subType_ = split(cellsData[2], "&");
                    string@[]@ panelId_ = split(cellsData[3], "&");
                    string@[]@ text_ = split(cellsData[4], "&");
                    string@[]@ desc_ = split(cellsData[5], "&");
                    string@[]@ spriteUp_ = split(cellsData[6], "&");
                    string@[]@ spriteDown_ = split(cellsData[7], "&");

                    int cellId = 0, type = 0, subType = 0, panelId = 0;

                    uint8 len = cellId_.length();
                    Message("len "+len);
                    //if(type_.length() != len || subType != len)*/

                    for(uint8 i = 0, j = cellId_.length()-1; i < j; i++){

                        //cellId = cellId[i];

                        StrToInt(cellId_[i], cellId);
                        StrToInt(type_[i], type);
                        StrToInt(subType_[i], subType);
                        StrToInt(panelId_[i], panelId);

                        panel.Cells[cellId].Id = uint(cellId);
                        panel.Cells[cellId].Type = uint(type);
                        panel.Cells[cellId].SubType = uint(subType);
                        panel.Cells[cellId].PanelId = uint(panelId);
                        panel.Cells[cellId].Text = text_[i];
                        panel.Cells[cellId].Desc = desc_[i];
                        panel.Cells[cellId].SpriteUp = spriteUp_[i];
                        panel.Cells[cellId].SpriteDown = spriteDown_[i];
                    }

                    //Message("load "+i);


/*
                    for(uint8 ii = 0, jj = cellField.length(); ii < jj; ++ii){
                        panel.Cells[ce].SetMember(i, cellField[ii]);
                    }
                    */
                //}
            }

        }
        MysqlClose();
    }
}
