void _DropPlant( Item& item, Critter& cr )
{
    Map@ map = cr.GetMap();
    if( map is null )
        return;

    if( item.Val1 != 0 )
        return;

    if( map.GetItems( cr.HexX, cr.HexY, null ) > 1 )
    {
        if( cr.IsLife() )
            cr.Say( SAY_NETMSG, "Это тут не прорастет." );
        return;
    }

    item.SetEvent( ITEM_EVENT_SKILL, "_SkillPlant" );
    item.SetEvent( ITEM_EVENT_WALK, "_WalkPlant" );
    item.SetEvent( ITEM_EVENT_USE_ON_ME, "_OnMePlant" );
    uint time = 0;
    if( CheckGard( map, cr.HexX, cr.HexY ))
    {
        time = GAME_MINUTE( 4 );
        if( cr.IsLife() )
            cr.Say( SAY_NETMSG, "Плод посажен." );
    }
    else
    {
        time = GAME_DAY( 2 );
        if( cr.IsLife() )
            cr.Say( SAY_NETMSG, "Здесь плод будет проростать очень долго." );
    }

    //item.Val0 = CreateTimeEvent( __FullSecond + time, "e_ProcessPlant", item.Id, true );

    CPlant @ plant = CPlantCreate(item, time);
    if(plant is null) {Log("create plant error");return;}

    garden.insertLast(plant);
}

bool _SkillPlant( Item& item, Critter& cr, int skill )
{
	CPlant @ plant = GetCPlant( item.Id );
	if( plant is null ) return false;

    if( skill == -1 ){

	//if (item.Val1 == plant.SeedCycle){SeedCycle(item, cr); cr.Say( SAY_NETMSG, "Вы собрали семена." ); return true;}
        if (plant.CycleCollectable()){

            cr.StatBase[ST_LAST_CONT_ID] = item.Id;

            ProtoItem @ proto = GetProtoItem(plant.Cycles[plant.SeedCycle].CollectPid);
            uint picInv = (proto is null ? 0 : proto.PicInv);

            cr.ShowScreen (SCREEN_TIMER, picInv, "plant@answer_ShowCounter"); return true;

        }
        //{SeedCycle(item, cr); cr.Say( SAY_NETMSG, "Вы собрали семена." ); return true;}


       /* if( item.Val1 >= plant.MaxCycle - 1){
            if( item.Val6 > 0 ){

                Item@ harvest = cr.AddItem( plant.BasePid + plant.MaxCycle + 1, item.Val6 );
                if(harvest is null) return true;

                harvest.Val2 = item.Val2;

                item.Val6 = 0;
                cr.Say( SAY_NETMSG, "Вы собрали плоды." );
                //return false;


                item.SetEvent( ITEM_EVENT_SKILL, null );
                if( item.Val0 != 0 ){

                    //EraseTimeEvent( item.Val0 );
                    item.Val0 = 0;
                }

                DeleteItem( item );

                return true;
        /*if(CheckGard(map, item.HexX, item.HexY)){

           }*
		}

		cr.Say( SAY_NETMSG, "Еще нечего собирать." );
	}*/

	cr.Say( SAY_NETMSG, "Не время собирать урожай." );

    }else if(skill == SK_SCIENCE){
		if(cr.Skill[SK_OUTDOORSMAN] > 100 || cr.Skill[SK_SCIENCE] > 100 ){

		    CPlantCycle@ currentCycle = plant.Cycles[plant.SeedCycle];

			string msg = ("Информация о растении :\nСтадия роста : "+item.Val1+"\\"+(plant.Cycles.length()-1)+"\nПолив : "+currentCycle.Water+"\\"+item.Val4+"\nУдобрения : "+currentCycle.Shit+"\\"+item.Val5+"\nПлодов : "+item.Val6+"\nСелекция : "+item.Val2+"\nСбор : "+(currentCycle.IsCollectable ? "да" : "нет"));
			cr.Say(SAY_NETMSG, msg);
		}else{
			cr.Say(SAY_NETMSG, "Недостаточный навык науки или скитальца.");
		}
    }
    return true;
}

void answer_ShowCounter(Critter& cr, uint answerI, string& answerS ){

    Item @ item = GetItem(cr.StatBase[ST_LAST_CONT_ID]);
    if(item is null) return;

    CPlant @ plant = GetCPlant( item.Id);
	if( plant is null ) return;

	uint8 harvestCount = CLAMP(answerI, 0, item.Val6);

	Item@ harvest = cr.AddItem( plant.Cycles[plant.SeedCycle].CollectPid, harvestCount);
    if(harvest is null) return;

    harvest.Val2 = item.Val2 + Random(0,1);
}

void _WalkPlant( Item& item, Critter& cr, bool entered, uint8 dir )
{
    if( entered && item.Val1 > 1 )
    {
        if( Random( 1, 95 ) > 5 )
        {
            CPlant @ plant = GetCPlant( item.Id );
            plant.Kill( item );
        }
    }
    // Log("te "+item.Val1);
}

bool _OnMePlant( Item& item, Critter& cr, Item@ usedItem )
{
    if( usedItem is null )
        return true;
    if( item.Val1 == 0 )
        return true;

    uint16 pid = usedItem.GetProtoId();

    if( pid == PID_NUKA_COLA        	||
        pid == PID_BEER             	||
        pid == PID_BOOZE 		||
	pid == PID_BOTTLE_FULL		)
    {

        item.Val4 += 1 * (pid == PID_BOTTLE_FULL ? 3 : 1);

	cr.Say( SAY_NETMSG, "Вы полили растение.");
    }
    else if( pid == PID_SHIT_SMALL )
    {
        item.Val5 += 1;
	cr.Say( SAY_NETMSG, "Вы удобрили растение.");
    }

    return true;
}

CPlant@ GetCPlant(uint id)
{
    for(uint i = 0, j = garden.length(); i < j; ++i){
        if(garden[i].ItemId == id){
            return @garden[i];
        }
    }

    return null;
}

class CRadCvet  : CPlant
{

    CRadCvet(uint itemId, uint time)
    {
        ItemId = itemId;
        //MaxCycle = 4;
        SeedCycle = GetItem(itemId).Val1;
        BasePid = PID_RADCVET;
        PlantType = PLANT_RADCVET;

        Time = time;

        InitCycles();
    }

    void InitCycles(){
        Cycles.insertLast(CPlantCycle(Time, 0, 0, 0, 0, false,  PID_RADCVET));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 0, 0, 0, false,  PID_RADCVET+1));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 0, 0, 0, false,  PID_RADCVET+2));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(1), 0, 1, 2, PID_RADCVET, true,  PID_RADCVET+3));
        Cycles.insertLast(CPlantCycleExplode(GAME_HOUR(1), 0, 0, 0, 0, false,  PID_RADCVET+9));
    }
}

class CCabbage  : CPlant
{
    CCabbage(uint itemId, uint time)
    {
        ItemId = itemId;
        //MaxCycle = 4;
        SeedCycle = GetItem(itemId).Val1;
        BasePid = PID_CABBAGE;
        PlantType = PLANT_CABBAGE;

        Time = time;

        InitCycles();
    }

    void InitCycles(){
        Cycles.insertLast(CPlantCycle(Time, 0, 0, 0, 0, false,  PID_CABBAGE));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(2), 0, 0, 0, 0, false,  PID_CABBAGE+1));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(4), 1, 1, 0, 0, false,  PID_CABBAGE+2));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(3), 1, 1, 2, PID_CABBAGE, true,  PID_CABBAGE+3));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(8), 0, 0, 1, PID_CABBAGE, false,  PID_CABBAGE+9));
    }
}

class CCorn     : CPlant
{
    CCorn(uint itemId, uint time)
    {
        ItemId = itemId;
        //MaxCycle = 5;
        SeedCycle = GetItem(itemId).Val1;
        BasePid = PID_CORN;
        PlantType = PLANT_CORN;

        Time = time;

        InitCycles();
    }

    void InitCycles(){
        Cycles.insertLast(CPlantCycle(Time, 0, 0, 0, 0, false,  PID_CORN));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(4), 0, 0, 0, 0, false,  PID_CORN+1));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(3), 2, 1, 0, 0, false,  PID_CORN+2));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(4), 2, 1, 1, 0, false,  PID_CORN+3));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(2), 2, 1, 2, PID_CORN, true,  PID_CORN+4));
        Cycles.insertLast(CPlantCycle(GAME_HOUR(12), 0, 1, 0, 0, false,  PID_CORN+9));
    }
}

