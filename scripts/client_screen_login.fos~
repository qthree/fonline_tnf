#define LOGIN_INPUTBOX_NAME_INDEX     (0)
#define LOGIN_INPUTBOX_PASS_INDEX     (1)

#define LOGIN_SCREEN_BTN_ENTER          (0)
#define LOGIN_SCREEN_BTN_REG            (1)
#define LOGIN_SCREEN_BTN_EXIT           (2)
#define LOGIN_SCREEN_BTN_REGSHOW        (3)
#define LOGIN_SCREEN_BTN_REMOVE_CHAR    (4)

