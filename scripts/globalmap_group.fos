void DypsneaCr( Map& map, Critter& cr )
{
	if ( map.GetProtoId()== MAP_SUTTER_CENTER_DN && (443 < cr.HexX) && (cr.HexX < 540) && (369 < cr.HexY) && (cr.HexY < 435) ) return;

    if( map.GetData( 25 ) > 0)
    {
        GameVar @ dyspnea = GetLocalVar( LMVAR_Dyspnea, map.Id );
        if( !(dyspnea is null))
        {
            if( cr.GetTimeEvents( CTE_DYSPNEA, null, null, null ) < 1 )
            {
                cr.AddTimeEvent( "cte_Dyspnea", 5 * __TimeMultiplier, CTE_DYSPNEA, 1 );
            }
        }

        cr.Say( SAY_NETMSG, "Вам тяжело дышать." );
    }
    else
    {
        if( cr.GetTimeEvents( CTE_DYSPNEA, null, null, null ) > 0 )
        {
            cr.EraseTimeEvents( CTE_DYSPNEA );
        }
        if( cr.StatBase[ ST_DYSPNEA ] < 100 )
        {
            cr.AddTimeEvent( "cte_Dyspnea", 5 * __TimeMultiplier, CTE_DYSPNEA, 0 );
            cr.Say( SAY_NETMSG, "Здесь дышиться легче." );
        }
    }

}

uint cte_Dyspnea( Critter& cr, int identifier, uint& rate )
{
    Map @ map = cr.GetMap();
    if( !(map is null) )
    {
        if( map.GetData( 25 ) > 0 )
        {
            GameVar @ dyspnea = GetLocalVar( LMVAR_Dyspnea, map.Id );
            if( !(dyspnea is null) )
            {

                Item @ respirator = _CritGetItemHandExt( cr );
                if( !(respirator is null) && respirator.GetProtoId() == PID_RESPIRATOR && respirator.Indicator > 0)
                {
                    uint8 ind = respirator.Indicator;
                    if ( Random(0,15) == 0 )
						{
						ind--;
						ind = CLAMP( ind, 0, 100 );
						respirator.Indicator = ind;
						respirator.Update();
						}
                    cr.StatBase[ ST_DYSPNEA ] --;
                }
                else
                {
                    cr.StatBase[ ST_DYSPNEA ] -= 5;
                }
            }
        }
        else
        {
            cr.StatBase[ ST_DYSPNEA ] += cr.Stat[ ST_ENDURANCE ] * 5;
			if ( cr.StatBase[ ST_DYSPNEA ] >= 100 ) return 0;
        }
    }

    return 5 * __TimeMultiplier;
}

uint8 GetBiomType(uint x, uint y){
	Cell@ cell = world.GetCell(x, y);
