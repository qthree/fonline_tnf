config.fos:	__SkillModAdd4  = 150;
config.fos:	__SkillModAdd5  = 175;
config.fos:	__SkillModAdd6  = 200;
}
*/
void FormatText(string text0, string text1, IGUIElementOpt& opt, uint font, uint flags, int& rW, int& rH)
{
	int tw0 = 0, tw1 = 0, th0 = 0, th1 = 0, lines = 0;
	uint16 w = opt.GetSurfaceWidth(), h = opt.GetSurfaceHeight();
	GetTextInfo(text0, w, h, font, flags, tw0, th0, lines);
	GetTextInfo(text1, w, h, font, flags, tw1, th1, lines);
	rW = w - (tw0 + tw1);
	rH = tw0;//h - (th0 + th1);
	//Message(" "+w+" "+rW+" "+tw0+" "+tw1);
	return;
}

