    for(uint8 i = 0; i < CHARLIST_LENGTH; ++i){

            CLoginScreenCharListElement LoginCharListElement(LoginScreen, i);
            GUI_AddScreenElement( CLIENT_SCREEN_LOGIN_TNF, "loginscreen_input_up.png", 120, 60+offsetY )
                    .CallbackMouseClick(LoginCharListElement )
                    .CallbackInit(LoginCharListElement)
                    .DownPic( "loginscreen_input_dn.png" );

            offsetY += 16;
    }


    CLoginScreenButton LoginScreenEnter(LoginScreen, LOGIN_SCREEN_BTN_ENTER);
    GUI_AddScreenElement( CLIENT_SCREEN_LOGIN_TNF, "bigredup.frm", 120, 160 )
