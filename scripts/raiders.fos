void sendAttack(Critter& player, int param0, int param1, int param2)
{
	
	//Log("sendAttack init, player map = " +player.GetMapProtoId());
	uint toMap = 18;
	int mobGroup = param1, mobLevel = param2;
	Map@ map = GetMapByPid(toMap, 0);
	//Log("Map+");
	spawnMobs(map, param0);
	//Log("SpawnMob+");
	sendWave(map);		
}

