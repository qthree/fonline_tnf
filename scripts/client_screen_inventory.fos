ScreenInventory screenInventory();
uint16[] skillArrayValue(SKILL_END - SKILL_BEGIN + 1);
uint16	SpCount;
uint8   lastSkillId = 0;

void DropSkillArrayAddVal()
{
	for(uint16 i = 0, j = skillArrayValue.length(); i < j; ++i)
	{
		skillArrayValue[i] = 0;
		//Message("skill "+i+" removed");
	}
}

void RemoveSkillChange()
{
	if(!tabClick && isChangedSkills)
	{
		DropSkillArrayAddVal();
		isChangedSkills = false;
		Message("skiill removed");
	}
	tabClick = false;
	Message("exit");
}

