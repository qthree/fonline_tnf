// Original Fallout2 system
#include "_macros.fos"
#include "_msgstr.fos"

#include "_global_events.fos"

import void AffectRadiation( Critter& cr, int value ) from "radiation";
import void AffectPoison( Critter& cr, int value ) from "poison";
import bool ItemStimpackUse( Critter& cr, Item& item ) from "heal"; // pm add

// Chem Reliant
// benefit: Faster recovery from chem side effects
// penalty: Doubles chance for addiction
// Chem Resistant
// benefit: 50% less addiction chance
// penalty: 50% less duration for Chem effects
#define DRUG_EFFECT_DIV2_WITHDRAWAL    ( 1 )
#define DRUG_EFFECT_MUL2_ADDICTION     ( 2 )
#define DRUG_EFFECT_DIV2_ADDICTION     ( 4 )
#define DRUG_EFFECT_DIV2_DURATION      ( 8 )
#define RATE_TO_STAGE                  # (rate)          ( ( rate ) & 0xFFFFFF )
#define RATE_TO_FLAGS                  # (rate)          ( ( rate ) >> 24 )
#define FORM_RATE                      # ( stage, flags )( ( ( ( flags ) & 0xFF ) << 24 ) | ( ( stage ) & 0xFFFFFF ) )

#define STAGE_INSTANT_EFFECT		(0)
#define STAGE_WITHDRAWAL		(1)
#define STAGE_NORMALIZE		(2)
#define STAGE_ADDICTION_BEGIN		(3)
#define STAGE_ADDICTION_END		(4)
#define STAGE_CUSTOM			(5)

#define EFFECT_STIMPACK		(0)
#define EFFECT_RADAWAY			(1)
#define EFFECT_ANDTIDOTE		(2)
#define EFFECT_MENTANTS		(3)
#define EFFECT_FRUID			(4)
#define EFFECT_IGUANA			(5)
#define EFFECT_BUFFOUT			(6)
#define EFFECT_MEAT			(7)
#define EFFECT_NUKACOLA		(9)
#define EFFECT_RADX			(10)
#define EFFECT_PSYCHO			(11)
#define EFFECT_BEER			(12)
#define EFFECT_BOOZE			(13)
#define EFFECT_STIMPACK_SUPER		(14)
#define EFFECT_JET			(15)
#define EFFECT_JET_ANDTIDOTE		(16)
#define EFFECT_HEALING_POWDER		(17)
#define EFFECT_GAMMA_BEER		(18)
#define EFFECT_ROENTGEN_RUM		(19)
#define EFFECT_HYPO_POISON		(20)
#define EFFECT_COOKIE			(21)
#define EFFECT_MONUMENT_CHUNCK		(22)
#define EFFECT_ROT_GUT			(23)
#define EFFECT_MUTATED_TOE		(24)
#define EFFECT_KITTY_AGILITY		(25)
#define EFFECT_KITTY_INTELLIGENCE	(26)
#define EFFECT_KITTY_STRENGH		(27)
#define EFFECT_HYPO			(29)

#define EFFECT_MAX			(30)

EffectManager effectManager;

class EffectManager : iManagerModule, iManager_loop
{
    EffectManager()
    {

        AddStartCallback( "drugs", "start" );
    }

    bool manager_init()
    {
		InitEffects();
		Log( "Effects load, "+effects.length() );
		return true;
    }
    
    uint global_loop(){
		return uint( -1 );
	 }

}



void start()
{
    iManagerModule@  module = effectManager;
    iManagerElement@ manager = manager_add_module( module, "Effect", 120 );
    if( manager is null )
        return;

}

Effect[]	effects;
//29
void InitEffects(){
  
	EffectStage[] tempStage;
	
	tempStage.resize(0);
  
	effects.resize(EFFECT_MAX);
	
	//stimpack
			    //duration 		type
	tempStage.insertLast(EffectStage(0, STAGE_INSTANT_EFFECT));
				      //stat		amount
	tempStage.last().InsertStat(ST_CURRENT_HP, 0);
	
	tempStage.insertLast(EffectStage(0, STAGE_WITHDRAWAL));
	tempStage.last().InsertStat(0, 0);
	
	tempStage.insertLast(EffectStage(0, STAGE_NORMALIZE));
	tempStage.last().InsertStat(0, 0);
	
	tempStage.insertLast(EffectStage(0, STAGE_ADDICTION_BEGIN));
	tempStage.last().InsertStat(0, 0);
	
	tempStage.insertLast(EffectStage(0, STAGE_ADDICTION_END));
	tempStage.last().InsertStat(0, 0);
				//addict id	percent		stages
	effects[EFFECT_STIMPACK] = Effect(0, 0, tempStage);
	
	//radway
	
	tempStage.resize(0);
	
	tempStage.insertLast(EffectStage(120, STAGE_INSTANT_EFFECT));
	tempStage.last().InsertStat(ST_RADIATION_LEVEL, -25);
	tempStage.last().InsertStat(ST_RADIATION_RESISTANCE, 0);
	
	tempStage.insertLast(EffectStage(120, STAGE_WITHDRAWAL));
	tempStage.last().InsertStat(ST_RADIATION_LEVEL, -50);
	tempStage.last().InsertStat(ST_RADIATION_RESISTANCE, 0);
	
	tempStage.insertLast(EffectStage(14160, STAGE_NORMALIZE));
	tempStage.last().InsertStat(ST_RADIATION_LEVEL, -75);
	tempStage.last().InsertStat(ST_RADIATION_RESISTANCE, 0);
	
	tempStage.insertLast(EffectStage(10080, STAGE_ADDICTION_BEGIN));
	tempStage.last().InsertStat(ST_RADIATION_LEVEL, 0);
	tempStage.last().InsertStat(ST_RADIATION_RESISTANCE, -20);
	
	tempStage.insertLast(EffectStage(0, STAGE_ADDICTION_END));
	tempStage.last().InsertStat(ST_RADIATION_LEVEL, 0);
	tempStage.last().InsertStat(ST_RADIATION_RESISTANCE, 20);
	
	effects[EFFECT_RADAWAY] = Effect(ADDICTION_RADAWAY, 10, tempStage);
	
