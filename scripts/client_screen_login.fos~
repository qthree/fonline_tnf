class CLoginScreenCharListElement : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        uint8           Index;

        IGUIElementOpt@ Options;
        CLoginScreen@   Instance;

        CLoginScreenCharListElement(CLoginScreen& instance, uint8 index){
                @Instance = instance;

                Index = index;

                //@Instance.CharList.Elements[Index] = this;
                @Instance.Elements[Index] = this;
        }

        void OnMouseClick(int click){
                if(Index < ureal.length()){

                        string name = ureal[Index], pass = upass[Index], rname = uname[Index];
                        int status = 0;

                        //StrToInt(ustat[Index], status);

                        /*if(name[name.length()-1] == '\n'){        //deprecated
                            name.resize(name.length()-1);
                            Message("delete \n");
                        }*/
#ifdef __DEBUG
                        Message("index "+name+" "+pass);
#endif //__DEBUG
                        Instance.UserDataSet(name, pass);
                        Instance.CharInfo.SetCharName(rname);
                        //Instance.CharInfo.SetCharState(status);

                        //__nameView = rname;
			//__Name = rname;
			
			//Message("__ " +__Name+" "+__nameView);
                        //__Password = pass;
                }
        }

        void OnInit(){
                @Options = GUI_GetElementOptions();

                //names = uname;
                //pass = upass;

                if(uname.length() != upass.length() || upass.length() != ureal.length() || uname.length() != ureal.length()) {Message("array length error"); return;}

                if(Index < uname.length() && uname[Index] != ""){
                        //Text(uname[Index]);
                        //Message(ureal[Index]);
                }
        }

        void OnDraw(){
            if(Index < uname.length() && uname[Index] != ""){
                        DrawText( uname[Index], Options.GetPosX()+290, Options.GetPosY()+247, 200, 200, COLOR_RED, FONT_FALLOUT, 0 );
                }

        }

        void SetElement(uint8 index){
            Index = index;
        }


        void Text(string text){
                Options.Text(""+text, FONT_FALLOUT, COLOR_LRED, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );

        }


}

