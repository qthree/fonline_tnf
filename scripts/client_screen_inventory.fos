void RefreshItemList() //export
{
	//screenInventory.ItemList.RemoveSelectedItemFromList();
	//screenInventory.ItemList.FullRefrash();
	screenInventory.ItemList.UpdateList();
	//SoftRefresh();
}

void FullRefreshItemList() //export
{
	screenInventory.ItemList.FullRefrash();
}

void ItemKeysCall(uint8 type)
{
	screenInventory.ItemActions[type].OnMouseClick(MOUSE_CLICK_LEFT);
}

void InventoryKeyboardControl(uint8 key)
{
	uint16 prevIndex = screenInventory.ItemList.prevIndex;
	switch(key)
	{
		case DIK_DOWN : screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_DOWN].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_UP   : screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_UP].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_LEFT : screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_LEFT].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_RIGHT: screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_RIGHT].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_END  :	screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_DOWN_FORCED].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_HOME : screenInventory.ItemSlide[INVENTORY_ITEMS_LIST_UP_FORCED].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_A    : screenInventory.ItemActions[INVENTORY_ITEM_WEAR_ARMOR].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_L    : screenInventory.ItemActions[INVENTORY_ITEM_WEAR_HAND1].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_R    : screenInventory.ItemActions[INVENTORY_ITEM_WEAR_HAND2].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_I    : screenInventory.ItemActions[INVENTORY_ITEM_WEAR_DOWN].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_D    : screenInventory.ItemActions[INVENTORY_ITEM_DROP].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_G    : screenInventory.ItemActions[INVENTORY_ITEM_UNLOAD].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_U    : screenInventory.ItemActions[INVENTORY_ITEM_USE].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_S    : screenInventory.ItemActions[INVENTORY_ITEM_SKILL].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_T    : screenInventory.ItemSorts[INVENTORY_SORT_COUNT].OnMouseClick(MOUSE_CLICK_LEFT); break;
		case DIK_Y    : screenInventory.ItemSorts[INVENTORY_SORT_ABC].OnMouseClick(MOUSE_CLICK_LEFT); break;
		default	      : break;
	}
}