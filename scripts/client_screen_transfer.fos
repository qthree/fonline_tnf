ScreenTransfer  screenTransfer();

void InitTransferTnfScreen()
{



	GUI_CreateScreen(CLIENT_SCREEN_TRANSFER_TNF,"transferScreen.png")
		.CallbackShow(screenTransfer)
		.CallbackHide(screenTransfer)
		.CanMove(true)
		//.Position(155,111)
		.Modal(false)
		.Multiinstance(true)
		.AutoCursor(true,CURSOR_DEFAULT);

	//screenTransfer.InventoryButtons.resize(INVENTORY_ITEMS_LIST_COUNT);


    for(uint8 i = 0; i<2; ++i){

        InvItemList itemList(screenTransfer, i);
        GUI_AddScreenElement(CLIENT_SCREEN_TRANSFER_TNF, "invItemList.png", (i > 0 ? 340 : -160), 30)
            .CallbackInit(itemList)
            .SetVisible(false);

        InventoryButtonMoveItem btnMove(screenTransfer, i);
        GUI_AddScreenElement(CLIENT_SCREEN_TRANSFER_TNF, (i > 0 ? "invArrowLeftUp.png" : "invArrowRightUp.png"), 376,  i > 0 ? 130 : 330)
            .CallbackInit(btnMove)
            .CallbackMouseClick(btnMove)
            .DownPic((i > 0 ? "invArrowLeftDn.png" : "invArrowRightDn.png"));

        uint16 y = 25;
        for(uint8 ii = 0; ii < INVENTORY_ITEMS_LIST_COUNT; ++ii)
        {
            InventoryItemButton TempInvButt(screenTransfer, ii, i);
            GUI_AddScreenElement(CLIENT_SCREEN_TRANSFER_TNF, "invItemUp.png", (i > 0 ? 442 : 37), y)
                .CallbackInit(TempInvButt)
                .CallbackMouseClick(TempInvButt)
                .CallbackDraw(TempInvButt);
                //.DownPic("invItemDown.png");

            y += 20;
        }
            //.CallbackMouseClick()
            //.DownPic("invItemDown.png");

            //y = 0;
    }

