/** атаковать игрока
 Использовать этот тригер для охраны серьезных обьектов не рекомендуеться.
 param=1
*/
int Attack(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Map@ map=player.GetMap();
	uint count=map.GetNpcCount(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC);
	for(uint i=0; i<count; i++)
		AddAttackPlane(map.GetNpc(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC, i),
			AI_PLANE_ATTACK_PRIORITY_MARK, player);
	return 0;
}

/**
 атаковать игрока
 Использовать этот тригер для охраны серьезных обьектов не рекомендуеться.
 param=1
*/
int Attack2(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Critter@[] critters;
	uint count = player.GetCritters(true, FIND_LIFE|FIND_ONLY_NPC, critters);// поиск всех живых НПС которые видят игрока
	for(uint i=0; i<count; i++)
		if(critters[i].StatBase[ST_NPC_ROLE]==v0)
		{
			AddAttackPlane(critters[i], AI_PLANE_ATTACK_PRIORITY_MARK, player);
			//critters[i].AddEnemyInStack(player.Id);
		}
	return 0;
}

/**
 охрана останавливает атаку
 BUG!!! - часто не срабатывает.
 param=1
*/
int AttackStop2(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Critter@[] critters;
	uint count = player.GetCritters(true, FIND_LIFE|FIND_ONLY_NPC, critters);// поиск всех живых НПС которые видят игрока
	for(uint i=0; i<count; i++)
		if(critters[i].StatBase[ST_NPC_ROLE]==v0)
		{
			NpcPlane@[] planes;
			uint count = critters[i].GetPlanes(planes);
			for(uint j=0; j<count; j++)
				if(planes[j].Attack_TargId==player.Id and planes[j].Priority==AI_PLANE_ATTACK_PRIORITY_MARK)
					if(critters[i].ErasePlane(j))
						critters[i].EraseEnemyFromStack(player.Id);
		}
	return 0;
}

/**
 охрана останавливает атаку
 param=1
*/
int AttackStop(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Map@ map=player.GetMap();
	uint count=map.GetNpcCount(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC);
	NpcPlane@[] planes;
	for(uint i=0; i<count; i++)
	{
		Critter@ npc=map.GetNpc(v0, FIND_LIFE_AND_KO|FIND_ONLY_NPC, i);
		planes.resize(0);
		uint count = npc.GetPlanes(planes);
		// проходимся по списку планов в поисках маркированного плана
		for(uint j=0; j<count; j++)
			if((planes[j].Attack_TargId==player.Id) and
				(planes[j].Priority==AI_PLANE_ATTACK_PRIORITY_MARK))
				if(npc.ErasePlane(j))
					npc.EraseEnemyFromStack(player.Id);
	}
	return 0;
}

/**
 форсированная атака
 этот тип атаки не отменяется
 param=1
*/
int AttackForced2(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	Critter@[] critters;
	uint count = player.GetCritters(true, FIND_LIFE|FIND_ONLY_NPC, critters);// поиск всех живых НПС которые видят игрока
	for(uint i=0; i<count; i++)
		if(critters[i].StatBase[ST_NPC_ROLE]==v0)
		{
			AddAttackPlane(critters[i], AI_PLANE_ATTACK_PRIORITY, player);
			critters[i].AddEnemyInStack(player.Id);
		}
	return 0;
}

