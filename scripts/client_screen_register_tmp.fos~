///////

uint GetIndex(){
  return (inputBoxs[INPUT_NAME].Active ? INPUT_NAME : INPUT_PASS);
}

void LoginSetText(uint8 key, uint8 letter){               //export to cient_gui.fos -> screen_key_press

	//Message("in "+inputBoxs.length());

        uint8 index = GetIndex();
	//inputBoxs[index].OnKeyPress(key, letter);
        /*if(key != DIK_BACK){
            inputBoxs[index].TextAdd(letter);
        }else{
            inputBoxs[index].TextRm();
        }*/
        uint8 testLetter = 0;
        string text = inputBoxs[index].GetText();
	
	if(text == DEFAULT_LOGIN || text == DEFAULT_PASSWORD || inputBoxs[INPUT_PASS].GetPass() == DEFAULT_PASSWORD){text = ""; inputBoxs[INPUT_PASS].SetPass("");}
	
	if(index == INPUT_PASS){
		string pass = inputBoxs[index].GetPass();
		ProcessKey(key, pass, testLetter);
		inputBoxs[index].SetPass(pass);
	}
	
        ProcessKey(key, text, testLetter);
        inputBoxs[index].SetText(text);
        //inputBoxs[index].KeyPress(key);
}

void LoginTabPress(){

	//uint8 index = GetIndex();

        inputBoxs[INPUT_NAME].SwitchState();
	inputBoxs[INPUT_PASS].SwitchState();
}

