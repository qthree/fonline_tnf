    {

    }

    void OnMove( int posX, int posY )
    {

    }
    
    void ParamInsertFromCritter(CritterCl@ cr){
      
	if(cr is null) return;
      
	for(uint i = 0; i < 1000; ++i){
		Param[i] = cr.ParamBase[i];
		if(i < 100){
			Message("i "+Param[i]+" "+cr.ParamBase[i]);
		}
	}
    }
/*
    void AdnvStatBonus(){
        if(Param[QST_GAMEMODE] == GAME_ADVENTURE){
            for(uint16 i = SKILL_BEGIN; i < SKILL_END; ++i){
                Param[i]+=STAT_ADVN_SKILL_BONUS;
            }

            Param[ST_MAX_LIFE] += STAT_ADVN_HEALTH_BONUS;
        }
    }
    


    void ParamUpdate(){
            //CritterGenerate(Param);
            //AdnvStatBonus();
    }

    void GetParam(){
            CritterGenerate(Param);
    }

    void SetRegStat(uint8 index){
            StatChg[index].ChangeValue();
    }

    void ChangeParamInc(uint16 index){
            if(index < Param.length()){
                    Param[index]++;
            }
    }

    void ChangeParamDec(uint16 index){
            if(index < Param.length()){
                    //Message("param inc");
                    Param[index]--;
            }
    }

    void SetParam(uint16 index, int val){
            if(index < Param.length()){
                    Param[index] = val;
            }
    }

    bool CheckStatUnxp(){
            return (UnxpStat > 0);
    }


    void ParamDrop(){
        Param.resize(1000);

        for(uint16 i = 0, j = Param.length(); i < j; ++i){
            //if(i == QST_GAMEMODE) continue;         //only gamemode skip
            if(i >= ST_STRENGTH_EXT && i <= ST_LUCK_EXT){Message("ext "+i+" "+Param[i]);}
            Param[i] = 0;
        }

        for(uint8 i = 0; i < 8; ++i){
            Param[i] = 5;
        }

        ParamUpdate();

        //CritterGenerate(Param);

        UnxpStat = 5;
        Param[ST_AGE] = Random(AGE_HUMAN_MIN+1, AGE_HUMAN_MAX-1);
        Param[QST_GAMEMODE] = GAME_SURVIVAL;
    }

    void ParamDropSoft(){
        for(uint16 i = 7, j = Param.length(); i < j; ++i){

                if(i >= TAG_SKILL1 && i < TAG_SKILL4) continue;
                if(i >= TRAIT_BEGIN && i < TRAIT_END) continue;
		if(i >= PERK_BEGIN && i < PERK_END) continue;
                if(i == ST_GENDER || i == ST_AGE || i == QST_GAMEMODE || i == ST_BODY_TYPE || i == ST_BASE_CRTYPE) continue;
		

                Param[i] = 0;
        }

        ParamUpdate();
    }

    void ParamDropChageGamemode(){
        for(uint8 i = 0; i < 7; ++i){
            Param[i] = 5;
        }

        UnxpStat = 5;

        TagClear();
        TraitClear();
        PerkClear();

        GenderSelectBtn.DropBtn();
        DropSelectSkin();

        ShowArchive(0);

