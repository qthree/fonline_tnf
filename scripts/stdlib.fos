	if(not valid(map)) {Log("Map not found"); return 0;}
	FlushScreen(player, true, 3000);
	player.TransitToMap(map.Id, 0);
	return 0;
}


int TransitToMap2(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
