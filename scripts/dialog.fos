// Results /////
////////////////

// Убить НПК.
// v0 - тип смерти. Смотрите Critter conditions - COND_DEAD в _defines.fos
// v1 - убийца игрок или нет. 1 - игрок, 0 - нет.
void r_NpcToDead(Critter& master, Critter@ slave, int v0, int v1)
{
	if(not valid(slave)) return;
	if(slave.IsNpc())
	{
		if(v1 == 0) slave.ToDead(v0, null);
		else slave.ToDead(v0, master);
	}
	else
	{
		if(v1 == 0) master.ToDead(v0, null);
		else master.ToDead(v0, slave);
	}
}

// Убить НПК. Обычная смерть.
void r_NpcToDead(Critter& master, Critter@ slave)
{
	r_NpcToDead(master, slave, COND_DEAD_FRONT, 0);
}
