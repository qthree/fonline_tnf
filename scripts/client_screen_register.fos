        Gender = 0;
        State = Gender;
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();

        PicOff.insertLast("maleoff.frm");
        PicOn.insertLast("maleon.frm");

        PicOff.insertLast("femoff.frm");
        PicOn.insertLast("femon.frm");

