		else tc=48+((i*id*len)%10);
		chr_code[i]=tc;
	}
}

void activation_get_code(Critter& player, string& code)
{
	uint id = player.Id;

	string@ login = GetPlayerName(id);

	activation_generate_code(id, login, code);
}

void activation_get_code(Critter& player, uint id, string& code)
{

	string@ login = GetPlayerName(player.Id);

	activation_generate_code(id, login, code);
}

// =================================================
//			Раздел для новой структуры функций активации
// =================================================


bool transit_start(Critter& cr)
{
	uint locid = CreateLocation(50,cr.WorldX,cr.WorldY,null); 
	Location@ loc=GetLocation(locid);

	if(not valid(loc)) {Log("can't create start loc"); return false;}

	Map@ map = loc.GetMapByIndex(0);

	if(not valid(map)) return false;

	cr.TransitToMap(map.Id,0);

	return true;
}

bool transit_dead(Critter& cr)
{
	if(__Zombies && cr.Param[ST_BODY_TYPE]==BT_ZOMBIE) return false;
	
	Location@ loc = GetLocationByPid(6,0);

	if(loc is null)
	{
		uint locid = CreateLocation(6,cr.WorldX,cr.WorldY,null); 
		@loc=GetLocation(locid);
		
		if(not valid(loc)) {Log("can't create dead loc"); return false;}
	}

	Map@ map = loc.GetMapByIndex(0);

	if(not valid(map)) return false;

	cr.TransitToMap(map.Id,241);

	return true;
}



bool transit_modoc(Critter& player)
{
	//if(player.CountItem(905)==0) player.AddItem(905,1);

	Map@ modoc = GetMapByPid  ( /*MAP_Modoc*/ 51, 0);
	if(valid(modoc) && player.TransitToMap(modoc.Id,0))
	{
		uint zoneX=player.WorldX/__GlobalMapZoneLength;
		uint zoneY=player.WorldY/__GlobalMapZoneLength;
		player.SetFog(zoneX  ,zoneY  ,FOG_NONE);
		player.SetFog(zoneX-1,zoneY-1,FOG_HALF);
		player.SetFog(zoneX  ,zoneY-1,FOG_HALF);
		player.SetFog(zoneX+1,zoneY-1,FOG_HALF);
		player.SetFog(zoneX-1,zoneY  ,FOG_HALF);
		player.SetFog(zoneX+1,zoneY  ,FOG_HALF);
		player.SetFog(zoneX-1,zoneY+1,FOG_HALF);
		player.SetFog(zoneX  ,zoneY+1,FOG_HALF);
		player.SetFog(zoneX+1,zoneY+1,FOG_HALF);
		player.SetKnownLoc(false,LOCATION_Modoc);
		return true;
	}
	
	Log("Activation: final transit panic! PlayerId: "+player.Id);
	return false;
}

bool start_items(Critter& cr)
{
	Item@[] items;
	cr.GetItems(-1, items);

	for(uint i=0; i<items.length(); i++)
	{
		Item@ item = items[i];
		if(!valid(item)) continue;
		if(item.GetProtoId()==PID_ACTIVATOR) DeleteItem(item);		
	}
	
//	if(cr.CountItem(PID_ACTIVATOR)==0)
//	{


	Item@ hand_item = _CritGetItemHand(cr);
	if(valid(hand_item)) _CritMoveItem(cr,hand_item,SLOT_INV);

	Item@ doc = cr.AddItem(PID_ACTIVATOR,1);
	if(valid(doc)) cr.MoveItem(doc.Id,1,SLOT_HAND1);
	
	return true;


/*
	}
	else	
	{
		Item@ hand_item = _CritGetItemHand(cr);
		if(valid(hand_item))
		{
			if(hand_item.GetProtoId()==906) return true;
			_CritMoveItem(cr,hand_item,SLOT_INV);
		}
		Item@ doc = cr.GetItem (PID_ACTIVATOR, -1);

		if(valid(doc))
		{
			cr.MoveItem(doc.Id,1,SLOT_HAND1);
			return true;
		}
	}
*/
//	return false;
}

bool player_items(Critter& cr)
{
	Item@[] items;
	cr.GetItems(-1, items);

	for(uint i=0; i<items.length(); i++)
	{
		Item@ item = items[i];
		if(!valid(item)) continue;
		if(item.GetProtoId()==PID_ACTIVATOR) DeleteItem(item);
		else if(item.GetProtoId()==PID_SKIN_CHANGER) DeleteItem(item);				
	}

	cr.AddItem(PID_SKIN_CHANGER,1);
	return true;
}

bool setActivation(uint playerId, int toAct, Critter@ initiator, Item@ doc, bool force)
{
	Critter@ cr;
	if(playerId==0)
	{
		if(valid(initiator)) initiator.Say(SAY_NETMSG, "Ошибка активации: playerId==0");
		return false;
	}
	else
	{
		@cr = GetCritter(playerId);
	}

	if(!valid(cr))
	{
		if(valid(initiator)) initiator.Say(SAY_NETMSG, "Ошибка активации: персонажа #"+playerId+" не существует.");
		return false;
	}
	
	GameVar@ gvAct = GetLocalVar(LVAR_activationStatus, cr.Id);
	
	if(!valid(gvAct))
	{
		if(valid(initiator)) initiator.Say(SAY_NETMSG, "Ошибка активации: что то не так с LVAR.");
		return false;
	}

	int act = gvAct.GetValue();

	if(!force && (act<0 || act>ACT_DEAD))
	{
		if(valid(initiator)) initiator.Say(SAY_NETMSG, "Ошибка активации: неправильный act: "+act);
		return false;

	}

	if(toAct<0 || toAct>ACT_DEAD)
	{
		if(valid(initiator)) initiator.Say(SAY_NETMSG, "Ошибка активации: неправильный toAct: "+toAct);
		return false;

	}

	Map@ curMap = cr.GetMap();
	uint curMapPid = 0;
	if(valid(curMap)) curMapPid = curMap.GetProtoId();

	if(act>=ACT_BLOCK && toAct==ACT_DEACT && !force) toAct = act; 

	switch(toAct)
	{
	case ACT_DEACT:
		{
			//if(act==ACT_DEACT && curMapPid==70 && !force)
			if(act==ACT_DEACT && !force)
			{
				if(valid(initiator)) initiator.Say(SAY_NETMSG, "Персонаж #"+playerId+" уже был деактивирован.");
				return false; 
			}
			
			//if(!transit_start(cr)) return false;

			if(!transit_modoc(cr)) return false;
	
			 //start_items(cr);

			gvAct=ACT_DEACT; 
		}
		break;
	case ACT_CODE:
	case ACT_GM:
		{
			if(act>=ACT_BLOCK && !force)
			{
				if(valid(initiator)) initiator.Say(SAY_NETMSG, "Персонаж #"+playerId+" заблокирован.");
				else cr.Say(SAY_NETMSG, "Ваш персонаж заблокирован.");

				return false;
			}

			if((act==ACT_CODE || act==ACT_GM) && !force && curMapPid!=50)
			{
				if(valid(initiator)) initiator.Say(SAY_NETMSG, "Персонаж #"+playerId+" уже был активирован.");
				else cr.Say(SAY_NETMSG, "Ваш персонаж уже активирован.");

				return false;
			}

			//if(!transit_modoc(cr)) return false;

			//player_items(cr); 

			gvAct=toAct;
		}
		break;
	case ACT_BLOCK:
		{
			if(act>=ACT_BLOCK && !force && curMapPid==50)
			{
				if(valid(initiator)) initiator.Say(SAY_NETMSG, "Персонаж #"+playerId+" был заблокирован.");
				
				return false;
			}

			if(!transit_start(cr)) return false;

			gvAct=ACT_BLOCK;			
		}
		break;
	case ACT_DEAD:
		{
			GameVar@ former = GetLocalVar(LVAR_former_act, cr.Id);
			former=gvAct;
			if(act>=ACT_DEAD && !force && curMapPid==70)
			{
				if(valid(initiator)) initiator.Say(SAY_NETMSG, "Персонаж #"+playerId+" отправлен в мертвяк.");
				
				return false;
			}

			if(!transit_dead(cr)) return false;

			gvAct=ACT_DEAD;	
		}
		break;
	default:
		{
			return false;
		}
	}

	act = gvAct.GetValue();

	if(valid(initiator))
	{
		string status;

		switch(act)
		{
		case ACT_DEACT:	status = " деактивирован."; break;
		case ACT_CODE:	status = " активирован кодом."; break;
		case ACT_GM:		status = " активирован командой."; break;
		case ACT_BLOCK:	status = " заблокирован."; break;
		case ACT_DEAD: status = " отправлен в мертвяк."; break;
		}

		initiator.Say(SAY_NETMSG, "Персонаж #"+cr.Id+status);
	}
/*	
	if(valid(doc))
	{
		
	}
*/
	return true;
}


void SetStartLocation(Critter& cr)	 // Export
{
	uint zoneX=cr.WorldX/__GlobalMapZoneLength;
	uint zoneY=cr.WorldY/__GlobalMapZoneLength;
	cr.SetFog(zoneX  ,zoneY  ,FOG_FULL);
	cr.SetFog(zoneX-1,zoneY-1,FOG_FULL);
	cr.SetFog(zoneX  ,zoneY-1,FOG_FULL);
	cr.SetFog(zoneX+1,zoneY-1,FOG_FULL);
	cr.SetFog(zoneX-1,zoneY  ,FOG_FULL);
	cr.SetFog(zoneX+1,zoneY  ,FOG_FULL);
	cr.SetFog(zoneX-1,zoneY+1,FOG_FULL);
	cr.SetFog(zoneX  ,zoneY+1,FOG_FULL);
	cr.SetFog(zoneX+1,zoneY+1,FOG_FULL);
	
	setActivation(cr.Id, ACT_DEACT, null, null, true);
}

bool deact(Critter& cr)		// Export
{
	return setActivation(cr.Id, ACT_DEACT, null, null, false);
}

bool dead(Critter& cr)		// Export
{
	return setActivation(cr.Id, ACT_DEAD, null, null, false);
}

// =================================================
//			Раздел для функций работы с переменной (старое)
// =================================================

int act_var_get(Critter& player)
{
	GameVar@ act = GetLocalVar(LVAR_activationStatus, player.Id);
	if(!valid(act)) return -1;
	else return(act.GetValue());
}

bool act_check_dead(Critter& player)	// Export
{
	int var = act_var_get(player);
	return (var==ACT_DEAD);
}

bool act_var_check(Critter& player)	// Export
{
	int var = act_var_get(player);
	return (var>=0 && var<3);
}


void act_var_set(Critter& player, int var)
{
	GameVar@ act = GetLocalVar(LVAR_activationStatus, player.Id);
	GameVar@ former = GetLocalVar(LVAR_former_act, player.Id);
	if(!valid(act)) return;
	if(var==ACT_DEAD) former=act;
	act=var;
}

void act_var_set(Critter& player, bool val)
{
	GameVar@ act = GetLocalVar(LVAR_activationStatus, player.Id);
	if(!valid(act)) return;

	act=(val?1:0);
}

