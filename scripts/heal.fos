                    }                                                                                              // cr.Say(SAY_NETMSG,"booze");
                    else if( !isHaveItem[ 1 ] )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                }
                else if( drugProtoId == PID_MEDCLIP )                           // high multytool
                {
                    if( FLAG( flag, HEAL_MULTYTOOL ) )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }
                    else if( !isHaveItem[ 1 ] )
                    {
                        drugIndexs[ 1 ] = i;
                        isHaveItem[ 1 ] = true;
                    }                                                                   // cr.Say(SAY_NETMSG,"booze");
                }

                else if( drugProtoId == PID_PLANK )                                     // low splint
                {
                    if( !FLAG( flag, HEAL_SPLINT ) )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                    else if( !isHaveItem[ 2 ] )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }                                                           // cr.Say(SAY_NETMSG,"booze");
                }
                else if( drugProtoId == PID_MEDSPLINT )                         // high splint
                {
                    if( FLAG( flag, HEAL_SPLINT ) )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }
                    else if( !isHaveItem[ 2 ] )
                    {
                        drugIndexs[ 2 ] = i;
                        isHaveItem[ 2 ] = true;
                    }                                                                   // cr.Say(SAY_NETMSG,"booze");
                }

                else if( drugProtoId == PID_STRING )                                    // low thread
                {
                    if( !FLAG( flag, HEAL_THREAD ) )
                    {
                        drugIndexs[ 3 ] = i;
                        isHaveItem[ 3 ] = true;
                    }
                    else if( !isHaveItem[ 3 ] )
                    {
                        drugIndexs[ 3 ] = i;
                        isHaveItem[ 3 ] = true;
                    }                                                           // cr.Say(SAY_NETMSG,"booze");
                }
                else if( drugProtoId == PID_MEDTHREAD )                         // high thread
                {
                    if( FLAG( flag, HEAL_THREAD ) )
                    {
                        drugIndexs[ 3 ] = i;
                        isHaveItem[ 3 ] = true;
                    }
                    else if( !isHaveItem[ 3 ] )
                    {
                        drugIndexs[ 3 ] = i;
                        isHaveItem[ 3 ] = true;
                    }                                                                                      // cr.Say(SAY_NETMSG,"booze");
                }

                /*else if(drugProtoId == PID_BOOZE)		//high anestetic
                   {
                        if(!FLAG(flag, HEAL_ANESTETIC)) {drugIndexs[4] = i; isHaveItem[4] = true;}
                        else if(!isHaveItem[4]) {drugIndexs[4] = i; isHaveItem[4] = true;} //cr.Say(SAY_NETMSG,"booze");
                   }*/
                else if( drugProtoId == PID_ANESTETIC )                         // high anestetic
                {
                    if( FLAG( flag, HEAL_ANESTETIC ) )
                    {
                        drugIndexs[ 4 ] = i;
                        isHaveItem[ 4 ] = true;
                    }
                    else if( !isHaveItem[ 4 ] )
                    {
                        drugIndexs[ 4 ] = i;
                        isHaveItem[ 4 ] = true;
                    }                                                            // cr.Say(SAY_NETMSG,"booze");
                }

                else if( drugProtoId == PID_MEDNEEDLE )                          // needle
                {
                    drugIndexs[ 5 ] = i;
                    isHaveItem[ 5 ] = true;                                      // cr.Say(SAY_NETMSG,"booze");
                }


                // return false;
            }


            Log( "no " + i + " pid " + drugProtoId + " index " + drugIndexs[ i ] + " isHave " + isHaveItem[ i ] );
        }
        return true;
    }
    return false;
}


bool ItemStimpackUse( Critter& cr, Item& item )
{
    int16  hpCurrent = cr.StatBase[ ST_CURRENT_HP ];
    uint16 hpMax = ( cr.StatBase[ ST_MAX_LIFE ] + cr.StatBase[ ST_STRENGTH ] * 4 + cr.StatBase[ ST_ENDURANCE ] * 8 );
    uint8  hpHealRate = cr.Stat[ ST_HEALING_RATE ];

    if( hpCurrent == hpMax )
    {
        cr.Say( SAY_NETMSG, "Ваше здоровье маскимально." );
        return true;
    }

    float healMod = ( hpMax * 0.01 ) * ( hpCurrent * 0.01 );
    if( healMod == 0 )
        healMod = 1;
    uint16 healAdd = ( hpHealRate * 4 ) * ( healMod );
    healAdd = CLAMP( healAdd, 1, hpHealRate * ( cr.Stat[ ST_ENDURANCE ] + cr.Stat[ ST_STRENGTH ] ) * 0.8 );
    hpCurrent + healAdd > hpMax ? cr.StatBase[ ST_CURRENT_HP ] = hpMax : cr.StatBase[ ST_CURRENT_HP ] += healAdd;

    // bleed
    if( hpCurrent >= ( hpMax * 0.75 ) )
    {
        ChangeStatus( cr, CR_STATUS_BLEED, healAdd * 0.5, false );
    }

    _DecItem( item, 1 );                                   // delete stimpack

    uint8 overdose = ( cr.StatBase[ ST_OVERDOSE ] & 0x4 ); // overdose

    cr.Say( SAY_NETMSG, "before " + cr.Stat[ ST_OVERDOSE ] );

    if( overdose <= ( cr.Stat[ ST_ENDURANCE ] + cr.Stat[ ST_STRENGTH ] ) / 2.5 )
    {
        overdose++;
        overdose = CLAMP( overdose, 0, 7 );
        cr.StatBase[ ST_OVERDOSE ] |= overdose;
    }
    else
    {
        if( Random( 0, 95 ) > cr.Stat[ ST_LUCK ] * 10 )
        {
            cr.ToDead( Random( 0, 1 ) > 0 ? ANIM2_DEAD_FRONT : ANIM2_DEAD_BACK, null );
            cr.Say( SAY_NETMSG, "Вы умерли от передозировки." );
            return true;
        }
        else
        {
            cr.ToKnockout( KNOCKOUT_ANIM2_DEFAULT( ( Random( 0, 1 ) == 1 ) ), 200 - ( cr.Stat[ ST_ENDURANCE ] * cr.Stat[ ST_HEALING_RATE ] * 2 ), cr.HexX, cr.HexY );
            cr.Say( SAY_NETMSG, "У Вас передозировка." );
        }
    }

    cr.Say( SAY_NETMSG, "after " + cr.StatBase[ ST_OVERDOSE ] );

    ChangeCritterSpeed( cr );   // pm added

    cr.Say( SAY_NETMSG, "Вы восстановили " + healAdd + " жизней" );
    return true;
}

bool ItemPowderUse( Critter& cr, Item& item )
{
    uint8 overdose = ( ( cr.StatBase[ ST_OVERDOSE ] >> 4 ) & 0x4 ); // overdose

    cr.Say( SAY_NETMSG, "before " + cr.Stat[ ST_OVERDOSE ] );

    if( overdose <= ( ( cr.Stat[ ST_ENDURANCE ] * 2 ) + ( cr.Stat[ ST_STRENGTH ] * 2 ) / 5 ) )
    {
        overdose++;
        overdose = CLAMP( overdose, 0, 7 );
        cr.StatBase[ ST_OVERDOSE ] |= ( overdose << 4 );   // q Была какая то кривая неработающую хуета, исправил на работающую кривую хуету
    }
    else
    {
        if( Random( 0, 95 ) > cr.Stat[ ST_LUCK ] * 10 )
        {
            cr.ToDead( Random( 0, 1 ) > 0 ? ANIM2_DEAD_FRONT : ANIM2_DEAD_BACK, null );
            cr.Say( SAY_NETMSG, "Вы умерли от передозировки." );
            return true;
        }
        else
        {
            cr.ToKnockout( KNOCKOUT_ANIM2_DEFAULT( ( Random( 0, 1 ) == 1 ) ), 200 - ( cr.Stat[ ST_ENDURANCE ] * cr.Stat[ ST_HEALING_RATE ] * 2 ), cr.HexX, cr.HexY );
            cr.Say( SAY_NETMSG, "У Вас передозировка." );
        }
    }

    cr.Say( SAY_NETMSG, "after " + cr.StatBase[ ST_OVERDOSE ] );
    UseDrug( cr, item );
    return true;
}

uint cte_Heal( Critter& cr, int identifier, uint& rate )
{
    cr.StatBase[ ST_CURRENT_HP ] += rate;
    cr.Say( SAY_NETMSG, "Вылечено жизней: " + rate );

    uint8 rnd = Random( 1, rate * 0.05 );
    rate -= ( rate > rate - rnd ? rate - rnd : 1 );

    int16 aidTime = 80 + ( rate * 10 ) - ( cr.Stat[ ST_HEALING_RATE ] * 3 ) - cr.Stat[ ST_ENDURANCE ] + Random( -10, 10 );
    if( aidTime < 0 )
        aidTime = 0;

    ChangeCritterSpeed( cr );   // pm added

    bool repeat;

    if( cr.StatBase[ ST_MAX_LIFE ] <= cr.StatBase[ ST_CURRENT_HP ] || rate <= 1 )
    {
        repeat = false;
    }
    return repeat ? aidTime : 0;

}

void unsafe_doc( Critter& cr, int damage, int targetId, int docbagId, string@ message, int[] @ p4 )
{
    Critter @ target = GetCritter( targetId );
    if( @target == null )
        return;

    uint8[] drugIndexs = { 0, 0, 0, 0, 0, 0 };
    bool[] isHaveItem = { false, false, false, false, false, false }; // antiseptic / healing / bandage

    // isHaveItem.resize(6);
    // drugIndexs.resize(6);

    uint16 statusFlag = target.StatBase[ ST_CRSTATUS ];



    Item@ activeHand = _CritGetItemHand( cr );
    if( @activeHand == null || activeHand.GetType() != ITEM_TYPE_CONTAINER )
    {
        cr.Say( SAY_NETMSG, "Техническая ошибка, итема нет. Обратитесь к геиммастеру." );
        return;
    }
    Item@[] drugs;
    activeHand.GetItems( -1, drugs );

    uint16 flag = activeHand.Val4;

    if( !FindItemInCont( drugs, drugIndexs, isHaveItem, flag, false ) )
    {
        cr.Say( SAY_NETMSG, "Сумка доктора пуста" );
        return;
    }

    if( damage == HEAVY_DAMAGE )   // heal non-firstAid damages
    {
        if( !isHaveItem[ 5 ] || !isHaveItem[ 3 ] )
        {
            cr.Say( SAY_NETMSG, "У Вас нет ниток или иглы." );
            return;
        }
        if( FLAG( target.StatBase[ ST_CRSTATUS ], CR_STATUS_BULLET_OVER ) || FLAG( target.StatBase[ ST_CRSTATUS ], CR_STATUS_HEAVY_DMG ) )
        {
            if( isHaveItem[ 1 ] )
            {
                uint8 skillMod = ( drugs[ drugIndexs[ 1 ] ].GetProtoId() == PID_MULTI_TOOL ? 60 : 20 );

                if( Random( 1, 95 - ( target.Stat[ ST_LUCK ] * 1.5 ) ) > CLAMP( target.Skill[ SK_DOCTOR ] - skillMod, 0, 95 ) )
                {
                    cr.Say( SAY_NETMSG, "Для Вас это оказалось слишком сложно." );
                    cr.TimeoutBase[ TO_SK_DOCTOR ] = DOCTOR_TIMEOUT( cr );
                    return;
                }

                if( isHaveItem[ 4 ] )
                {
                    target.Say( SAY_NETMSG, "have 4" );
                    uint16 drugPid = drugs[ drugIndexs[ 4 ] ].GetProtoId();

                    if( drugPid == PID_BOOZE )
                    {
                        uint8 boozeNeeded = target.Stat[ ST_ENDURANCE ];
                        uint8 boozeHave = drugs[ drugIndexs[ 4 ] ].GetCount();
                        int8  damageValue = boozeHave - boozeNeeded;

                        target.Say( SAY_NETMSG, "" + boozeNeeded + " " + boozeHave + " " + damageValue );

                        if( damageValue < 0 )
                        {
                            InjureCritter( target, ( ABS( damageValue ) * ( 40 + Random( 0, 5 ) ) ) * ( ( target.Stat[ ST_ENDURANCE ] + target.Stat[ ST_STRENGTH ] ) * 0.01 ), DAMAGE_NORMAL, target.Dir, 0 );
                        }

                        // uint8 forValue = boozeNeeded - ABS(boozeHave - boozeNeeded);
                        for( uint8 i = 0; i < boozeNeeded; i++ )
                        {
                            if( @drugs[ drugIndexs[ 4 ] ] != null )
                            {
                                UseDrug( target, drugs[ drugIndexs[ 4 ] ] );
                                _DecItem( drugs[ drugIndexs[ 4 ] ], 1 );

                                target.Say( SAY_NETMSG, " i = " + i + " booze " + boozeNeeded );
                            }
                            else
                                break;
                        }
                    }
                    else if( drugPid == PID_ANESTETIC )
                    {
                        _DecItem( drugs[ drugIndexs[ 4 ] ], 1 );
                    }
                }
                else
                {
                    InjureCritter( target, 400 * ( ( target.Stat[ ST_ENDURANCE ] + target.Stat[ ST_STRENGTH ] ) * 0.01 ), DAMAGE_NORMAL, target.Dir, 0 );
                }

                if( isHaveItem[ 0 ] && ( @drugs[ drugIndexs[ 0 ] ] != null && drugs[ drugIndexs[ 0 ] ].GetCount() > 0 ) )   // blood toxic
                {
                    uint16 drugProtoId = drugs[ drugIndexs[ 0 ] ].GetProtoId();
                    if( drugProtoId == PID_BOOZE )
                    {
                        // CR_STATUS_HEAVY_DMG
                        int16  hpCurrent = target.StatBase[ ST_CURRENT_HP ];
                        uint16 hpMax = ( target.StatBase[ ST_MAX_LIFE ] + target.StatBase[ ST_STRENGTH ] * 4 + target.StatBase[ ST_ENDURANCE ] * 8 );
                        uint8  chance = target.Stat[ ST_STRENGTH ] * 3 + target.Stat[ ST_ENDURANCE ] * 4 + target.Stat[ ST_HEALING_RATE ] * 10 * ( ( hpMax * 0.01 ) * ( hpCurrent * 0.01 ) ) + ( FLAG( target.StatBase[ ST_CRSTATUS ], CR_STATUS_BULLET_OVER ) ? 30 : 0 );
                        chance = CLAMP( chance, 0, 95 );
                        if( Random( 1, 100 - ( target.Stat[ ST_LUCK ] * Random( 1, 3 ) ) ) > chance )
                        {
                            ChangeStatus( target, CR_STATUS_BLOOD_TOXIC, 0, true );
                        }
                    }
                    else if( Random( 0, 100 ) > 95 )
                        ChangeStatus( target, CR_STATUS_BLOOD_TOXIC, 0, true );

                    _DecItem( drugs[ drugIndexs[ 0 ] ], 1 );

                }
                else if( Random( 130 - ( ( target.Stat[ ST_LUCK ] * 2 ) + target.Stat[ ST_HEALING_RATE ] * 5 ), 100 ) > 95 )
                    ChangeStatus( target, CR_STATUS_BLOOD_TOXIC, 0, true );

                ChangeStatus( target, CR_STATUS_BULLET_OVER, 0, false );
                // UNSETFLAG(cr.StatBase[ST_CRSTATUS], CR_STATUS_BULLET_OVER);
                cr.Say( SAY_NETMSG, "Вы извлекли пули." );
            }
            else
            {
                cr.Say( SAY_NETMSG, "Вам потребуются плоскогубцы или зажим для этого." );
                return;
            }
        }
        else
        {
            cr.Say( SAY_NETMSG, "Вам не требуются помощь данного вида." );
            return;
        }

        // UNSETFLAG(cr.StatBase[ST_CRSTATUS], CR_STATUS_HEAVY_DMG);
        ChangeStatus( target, CR_STATUS_HEAVY_DMG, 0, false );
        cr.Say( SAY_NETMSG, "Вы зашили тяжелые раны." );
        return;


    }

    uint[] rates;
    uint8 countTimes = target.GetTimeEvents( CTE_DOC, null, null, rates );
    cr.Say( SAY_NETMSG, "" + countTimes );
    if( countTimes > 0 )
    {
        for( uint8 i = 0; i < countTimes; i++ )
        {
            cr.Say( SAY_EMOTE, "" + i + " " + rates[ i ] );
            if( rates[ i ] == damage )
            {
                cr.Say( SAY_NETMSG, "Эта часть тела уже лечится." );
                return;
            }
        }
    }

    if( target.DamageBase[ damage ] == 0 )
    {
        cr.Say( SAY_NETMSG, "Эта часть тела не нуждается в лечении." );
        return;
    }

    cr.Say( SAY_NETMSG, "id " + drugIndexs[ 2 ] + " have " + isHaveItem[ 2 ] );

    if( !isHaveItem[ 2 ] )
    {
        cr.Say( SAY_NETMSG, "Требуется шина." );
        return;
    }

    uint docTime = 504 - cr.Skill[ SK_DOCTOR ] - ( target.Stat[ ST_ENDURANCE ] * 5 );
    target.AddTimeEvent( "cte_Doc", docTime * 3600, CTE_DOC, damage );
    cr.StatBase[ ST_EXPERIENCE ] += 250;
    cr.TimeoutBase[ TO_SK_DOCTOR ] = DOCTOR_TIMEOUT( cr );
    cr.AddScore( SCORE_DOCTOR, 1 );
    cr.Say( SAY_NETMSG, "Вы наложили швы." );
}

uint cte_Doc( Critter& cr, int identifier, uint& rate )
{
    cr.DamageBase[ rate ] = 0;
    cr.Say( SAY_NETMSG, "Вы чувствуете себя гораздо лучше." );
    uint8 noMove = cr.DamageBase[ DAMAGE_LEFT_LEG ] > 0 && cr.DamageBase[ DAMAGE_RIGHT_LEG ] > 0 ? 1 : 0;
    cr.ModeBase[ MODE_NO_WALK ] = noMove;
    cr.ModeBase[ MODE_NO_RUN ] = noMove;
    // ChangeCritterSpeed(cr); //pm added
    return 0;

}

void unsafe_setDrugsPriority( Critter& cr, int id, int state, int p2, string@ message, int[] @ p4 )
{
    // cr.Say(SAY_EMOTE, ""+id+" "+state);
    Item @ item = GetItem( id );
    if( @item == null )
    {
        cr.Say( SAY_NETMSG, "Не верный итем. Обратитесь к геиммастеру." );
        return;
    }
    // cr.Say(SAY_EMOTE, ""+item.GetProtoId());

    if( item.GetProtoId() != PID_FIRST_AID_KIT && item.GetProtoId() != PID_DOCTORS_BAG )
    {
        cr.Say( SAY_NETMSG, "Неверный тип сумки." );
        return;
    }
    if( item.Accessory != ACCESSORY_CRITTER )
    {
        cr.Say( SAY_NETMSG, "Должен быть в инвентаре." );
        return;
    }

    item.Val4 = state;
}
