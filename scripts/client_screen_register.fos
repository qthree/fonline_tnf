///////////////////////////////////////////////
///////////////////////////////////////////////

bool SetOutParam(uint16 paramIndex, uint16 paramValue){
        if(outRegScreen is null) return false;
        outRegScreen.Param[paramIndex] = paramValue;
        return true;
}

bool GetOutParam(uint16 paramIndex, uint16& paramValue){
        if(outRegScreen is null || paramIndex >= outRegScreen.Param.length()) return false;
        //Message("param out "+paramIndex);
        paramValue = outRegScreen.Param[paramIndex];
        return true;
}
