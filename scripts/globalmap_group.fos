void TransitCritterToCell( Critter& cr, /*uint16 gridId*/ Scenery& grid ) // uint8 direction deprecated
{
    if( @world == null )
    {
        cr.Say( SAY_NETMSG, "world !valid" );
        return;
    }

    if( @grid == null )
    {
        cr.Say( SAY_NETMSG, "grid !valid" );
        return;
    }

    Cell @ cell = world.GetCell( cr ); // worlbool d.GetCellByMap(cr.GetMap().Id);//world.GetCell(cr);

    if( @cell == null )
    {
        cr.Say( SAY_NETMSG, "cell !valid" );
        return;
    }
    if( @cell.Content == null )
    {
        cr.Say( SAY_NETMSG, "cont !valid" );
	cr.TransitToGlobal(true);
        return;
    }

    Map @ map = cr.GetMap();
    if( @map == null )
    {
        cr.Say( SAY_NETMSG, "map !valid" );
        return;
    }

    int8   offsetCellX = 0, offsetCellY = 0;
    uint8  direction = cr.GetMap().GetScenParam( grid.HexX, grid.HexY, grid.ProtoId, 0 );
    uint16 destCellX = cell.X, destCellY = cell.Y, oldHexX = 0, oldHexY = 0;

    if( !map.GetEntireCoords( ENTIRE_NUM, 0, oldHexX, oldHexY ) )
    {
        cr.Say( SAY_NETMSG, "no ent" );
        return;
    }
    
    bool isLost = false;
    
    uint8 tempDir = direction;
        if(cr.Skill[SK_OUTDOORSMAN] < Random(0, 99) && cell.BiomType <= BIOM_TYPE_FOREST){	//desert
	if(!ChechNearCellStatic(cell.X, cell.Y)){
		tempDir = tempDir + (Random(-1,1));
		if(tempDir < 0) tempDir = 7;
		if(tempDir > 7) tempDir = 0;

		isLost = true;
	}
    }
    
    //cr.Say(SAY_NETMSG, "debug 0");

    offsetCellX = ( ( cr.HexX - oldHexX ) / MAP_SIZE );
    offsetCellY = ( ( cr.HexY - oldHexY ) / MAP_SIZE );

    SetMapDirection( tempDir/*direction*/, destCellX, destCellY, offsetCellX, offsetCellY );

    uint16 tempX = 0, tempY = 0;

    tempX = ( direction != 5 && direction != 1 ? cr.HexX : grid.HexX );
    tempY = ( direction != 3 && direction != 7 ? cr.HexY : grid.HexY );

    if( cell.SizeX > 1 || cell.SizeY > 1 )
    {
        uint8 tempHexX = ( ( cr.HexX - oldHexX ) / MAP_SIZE ),
              tempHexY = ( ( cr.HexY - oldHexY ) / MAP_SIZE );

        if( tempX > 1 )
        {
            tempX -= ( tempHexX ) * MAP_SIZE;
        }
        if( tempY > 1 )
        {
            tempY -= ( tempHexY ) * MAP_SIZE;
        }
    }

    oldHexX = ABS( int(tempX - oldHexX) );
    oldHexY = ABS( int(tempY - oldHexY) );

    uint8 worldOffsetX = ( ( ( MAP_SIZE - oldHexX ) * 100 ) / MAP_SIZE ), worldOffsetY = ( ( ( MAP_SIZE - oldHexY ) * 100 ) / MAP_SIZE );


    uint16 wX = cell.X * 10, wY = cell.Y * 10 + CELL_SIZE;
    //Log("map x:y "+__GlobalMapWidth+" : "+__GlobalMapHeight);
    /*if(destCellX * 10 >= __GlobalMapWidth || destCellY * 10 >= __GlobalMapHeight || destCellX * 10 <= 0 || destCellY * 10 <= 0){
        cr.Say(SAY_NETMSG, "Вы видите отвесный обрыв. Это КОНЕЦ.");
        return;
    }*/

    Cell   @transitCell = world.GetCell( destCellX, destCellY );
    if(transitCell is null) return;
    bool isCellNull = (/*transitCell is null && */transitCell.Content is null);
    uint16 mapId = 0;
    
    //cr.Say(SAY_NETMSG, "debug 1");
    //if(!isCellNull && transitCell.Content.Visibility <= 5){}


    // generator
    //uint8 crsCount = (isTransitCell ? transitCell.Content.GetCrittersCount(-1) : 0);
    //if(crsCount != 0){
    //}else{
	if(isCellNull)
	{
        // mapId = GenerateWasteland(cr, destCellX, destCellY);
        // Log("create loc in "+destCellX+":"+destCellY);

		//cr.Say( SAY_NETMSG, "Только Саттер." );
		// void CreateCell( uint16 x, uint16 y, uint mapId, uint8 type, int8 visibility )
		/*if(ChechNearCellForPlayer(destCellX, destCellY) || transitCell.BiomType > BIOM_TYPE_FOREST) //FLAG(transitCell.BiomFlags, BIOM_TYPE_ROAD))
		{*/
			//if(cr.GetAccess() > ACCESS_CLIENT){
				mapId = world.CreateCell(destCellX, destCellY, 0, CELLMAP_TYPE_ENCOUTER, 100);
			//}else{
			//	cr.SayMsg(SAY_NETMSG, TEXTMSG_TEXT, MSG_ONLY_SUTTER);
			//	return;
			//}
		/*}else{
			cr.TransitToGlobal(true);
			return;
		}*/

			/*cr.SayMsg(SAY_NETMSG, TEXTMSG_TEXT, MSG_ONLY_SUTTER);
			return;*/
	}else{
			int level = GetMapLevelByPid( map.GetProtoId() );
			mapId = transitCell.Content.MapId[ CELL_LEVEL_DEFAULT + level ];
	}

	//cr.Say(SAY_NETMSG, "debug 2");

      if(mapId == 0){
		cr.Say(SAY_NETMSG, "null mapId.");
		return;
      }
    
    cr.Say(SAY_NETMSG, "debug 2 sub 0");

    @map = GetMap( mapId );
    if( mapId == 0 || map is null )
    {
        cr.Say( SAY_NETMSG, "mapId !valid" ); return;
    }
    
    //cr.Say(SAY_NETMSG, "debug 2 sub 1");
    
    uint16 destHexX = 0, destHexY = 0;
    if( !map.GetEntireCoords( ENTIRE_NUM, 0, destHexX, destHexY ) )
    {
        cr.Say( SAY_NETMSG, "no dest ent" );
        return;
    }
    
    //cr.Say(SAY_NETMSG, "debug 3");

    SetHexDirection( cell, transitCell, direction, oldHexX, oldHexY );
    
    if(CheckMonsterTransitePlace(cr,map, destHexX + oldHexX, destHexY + oldHexY)){
		ShowAnswerScreenMob(cr);
		return;
    }

    //CheckHexTrace(map, destHexX + oldHexX, destHexY + oldHexY, destHexX, destHexY);
    if( map.IsHexPassed( destHexX + oldHexX, destHexY + oldHexY ) )
    {
      
	if((!isCellNull && transitCell.Content.Type == CELLMAP_TYPE_STATIC) || 
	(cell.Content !is null && cell.Content.Type == CELLMAP_TYPE_STATIC) ||
	cell.BiomType == BIOM_TYPE_LAKE || cell.BiomType == BIOM_TYPE_RIVER ||
	cell.BiomType == BIOM_TYPE_MOUNTAIN ||
	ChechNearCellForPlayer(destCellX, destCellY)){
	  	cr.SetWorldPos( destCellX * 10, destCellY * 10 );
		cr.TransitToMap( mapId, destHexX + oldHexX, destHexY + oldHexY, direction );
		
		if(isLost){
			cr.Say(SAY_NETMSG, "Кажется вы блуждаете.");
		}
		
		//int tt = ( ( int(transitCell.X) & 0xFFFF ) | ( int(transitCell.Y) << 16 ) );
		//cr.ParamBase[ ST_VAR6 ] = tt;
	}else{
		cr.StatBase[ST_OBJECT_TYPE] = direction;
		cr.StatBase[ST_ITEM_HEXX] = destHexX + oldHexX;
		cr.StatBase[ST_ITEM_HEXY] = destHexY + oldHexY;
		cr.StatBase[ST_ITEM_PID] = mapId;
		
		//cr.Say(SAY_NETMSG, "debug sub");
		
		ShowAnswerScreenTransit(cr);
	}
		
		//if(cr.Stat
	//cr.Say(SAY_NETMSG, "debug 4");
		
      
	/*if(CheckMonsterTransitePlace(cr, map, destHexX + oldHexX, destHexY + oldHexY)){
		

		ShowAnswerScreen(cr);
	}else{*/
	
		
		//encounter
		//GetEncounter(cr, transitCell.BiomType);
	//}

	return;
    }
    cr.Say( SAY_NETMSG, "Вы не можете туда перейти. Гексы заняты." );
    return;

}
