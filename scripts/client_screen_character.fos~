        ArchiveIndex = index;
        uint16[] @ avalibleParam = InfoArrayGet();

        //for(uint8 i = 0, j = TraitBtn.length(); i < j; ++i){
        for(uint8 i = 0; i < INFO_LENGTH; ++i){

