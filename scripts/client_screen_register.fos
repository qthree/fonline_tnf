class CRegisterSkillShow : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
    uint8 Index;
    uint16 ParamIndex;
    CRegisterScreen@ Instance;
    IGUIElementOpt@ Options;

   CRegisterSkillShow(CRegisterScreen& instance, uint8 index, uint16 param){
        Index = index;
        ParamIndex = param;

        @Instance = instance;
        @Instance.SkillShow[Index] = this;
    }

    void OnMouseClick(int click){
        Instance.SetHelp(ParamIndex);
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();


        //Text(Instance.StatValue[Index]);
        //Text(5);
    }

    void OnDraw(){

        int x = Options.GetPosX(), y = Options.GetPosY();

       // string text = Instance.Param[ParamIndex];//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
       bool isTagSet = Instance.TagBtn[Index].IsSet;
       uint color = (isTagSet ? COLOR_GRAY : COLOR_GREEN);

       if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

        DrawText(""+Text(Instance.Param[ParamIndex]), x+325, y+314, 40 , 40, color, FONT_FALLOUT,  0);
    }

    void SetValue(){}

    void Text_(uint8 value){
        //Options.Text( text, FONT_BIG_NUM, COLOR_LRED, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }

    string Text(uint8 value){
        string text = "";
        if(value < 100){text = "0";}
        if(value < 10){text += "0";}

        text += value+"%";

        return text;
    }
}

class CRegisterTagBtn : IGUIElementCallbackMouseClick, IGUIElementCallbackInit
{
        bool  IsSet;
        uint8 Index;

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterTagBtn(CRegisterScreen& instance, uint8 index){

            Index = index;

            @Instance = instance;
            @Instance.TagBtn[Index] = this;

            IsSet = false;
        }

        void OnMouseClick(int click){

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {return;}   //gamemode

            if(IsSet){
                    Instance.TagUnset(Instance.SkillShow[Index].ParamIndex);
                    Instance.ParamDropSoft();
                    IsSet = !IsSet;
                    Switch();
            }else
            if(Instance.UnxpTag > 0){
                    Instance.TagSet(Instance.SkillShow[Index].ParamIndex);
                    Instance.ParamDropSoft();
                    IsSet = !IsSet;
                    Switch();
            }

            Instance.SetHelp(Instance.SkillShow[Index].ParamIndex);
            //Message(""+Index);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }


        void Switch(){
            Options.Switch(IsSet);
        }

        void Switch(bool set){
            Options.Switch(set);
        }
}

