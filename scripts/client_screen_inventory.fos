	void SelectItem(uint8 index)
	{
		uint16 	itemsLen = InventoryItems.length(),
			realIndex = 0;
			
		if(index >= itemsLen || Instance.InventoryButtons[index].InvItemIndex == uint16(-1)) return;
		if(prevIndex != uint8(-1)) Instance.InventoryButtons[prevIndex].PressPic(false);
		if(index != uint8(-1)) Instance.InventoryButtons[index].PressPic(true);
		
		realIndex = Instance.InventoryButtons[index].InvItemIndex;
		
		if(realIndex < InventoryItems.length())
		{
		  
			//Message(""+InventoryItems[index].Id[0]+" "+Instance.InventoryButtons
			//ItemCl @ item = GetItem(InventoryItems[index].Id[0]);
			//if(item !is null)
			//{
				uint spriteHash = (InventoryItems[realIndex].tempItem[0] !is null ? InventoryItems[realIndex].tempItem[0].Proto.PicInv : 0);
				string descText = (InventoryItems[realIndex].tempItem[0] !is null ? item_description(InventoryItems[realIndex].tempItem[0], ITEM_LOOK_INVENTORY) : "invalid item"); //GetMsgStr(TEXTMSG_ITEM,InventoryItems[index].tempItem[0].GetProtoId()*100+1)
				//Message(" "+spriteHash);
				Instance.ItemShow.Pic(spriteHash);
				Instance.ItemDesc.Text(descText);
			//}
		}
		
		prevIndex = index;
	}
	
