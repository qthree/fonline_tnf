	InvItemList(ScreenInventory& instance)
	{
		@Instance = instance;
		prevIndex = uint8(-1);
		GroupType = 0;
	}

	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		@Instance = this;
		//Message(""+prevIndex);
