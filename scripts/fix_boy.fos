// Author: cvet
#include "_macros.fos"

#define FIX_SUCCESS         (FIXBOY_DEFAULT)
#define FIX_TIMEOUT         (FIXBOY_DEFAULT^FIXBOY_SET_TIMEOUT)
#define FIX_FAIL            (FIXBOY_DEFAULT^FIXBOY_ALLOW_CRAFT)

//Таймауты на крафт
#define SHORT_TO	(10)
#define MEDIUM_TO	(30)
#define HITECH_TO	(100)

/*
// Fix boy function call states
#define FIXBOY_LIST                (0)
#define FIXBOY_BUTTON              (1)
#define FIXBOY_CRAFT               (2)

// Fix boy craft results
#define FIXBOY_ALLOW_CRAFT         (0x0001)
#define FIXBOY_CHECK_TIMEOUT       (0x0002)
#define FIXBOY_SET_TIMEOUT         (0x0004)
#define FIXBOY_CHECK_PARAMS        (0x0008)
#define FIXBOY_CHECK_MATERIALS     (0x0010)
#define FIXBOY_CHECK_TOOLS         (0x0020)
#define FIXBOY_SUB_MATERIALS       (0x0040)
#define FIXBOY_ADD_CRAFT_ITEMS     (0x0080)
#define FIXBOY_ADD_EXPERIENCE      (0x0100)
#define FIXBOY_SEND_SUCC_MESSAGE   (0x0200)
#define FIXBOY_SEND_FAIL_MESSAGE   (0x0400)
#define FIXBOY_DEFAULT             (0xFFFF)
*/
//Пора, пора сделать шаг в сторону нормального крафта. 
// fix_boy@fix_Repair
// fix_boy@fix_Science
// fix_boy@fix_Advanced
// fix_boy@fix_HighTech

//Крафт-рецепт, требующий скилл ремонта.
int fix_Repair(Critter& cr, int stage)
{
	 if(stage==FIXBOY_CRAFT)
	  {
		cr.TimeoutBase[TO_SK_REPAIR]=REPAIR_TIMEOUT(cr)+SHORT_TO;
		return FIX_TIMEOUT;
	  }
	  return FIXBOY_DEFAULT;
}

//...Науки...
int fix_Science(Critter& cr, int stage)
{
	 if(stage==FIXBOY_CRAFT)
	  {
		cr.TimeoutBase[TO_SK_SCIENCE]=SCIENCE_TIMEOUT(cr)+SHORT_TO;
		return FIX_TIMEOUT;
	  }
	  return FIXBOY_DEFAULT;
}

//...Науки и ремонта, сложный предмет...
int fix_Advanced(Critter& cr, int stage)
{
	 if(stage==FIXBOY_CRAFT)
	  {
		cr.TimeoutBase[TO_SK_REPAIR]=REPAIR_TIMEOUT(cr)+MEDIUM_TO;
		cr.TimeoutBase[TO_SK_SCIENCE]=SCIENCE_TIMEOUT(cr)+MEDIUM_TO;
		return FIX_TIMEOUT;
	  }
	  return FIXBOY_DEFAULT;
}

//...Хайтек...
int fix_HighTech(Critter& cr, int stage)
{
	 if(stage==FIXBOY_CRAFT)
	  {
		cr.TimeoutBase[TO_SK_REPAIR]=REPAIR_TIMEOUT(cr)+HITECH_TO;
		cr.TimeoutBase[TO_SK_SCIENCE]=SCIENCE_TIMEOUT(cr)+HITECH_TO;
		return FIX_TIMEOUT;
	  }
	  return FIXBOY_DEFAULT;
}




