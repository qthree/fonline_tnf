class CRegisterAge : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackKeyPress, IGUIElementCallbackDraw
{
        uint8 Age;

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterAge(CRegisterScreen& instance){
            @Instance = instance;
            @Instance.AgeBox = this;
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
            //Options.Text( ""+14, FONT_BIG, COLOR_SAND, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
        }

        void OnMouseClick(int click){
                //DrawHardcodedScreen(CLIENT_SCREEN_CHA_AGE);
        }

        void OnKeyPress(uint8 key, uint8 letter){

            string@ text = Options.GetText();
            // string@ text2 = ""+key;
            if( text.length() > 0 && text[ text.length() - 1 ] == '\n' )
                text.resize( text.length() - 1 );

            int age = 0;
            StrToInt( text, age );
            age = CLAMP( age, 14, 60 );
            text = "" + age;

            Age = uint8(age);

            Options.Text( text, FONT_BIG, COLOR_GREEN, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
        }

        void OnDraw(){

            int x = Options.GetPosX(), y = Options.GetPosY(), age = Instance.Param[ST_AGE];

            //string text = Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
            //uint color = (Index != 7 ? COLOR_WHITE : (Instance.UnxpStat > 0 ? COLOR_WHITE : COLOR_RED));
            //Message("text = "+Text);
            DrawText(""+Age, x+325, y+314, 600 , 600, COLOR_SAND, FONT_BIG,  0);
        }
}


class CRegisterStatButtonChange : IGUIElementCallbackMouseClick, IGUIElementCallbackInit
{
    bool Inc;
    uint8 Index;
    uint16 ParamIndex;
    CRegisterScreen@ Instance;
    IGUIElementOpt@ Options;

    CRegisterStatButtonChange(){
        Inc = false;
        Index = 0;
    }

    CRegisterStatButtonChange(CRegisterScreen& instance, uint8 index, uint16 paramIndex, bool inc){

        Inc = inc;
        Index = index;
        ParamIndex = paramIndex;

        @Instance = instance;
        @Instance.StatChg[Index] = this;
    }

    void OnMouseClick(int click){

        if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {return;} //gamemode

        Instance.SetRegStat(Index);
    }

     void OnInit(){
        @Options = GUI_GetElementOptions();
        //Message("INDEX "+ Index+" INC "+Inc);

     }

     void ChangeValue(){

        //uint16 paramIndex = Instance.StatShow[Index].ParamIndex;

        uint8 value = Instance.Param[ParamIndex];

        //Message("value "+ParamIndex+" "+value+" "+Index);
        //Message("value "+value+" INC "+Inc);

        bool unxp = (Instance.CheckStatUnxp());

        uint8   statMin = (Instance.Param[QST_GAMEMODE] == GAME_ADVENTURE ? STAT_ADVN_MIN : STAT_SURV_MIN),
                statMax = (Instance.Param[QST_GAMEMODE] == GAME_ADVENTURE ? STAT_ADVN_MAX : STAT_SURV_MAX);

        //if(unxp)
        if(Inc){
                if(statMax > value && unxp){
                        Instance.ChangeParamInc(ParamIndex);
                        Instance.UnxpStat--;
                }
        }else{
                if(statMin < value){
                        Instance.ChangeParamDec(ParamIndex);
                        Instance.UnxpStat++;
                }
        }

        Instance.ParamDropSoft();

/*
        if(value - 1 > STAT_SURV_MIN && STAT_SURV_MAX > value + 1 && Instance.CheckStatUnxp()) {

                //Message("stat "+ParamIndex+" "+Instance.Param[ParamIndex]+" "+Inc);

                //Instance.Param[ParamIndex] += (Inc ? 1 : -1);
                if(Inc){Instance.ChangeParamInc(ParamIndex);}else{Instance.ChangeParamDec(ParamIndex);}
                Instance.UnxpStat += (!Inc ? 1 : -1);
        }*/

     }
}

class CRegisterStatDesc : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        uint8 Index;
        uint16 ParamIndex;
        string Text;

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterStatDesc(CRegisterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = (Index != 7 ? paramIndex : STR_UNXP_SPECIAL);
            Text = "";

            @Instance = instance;
            @Instance.StatDesc[Index] = this;
        }

        void OnMouseClick(int click){
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();

            string text = GetMsgStr(TEXTMSG_GAME, (Index != 7 ?STR_STAT_NAME+ParamIndex : (STR_STAT_FULL+ParamIndex) * 10));

            Options.Text(""+text, FONT_BIG, COLOR_WHITE, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
            Text = text;
        }

        void OnDraw(){

            int x = Options.GetPosX(), y = Options.GetPosY();

            uint color = COLOR_SAND;

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

            //string text = Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
            //uint color = (Index != 7 ? COLOR_WHITE : (Instance.UnxpStat > 0 ? COLOR_WHITE : COLOR_RED));
            //Message("text = "+Text);
            DrawText(""+Text, x+325, y+314, 600 , 600, color, FONT_BIG_NUM,  0);
        }
}

class CRegisterStatShow : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
    uint8 Index;
    uint16 ParamIndex;

    CRegisterScreen@ Instance;
    IGUIElementOpt@ Options;

    CRegisterStatShow(CRegisterScreen& instance, uint8 index, uint16 param){
        Index = index;
        ParamIndex = param;

        @Instance = instance;
        @Instance.StatShow[Index] = this;
    }

    void OnMouseClick(int click){
        Instance.SetHelp(ParamIndex);
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();


        //Text(Instance.StatValue[Index]);
        //Text(5);
    }

    void OnDraw(){

        int x = Options.GetPosX(), y = Options.GetPosY();

        string text = Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
        uint color = (Index != 7 ? COLOR_WHITE : (Instance.UnxpStat > 0 ? COLOR_WHITE : COLOR_RED));

        if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;} //gamemode

        DrawText(""+text, x+325, y+314, 40 , 40, color, FONT_BIG_NUM,  0);
    }

    void SetValue(){}

    void Text_(uint8 value){
        //Options.Text( text, FONT_BIG_NUM, COLOR_LRED, COLOR_DRED, FT_CENTERX | FT_CENTERY | FT_NOBREAK );
    }

    string Text(uint8 value){
        string text = "";
        if(value < 10){text = "0";}
        text += value;

        return text;
    }
}

