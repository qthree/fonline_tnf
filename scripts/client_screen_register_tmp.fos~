class CRegisterInputBox :  IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackKeyPress
{
    bool Mode;
    bool Active;

    string Text;
    string Password;

    IGUIElementOpt@ Options;

    CRegisterInputBox(bool mode){
            Mode = mode;
    }

    void OnMouseClick(int click){

        //SetActive();
        SwitchState();
    }

    void OnInit(){
        @Options = GUI_GetElementOptions();

        uint8 index = (Mode ? INPUT_NAME : INPUT_PASS);

        @inputBoxs[index] = this;

        if(index == INPUT_NAME){
                //SetActive();void Release(){
		//Options.Realese();
	
                //State();
                Active = true;
                //SwitchState();
		SetText(DEFAULT_LOGIN);
		
        }else{Active = false;SetText(DEFAULT_PASSWORD);Password = DEFAULT_PASSWORD;}
    }

    void OnKeyPress( uint8 key, uint8 letter ){
        if(letter == 'a'){Message("TEST!");}
    }

    bool KeyPress(uint8 key){
           return true;//Options.KeyPress(key);
    }

    void SetText(string text){
      
	    if(!Mode){
		  for(uint8 i = 0; i < text.length(); i++){
			  text[i] = '#';
		  }
	    }
      
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
    }

    string GetText(){
           return Options.GetText();
    }
    
    string GetPass(){
	    return Password;
    }
    
    void SetPass(string pass){
	    Password = pass;
    }

    void TextAdd(uint8 letter){
      
	    
      
            string text = Options.GetText();
	    
	    Message(text);
	    
	    if(text == DEFAULT_LOGIN || text == DEFAULT_PASSWORD){SetText("");}
	    
	    //text = Options.GetText();

            //text.insertLast(letter);

            StrInsLast(text, letter);
            Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
    }

    void TextRm(){

            string text = Options.GetText();
            if(text.length() > 0){

                //text.removeLast();
                StrRmLast(text);
                Options.Text(text,FONT_FALLOUT,COLOR_GREEN,COLOR_GREEN,FT_CENTERX|FT_CENTERY);
            }
    }

    void StrInsLast(string& str, uint8 letter){
            uint len = str.length();
            str.resize(len+1);
            str[len] = letter;

    }

    void StrRmLast(string& str){
            uint len = str.length()-1;
            if(len >= 0) str.resize(len);
    }

    void SetActive(){
           Active = !Active;
    }

    void State(){
            Options.Switch(Active);
    }

    void SwitchState(){
        SetActive();
        State();

        //uint8 index = (Mode ? INPUT_NAME : INPUT_PASS);
        /*inputBoxs[index].SetActive();
        inputBoxs[index].State();*/
        //inputBoxs[index].SwitchState();

    }
}

CRegisterInputBox@[] inputBoxs;
