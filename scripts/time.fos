// Author: cvet
// Some stuff for work with time.

// import uint GetNearFullMinute(uint16 year, uint16 month, uint16 day, uint16 hour, uint16 minute) from "time";
// Result is greather than __FullMinute at least on one.

// For client:
// import string@ GetTimeString(const string& format, uint fullMinute) from "time";
// import string@ GetTimeString(const string& format, int year, int month, int day, int dayOfWeek, int hour, int minute) from "time";
// Tags format:
//  %YEAR% - year,
//  %MONTH% - month,
//  %DAY% - day,
//  %DOW% - day of week,
//  %HOUR% - hour,
//  %MINUTE% - minute;
// To show names of values add "-STR" to format tag (%MONTH% -> %MONTH-STR%), supported by month and day of week.
// Example: GetTimeString("%HOUR%:%MINUTE% %DAY% (%DOW-STR%) %MONTH-STR% %YEAR%",fullMinute) -> "14:05 23 (Sunday) November 2299"/"14:05 23 (Воскресенье) Ноябрь 2299".

#include "_defines.fos"

#define STR_MONTH #(m)               (20+(m))
#define STR_DAY_OF_WEEK #(dow)       (33+(dow))


uint GetNearFullMinute(uint16 year, uint16 month, uint16 day, uint16 hour, uint16 minute)
{
	int jump=0; // 1 - years, 2 - months, 3 - days
	if(year==0)
	{
		year=__Year;
		jump=1;
	}
	if(month==0)
	{
		month=__Month;
		jump=2;
	}
	if(day==0)
	{
		day=__Day;
		jump=3;
	}

	uint fullMinute=GetFullMinute(year,month,day,hour,minute);
	while(fullMinute<=__FullMinute)
	{
		switch(jump)
		{
		case 0:
			return __FullMinute+1; // Time expired, call faster
		case 1:
			year++;
			break;
		case 2:
			month++;
			if(month>12)
			{
				month=1;
				year++;
			}
			break;
		case 3:
			day++;
			if(day>28 && day>GetDaysInMonth(year,month))
			{
				day=1;
				month++;
				if(month>12)
				{
					month=1;
					year++;
				}
			}
			break;
		default:
			break;
		}

		fullMinute=GetFullMinute(year,month,day,hour,minute);
	}
	return fullMinute;
}

uint GetDaysInMonth(uint16 year, uint16 month)
{
	switch(month)
	{
	case 1:case 3:case 5:case 7:case 8:case 10:case 12: // 31
		return 31;
	case 2: // 28-29
		if((year%4)!=0) return 28;
		return 29;
	default: // 30
		return 30;
	}
	return 0;
}

#ifdef __CLIENT
string@ GetTimeString(const string& format, uint fullMinute) // Export
{
	uint16 year=0,month=0,day=0,dayOfWeek=0,hour=0,minute=0;
	GetGameTime(fullMinute,year,month,day,dayOfWeek,hour,minute);
	return GetTimeString(format,year,month,day,dayOfWeek,hour,minute);
}

string@ GetTimeString(const string& format, int year, int month, int day, int dayOfWeek, int hour, int minute) // Export
{
	string result=format;

	if(year!=-1) result=ReplaceText(result,"%YEAR%",year);
	if(month!=-1)
	{
		result=ReplaceText(result,"%MONTH%",month);
		result=ReplaceText(result,"%MONTH-STR%",GetMsgStr(TEXTMSG_GAME,STR_MONTH(month)));
	}
	if(day!=-1) result=ReplaceText(result,"%DAY%",day);
	if(dayOfWeek!=-1)
	{
		result=ReplaceText(result,"%DOW%",dayOfWeek);
		result=ReplaceText(result,"%DOW-STR%",GetMsgStr(TEXTMSG_GAME,STR_MONTH(dayOfWeek)));
	}
	if(hour!=-1) result=ReplaceText(result,"%HOUR%",hour);
	if(minute!=-1) result=ReplaceText(result,"%MINUTE%",minute);

	return result;
}
#endif






