class CRegisterPerkBtn : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        bool IsSet;
        uint8 Index;
        uint16 ParamIndex;

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterPerkBtn(CRegisterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = paramIndex;
            IsSet = false;

            @Instance = instance;
            @Instance.PerkBtn[Index] = this;

        }

        void OnMouseClick(int click){

            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {return;}   //gamemode

            if(IsSet){// && Instance.UnxpTrait > 0
                Instance.PerkUnset(ParamIndex);
            }else{
                Instance.PerkSet(ParamIndex);
            }

            Switch();
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnDraw(){

            //int x = Options.GetPosX(), y = Options.GetPosY();

            //string text = GetMsgStr(TEXTMSG_GAME, (STR_STAT_FULL+ParamIndex)*10+1);//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);

            //DrawText(""+text, x+325, y+314, 40 , 40, COLOR_GREEN, FONT_FALLOUT,  0);
        }

        void Switch(){
            Options.Switch(!IsSet);
            IsSet = !IsSet;
            Instance.PerkDesc[Index].IsSet = IsSet;
        }

        void Switch(bool set){
            Options.Switch(set);
        }

        void Visible(bool vis){
            Options.SetVisible(vis);
        }

        void SetParamIndex(uint16 paramIndex){
            ParamIndex = paramIndex;

            IsSet = (Instance.Param[ParamIndex] > 0);
            Switch(IsSet);

        }
}

