void SaleRoomAction(Critter& player, Critter& npc, int val) //all action to sale room
{
  uint16 id = FreeRoomNumber(npc, true);
  uint16 keyNumber = Random(0,9999);
  if(id != -1)
  {
    Item@ door = GetItem(id);
    Item@ key  = player.AddItem(PID_MOTEL_KEY, 1);
    uint[] values = {door.Id, key.Id, npc.Id};
    door.Val3 = 1; 		//not for sale yet
    door.LockerId = keyNumber;	//key number for open
    door.Val4 = val;		//how long room  stored
    door.LockerCondition = LOCKER_LOCKED;
    key.LockerId = keyNumber;	//add key num to open door
    key.SetLexems("$keyNumberLex"+keyNumberLex);
    key.Update();
    CloseDoor(door);
    CreateTimeEvent(__FullSecond + (val * 60 * 60),"e_RoomRentaOver", values, true);
  }
}

void CloseDoor(Item& door)
{
      //Map @ map = GetMap(door.MapId);
      //map.CloseDoor(door);
      door.LockerClose();
      door.Update();
}

uint e_RoomRentaOver(uint[]@ values)
{
  Item @ door = GetItem(values[0]);
  Item @ key = GetItem(values[1]);
  if(door is null) return 0;
  CloseDoor(door);
  door.Val3 = 0;
  door.LockerId = 0;
  door.Val4 = 0;
  door.LockerCondition = LOCKER_ISOPEN;
  if(key is null) return 0;
  key.LockerId  = 0;
  return 0;
}
