int CellLocationDelete( int x, int y )
{
    Cell @ cell = world.GetCell( x, y );
    if( cell is null )
        return -1;

    return cell.CellDelete();
}

int CellLocationSize( int x, int y, int sizeX, int sizeY )
{
    Cell @ cell = world.GetCell( x, y );
    if( cell is null )
        return -1;

    return cell.CellSetSize( sizeX, sizeY );
}

Cell@ CellGetCellByMap(uint id){
	return world.GetCellByMap(id);
}

bool CellGetCellSize(uint mapId, uint8& sizeX, uint8& sizeY){
	Cell @ cell = world.GetCellByMap(mapId);
	if(cell is null) return false;

	sizeX = cell.SizeX;
	sizeY = cell.SizeY;

	return true;
}

