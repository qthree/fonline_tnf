class ScreenMain : IGUIScreenCallbackShow, IGUIScreenCallbackHide
{
  IGUIScreenOpt@ screenOpt;
  
  //TextboxChannel @ Channel;
  ContextButton @ Button;
  uint8 SubScreenType;
  uint16 PosX;
  uint16 PosY;
  
	void OnShow(int p0, int p1, int p2)
	{
	  @screenOpt = GUI_GetScreenOptions();
	  //uint16 posX = p0, posY = p1;
	  //__lastWindowPosX = posX;
	  //__lastWindowPosY = posY;
	  PosX = p0;
	  PosY = p1;
	  screenOpt.Position(PosX-SCREEN_AXISTX,PosY-SCREEN_AXISTY);
	  SubScreenType = p2;
	  //Message("show");
	  //Message(""+p0+" "+p1+" "+p2);
	  //Message("crId = "+__contMenuCrId+"\n"+"  itId = "+__contMenuItId);
	  
	  screenOpt.SetElementCount(1);
	}
	
	void OnHide(int p0, int p1, int p2)
	{
		//__buttonX = 0;
		//__buttonY = 0;
		//__widthEnd = false;
		//__heighEnd = false;
		//__subMenuNum != SUBMENU_MAIN ? __HideCursor = true : __HideCursor = false;
		__subMenuNum = SUBMENU_MAIN;
		//__pickType = 0;
		//Message("test");
	}
	
	uint8 GetSubScreenType()
	{
		return SubScreenType;
	}
	
	uint16 GetPosX()
	{	
		return PosX;
	}
	
	uint16 GetPosY()
	{	
		return PosY;
	}
	
  //uint8 CurrentElement;
}

class Description : IGUIElementCallbackInit
{
	IGUIElementOpt@ Options;
	string Text;
	
	void OnInit()
	{
		@Options=GUI_GetElementOptions();
	}
	
	void SetText(string text)
	{
		Text = text;
	}
}

class ContextButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick//, IGUIElementCallbackDraw
{
  
	IGUIElementOpt@ Options;
	ScreenMain @ Instance;
	uint8 ButtType;
	uint8 ButtSubMenu;
	uint8 ButtSubMenuBack;
	uint8 ButtNum;
	uint16 crId;
	uint16 itemId;
	
	ContextButton(ScreenMain& instance)
	{
		@Instance=instance;
		@Instance.Button=this;
	}
	
	void OnInit()
	{
		@Options=GUI_GetElementOptions();
		uint8 buttCount = 0;
		switch(__subMenuNum)
		{
		  case SUBMENU_MAIN : buttCount = 8;
		  case SUBMENU_ADMIN: buttCount = 5;
		  case SUBMENU_ADV  : buttCount = 5;
		  default	    : buttCount = 6;
		  
		}
		int16 angel = 0, posX = 0, posY = 0;
		angel = (360 / buttCount)*ButtNum;

		posX = cos(angel)*85.35;
		posY = sin(angel)*84.85;

		Options.Position(posX + SCREEN_AXISTX - (ButtNum % 2 == 1 ? 60 : 0), posY + SCREEN_AXISTY - (ButtNum % 2 == 0 ? 45 : -10));


		CritterCl @ choo = GetChosen();
		ItemCl@ item = GetItem(__contMenuItId); 
		
		bool nearObj = false;
		if(item != null)
		{
			nearObj = ((choo.HexX < item.HexX + 2 || choo.HexX > item.HexX - 2) && (choo.HexY < item.HexY + 2 || choo.HexY > item.HexY - 2));
		}
		
		if(ButtSubMenu != __subMenuNum && ButtType != BUTTON_CANCEL_ALL) Options.Visible(false);
		else

		switch(ButtType)
		{
		  case BUTTON_LOOK : Options.Visible(__contMenuCrId != 0 ? true : __contMenuItId != 0 ? true : false); break;
		  case BUTTON_INV : Options.Visible(__contMenuCrId != 0 ? true : __contMenuItId != 0 ? true : false); break;
		  case BUTTON_SKILL : Options.Visible(__contMenuCrId != 0 ? true : __contMenuItId != 0 ? true : false); break;
		  case BUTTON_USE : Options.Visible(__contMenuItId != 0 && (__contMenuItId < SCENERY_ID || FLAG(item.Flags, ITEM_CAN_USE))); break;
		  case BUTTON_LOOT : Options.Visible((__pickType == 0 ? true : false) == true && __contMenuCrId != 0); break;
		  case BUTTON_PUSH : Options.Visible((__pickType != 0 ? true : false) == true && __contMenuCrId != 0); break;
		  case BUTTON_ROTATE: Options.Visible(__contMenuCrId == choo.Id); break;
		  case BUTTON_TALK : Options.Visible(__contMenuCrId != 0 && __contMenuCrId != choo.Id); break;
		  case BUTTON_REMEMBER : Options.Visible(__contMenuCrId != 0); break;
		  //case BUTTON_TO_SPECIAL : Options.Visible(true); break;
		  //case BUTTON_DOOR_KNOCK : Options.Visible(item != null && item.GetType() == ITEM_DOOR && nearObj); break;
		  case BUTTON_ADMIN : Options.Visible(false); break;
		}
	}
		
	void OnMouseClick(int click)
	{
		::HideScreen(0,2,2,2);
		
		CritterCl @ target = GetCritter(__contMenuCrId);
		
		switch(ButtType)
		{
		  case BUTTON_CANCEL_ALL : {::HideScreen(0,2,2,2); break;}
		  case BUTTON_CANCEL : 	{__subMenuNum = ButtSubMenuBack; ::ShowScreen(CLIENT_SCREEN_CONTMENU, Instance.GetPosX(), Instance.GetPosY(), 0); break;}
					 
		  case BUTTON_INV : { ShowContScreen(SCREEN_BAG, CHOSEN_USE_ITEM); break;}
		  //case BUTTON_USE : {__subMenuNum = SUBMENU_ADV; ::ShowScreen(CLIENT_SCREEN_CONTMENU, Instance.GetPosX(), Instance.GetPosY(), SUBMENU_ADV); break;}
		  case BUTTON_USE : {ShowContScreen(ACTION_PICK_ITEM, CHOSEN_PICK_ITEM);  break;}
		  case BUTTON_LOOK : Look(); break;
		  case BUTTON_SKILL : {ShowContScreen(SCREEN_SKILLBOX, CHOSEN_NONE);  break;}
		  case BUTTON_ADMIN : {__subMenuNum = SUBMENU_ADMIN; ::ShowScreen(CLIENT_SCREEN_CONTMENU, Instance.GetPosX(), Instance.GetPosY(), SUBMENU_ADMIN); break;}
		  case BUTTON_LOOT : {ShowContScreen(ACTION_PICK_CRITTER, CHOSEN_PICK_CRIT);  break;}
		  case BUTTON_PUSH : {ShowContScreen(ACTION_PICK_CRITTER, CHOSEN_PICK_CRIT);  break;}
		  case BUTTON_ROTATE : {ShowContScreen(ACTION_DIR, CHOSEN_DIR);  break;}
		  case BUTTON_TALK : {ShowContScreen(ACTION_TALK, CHOSEN_TALK_NPC);  break;}
		  case BUTTON_REMEMBER :  {CharClick(target); break;}
		  case BUTTON_PANNEL_SKILL : { ::ShowScreen(CLIENT_SCREEN_FASTPANEL_SKILLBOX, 0, 0, 0); break;}
		  case BUTTON_PANNEL_TEXT : {::ShowScreen(CLIENT_SCREEN_FASTPANEL_TEXTBOX, 0, 0, 0); break;}
		  //case BUTTON_TO_SPECIAL : {__subMenuNum = SUBMENU_SPECIAL_ACTIONS; ::ShowScreen(CLIENT_SCREEN_CONTMENU, Instance.GetPosX(), Instance.GetPosY(), SUBMENU_SPECIAL_ACTIONS); break;}
		  //case BUTTON_DOOR_KNOCK : {ShowContScreen(ACTION_DOOR_KNOCK, 0);  break;}
		  default : Message("something wrong"); break;
		}
	}
}


