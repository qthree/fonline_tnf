/**
 устанавливает у НПЦ новую домашнюю позицию
 param=1
 v0 - номер ENT маркера
*/
int SetHomePos(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	int m=0,hx=0,hy=0,d=0;
	npc.GetHomePos(m,hx,hy,d);
	Location @ loc = GetLocationByPid(v0, 0);
	if(not valid(loc)) {Log("Location not found"); return 0;}
	Map @ map = loc.GetMapByIndex(0);
	if(not valid(map)) {Log("Get map error or not found"); return 0;}
	map.GetEntireCoords(v0, 0, hx, hy);
	npc.SetHomePos(hx,hy,d);
	return 0;
}

