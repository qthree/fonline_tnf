#include "_macros.fos"
#include "stdlib_h.fos"
#include "stdlib_dialog.fos"

/*
Как использовать эти функции в диалогах?
Есть функции типа "d_" - Условия (Demand,Требования)
и функции типа "r_" - Результат (Result)
Вы выбираете понравившуюся вам функцию, и затем:

Тип "d_" :
 На вкладке "Условие":
 Выбираете пункт скрипт, и вписывайте в него,
 этот текст: "dialog@ИМЯ_ФУНКЦИИ" (например "dialog@d_IsToHeal").
 Если функция требует VAL, то в пункте "Значение условия" вписывайте ваше число.

Тип "r_" :
 На вкладке "Результат":
 Выбираете пункт скрипт, и вписывайте в него,
 этот текст: "dialog@ИМЯ_ФУНКЦИИ" (например "dialog@r_ShowLocation").
 Если функция требует VAL, то в пункте "Значение результата" вписывайте ваше число.

Номера локаций вы можете узнать в CITY.TXT и _maps.fos
Номера карт вы можете узнать в MAPS.TXT
Номера предметов вы можете узнать в ITEMPID.H

Иногда вы можете встретить тип "df_", "dx_", "rx_" - покачто они системные и недоступны.

*/

////////////////
// Demands /////
////////////////

//!/ НПЦ стоит на домашней позиции?
// это нужно чтобы например перса с квестом не увели куданибуть в темный угол и не вызвали в квесте баг.
bool d_NpcStayOnHomePos(Critter& player, Critter@ npc)
{
	uint16 m=0,x=0,y=0,d=0;
	npc.GetHomePos(m,x,y,d);
	if(m!=npc.GetMapId()) return false;
	if((x!=npc.HexX) && (y!=npc.HexY)) return false;
	return true;
}

//!/ Игрок нуждаеться в лечении?
bool d_IsToHeal(Critter& player, Critter@ npc)
{
	return player.Stat[ST_CURRENT_HP] < player.Stat[ST_MAX_LIFE];
}

//!/ Игроку известна эта локация?
// VAL - номер локации
bool d_IsLocationVisible(Critter& player, Critter@ npc, int val)
{
	return player.IsKnownLoc( false, uint16(val) );
}

//!/ Игроку НЕ известна эта локация?
// VAL - номер локации
bool d_IsLocationNotVisible(Critter& player, Critter@ npc, int val)
{
	return not player.IsKnownLoc( false, uint16(val) );
}

//!/ Есть зависимости от наркотиков?
bool d_IsAddict(Critter& player, Critter@ npc)
{
	for(uint i=ADDICTION_BEGIN;i<=ADDICTION_END;i++) if(player.Addiction[i]!=0) return true;
	return false;
}

//!/ У игрока нет зависимостей от наркотиков?
bool d_IsNotAddict(Critter& player, Critter@ npc)
{
	return not d_IsAddict(player,npc);
}

//!/ Random
// VAL - шанс выпадания.
// Например:
// 1 - один к одному, тоесть выпадать будет всегда
// 2 - один из двух. тоесть 50/50.
// 6 - шанс один из шести.
// 1000 - один раз из тысячи. тоесть очень очень редко.
bool d_Random(Critter& player, Critter@ npc, int val)
{
	return Random(1,val)==1;
}

//!/ Random с учетом удачи
// VAL - шанс выпадания минус удача.
// Чем выше удача тем больше шанс выпадания.
// Рекомендованные значение от 12 до 16.
// Например:
// VAL=10 & Luck=1 - один шанс из 9  - очень редко.
// VAL=10 & Luck=10 - один шанс из 1 - выпадать будет всегда.
// VAL=12 & Luck=1 - один шанс из 11 - очень редко.
// VAL=12 & Luck=10 - один шанс из 2 - очень часто.
// VAL=16 & Luck=1 - один шанс из 15 - очень редко.
// VAL=16 & Luck=10 - один шанс из 6 - русская рулетка.
bool d_RandomWithLuck(Critter& player, Critter@ npc, int val)
{
	return Random(1,CLAMP(val-player.Stat[ST_LUCK], 1, 100))==1;
}

//!/ Random c процентом выпадания
// VAL - процент выпадания.
// Например:
// 5% - это пять процентов выпадания. выпадать будет редко.
// 50% - 50/50.
// 100% - это 100 процентов выпадания. выпадать будет всегда.
bool d_RandomPercent(Critter& player, Critter@ npc, int val)
{
	val=CLAMP(val,0,100);
	return Random(1,100)<=val;
}

//!/ Возвращает размер группы (живых ее участников)
// размер береться вне зависимости от того лидер это или просто партиец
int df_GroupCount(Critter& player, Critter@ npc)
{
	Critter @ leader;
	if (not valid(player.GetFollowLeader())) // если у игрока нет лидера
		@leader = player; // тогда считаем что он и есть лидер
		else
		@leader = player.GetFollowLeader(); // иначе берем лидера

	Critter@[] groups;
	ArrayPushBack(groups,leader);
	leader.GetFollowGroup(FIND_LIFE,groups);
	return groups.length();
}

//!/ Размер группы больше >=VAL
bool d_GroupCountMore(Critter& player, Critter@ npc, int val)
{
	return df_GroupCount(player, npc)>=val;
}

//!/ Размер группы меньше <=VAL
bool d_GroupCountLess(Critter& player, Critter@ npc, int val)
{
	return df_GroupCount(player, npc)<=val;
}

//!/ Игрок в группе? (лидер тоже считаеться)
bool d_GroupPresent(Critter& player, Critter@ npc)
{
	return df_GroupCount(player, npc)>1;
}

//!/ Игрок НЕ в группе? (лидер тоже считаеться)
bool d_NotGroupPresent(Critter& player, Critter@ npc)
{
	return not d_GroupPresent(player, npc);
}

//!/ Игрок лидер группы?
bool d_IsGroupLeader(Critter& player, Critter@ npc)
{
	// если есть группа и у этого игрока нет лидера - то значит он и есть лидер группы
	if (d_GroupPresent(player, npc) and (not valid(player.GetFollowLeader())))
		return true; else
		return false;
}

//!/ Дистанция до НПЦ
// Проверка чтобы все игроки группы были от НПЦ на дистанции не меньше указанной в VAL.
bool d_GroupMinDistance(Critter& player, Critter@ npc, int val)
{
	Critter @ leader;
	if (not valid(player.GetFollowLeader())) // если у игрока нет лидера
		@leader = player; // тогда считаем что он и есть лидер
		else
		@leader = player.GetFollowLeader(); // иначе берем лидера

	Critter@[] groups;
	ArrayPushBack(groups,leader);
	leader.GetFollowGroup(FIND_LIFE,groups);
	for(uint i=0;i<groups.length();i++)
		if (int(GetDistantion(npc.HexX, npc.HexY, groups[i].HexX, groups[i].HexY)) > val)
		// ктото ходит слишком далеко от НПС
			return false;
	// цикл прошел - значит все стоят рядом.
	return true;
}

//!/ инверсия d_GroupMinDistance
bool d_NotGroupMinDistance(Critter& player, Critter@ npc, int val)
{
	return not d_GroupMinDistance(player, npc, val);
}

//!/ сумма уровней в группе
int df_GroupLevelSum(Critter& player, Critter@ npc)
{
	int result=0;
	Critter@[] groups;
	ArrayPushBack(groups,player);
	player.GetFollowGroup(FIND_LIFE,groups);
	for(uint i=0;i<groups.length();i++)
		result+=groups[i].Stat[ST_LEVEL];
	return result;
}

//!/ сумма уровней группы больше >=VAL
bool d_GroupLevelSumMore(Critter& player, Critter@ npc, int val)
{
	return df_GroupLevelSum(player, npc)>=val;
}

//!/ сумма уровней группы меньше <=VAL
bool d_GroupLevelSumLess(Critter& player, Critter@ npc, int val)
{
	return df_GroupLevelSum(player, npc)<=val;
}

//!/ У всех уровень больше >=VAL
// Проверка что все игроки в группе больше или равны указанному уровню.
bool d_GroupLevelMore(Critter& player, Critter@ npc, int val)
{
	Critter@[] groups;
	ArrayPushBack(groups,player);
	player.GetFollowGroup(FIND_LIFE,groups);
	for(uint i=0;i<groups.length();i++)
		if(groups[i].Stat[ST_LEVEL]<val) // если хотябы один из них меньше требуемого уровня
			return false;
	return true;
}

//!/ У когото уровень меньше <=VAL
// Проверка что все игроки в группе меньше или равны указанному уровню.
bool d_GroupLevelLess(Critter& player, Critter@ npc, int val)
{
	Critter@[] groups;
	ArrayPushBack(groups,player);
	player.GetFollowGroup(FIND_LIFE,groups);
	for(uint i=0;i<groups.length();i++)
		if(groups[i].Stat[ST_LEVEL]>val) // если хотябы один из них больше требуемого уровня
			return false;
	return true;
}

//!/ У игрока этот тип броника?
// VAL - требуемый тип брони
bool d_IsArmor(Critter& player, Critter@ npc, int val)
{
	return ItemToProt(_CritGetItemArmor(player)) == val;
}

//!/ На игрока не надет этот тип брони?
// инверсия d_IsArmor
bool d_IsNotArmor(Critter& player, Critter@ npc, int val)
{
	return not d_IsArmor(player, npc, val);
}

/** проверка на таймаут
 используйте функцию r_TimeOutSet для инициализации
 если таймаут кончился (или еще и не начинался)
 то функция вернет истинну (разрешит ответ)
 иначе вернет ложь (ответ будет скрыт)
*/
bool d_TimeOutCheck(Critter& player, Critter@ npc)
{
	GameVar @ t = GetLocalVar(LVAR_timeout, npc.Id);
	if(not valid(t)) return true; // таймаут еще и не начался
	if(__FullMinute >= uint(t.GetValue()))
		return true; // таймаут истек
		else
		return false; // таймаут еще жив
}

/**
  инверсия d_TimeOutCheck
*/
bool d_NotTimeOutCheck(Critter& player, Critter@ npc)
{
	return not d_TimeOutCheck(player, npc);
}

/** Есть машина у игрока?
 !!! НУЖНА НОРМАЛЬНАЯ РЕАЛИЗАЦИЯ !!!
 сначала ищет ключ от машины.
 затем делает проверку на существование на этой карте подходящей машины (если это вообще возможно...).
*/
bool d_CarIsPresent(Critter& player, Critter@ npc)
{
	return _CritCountItem(player, PID_KEY)>0;
}

//!/ Есть машина у когото из группы игроков?
