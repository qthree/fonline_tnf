	bool LoadInventory(CritterCl@ choo)
	{
		//CritterCl @ choo = GetChosen();
		if(choo is null) return false;

		ItemCl@[] invItems;
		ItemCl@[] invItems_temp;
		choo.GetItems(-1, invItems);
		
		InventoryItem[] tempInvItems = InventoryItems;

		InventoryItems.resize(0);
		
		uint16 itemsLen = invItems.length();
		uint[] ids;
		uint16[] count;
		uint16[] protos;
		
		if(itemsLen <= 0){
			Message("У вас нет вещей в сумке.");
			HideScreen(CLIENT_SCREEN_INVENTORY_TNF, 0, 0, 0);
			return false;
		}

		for(uint16 i = 0;  i < itemsLen; ++i)
		{
			uint16 protoIndex = uint16(protos.find(invItems[i].GetProtoId()));
			if(protoIndex != uint16(-1))
			{
				protos.insertAt(protoIndex, invItems[i].GetProtoId());
				ids.insertAt(protoIndex, invItems[i].Id);
				count.insertAt(protoIndex, invItems[i].GetCount());
				invItems_temp.insertAt(protoIndex, invItems[i]);
			}

			else
			{
				protos.insertLast(invItems[i].GetProtoId());
				ids.insertLast(invItems[i].Id);
				count.insertLast(invItems[i].GetCount());
				invItems_temp.insertLast(invItems[i]);
 			}

			//ItemCl @ test = GetItem(invItems[i].Id);
			//if(test !is null) Message("successful");

		}

		ids.insertLast(uint16(-1)); //temp
		protos.insertLast(uint16(-1));
		count.insertLast(uint16(-1));

		uint16 whileI = 0,
		       protoId = 0;
		       
		uint idsLen = ids.length();
		       
		ItemCl@[] tempItem;
		uint[] tempIds;
		uint16[] tempCounts;
		uint16 tempProto;
		       
		while(idsLen > 1)
		{
			protoId = protos.length() > 0 ? protos[0] : 0;

			while(protoId == protos[0] && idsLen > 0)
			{
				tempIds.insertLast(ids[0]);
				tempCounts.insertLast(count[0]);
				tempProto = protos[0];

				tempItem.insertLast(invItems_temp[0]);

				protos.removeAt(0);
				ids.removeAt(0);
				count.removeAt(0);
				invItems_temp.removeAt(0);
				
				idsLen = ids.length();

			};

			InventoryItem tempInvItem(tempIds, tempCounts, GetMsgStr(TEXTMSG_ITEM,tempProto*100), tempItem);
			
			InventoryItems.insertLast(tempInvItem);

			tempItem.resize(0);
			tempIds.resize(0);
			tempCounts.resize(0);
			tempProto = 0;

		};
		return true;
	}
	
	/*	derpecated code
	 * 
		*/
		
	bool ShowList(uint16 fromIndex)
	{
		uint16 	itemsLen = InventoryItems.length(),
			counter = 0;

		bool singleItem = true;

		uint16 itemsCount = 0,
		       index = fromIndex;
		string name = "";
		string slot = "";
			
		uint spriteHash = 0;
			
		for(uint16 i = 0; i < INVENTORY_ITEMS_LIST_COUNT; ++i)
		{
			itemsCount = 0;
			spriteHash = 0;
			singleItem = true;
			index = i + fromIndex;
			name = "";
			slot = "";
			//if(index >= INVENTORY_ITEMS_LIST_COUNT) continue;

			if(index < itemsLen)
			{
				if(GroupType != INVENTORY_GROUP_NOP)					//group sort
				{
					if(GroupType != InventoryItems[index].tempItem[0].GetType())
					{
						InventoryButtons[i].InvItemIndex = uint16(-1); //InvItemIndex = uint16(-1) == no draw
						ItemPreview[i].SetPic(0);
						
						//InventoryItemButton tempInvBtn = InventoryButtons[index];
						//InventoryButtons.removeAt(index);
						//InventoryButtons.insertLast(tempInvBtn);

						
						continue;
						//--i;
					}
				}

				slot += GetSlotName(index);
				itemsCount += GetCountName(index);

				if(itemsCount <= 0){
				    InventoryButtons[i].InvItemIndex = uint16(-1);
				    //InventoryItems[index].tempItem.removeAt(0); 
				    ItemPreview[i].SetPic(0);
				    continue;
				}

				string namePrefix = GetPrefixName(index);
				InventoryItems[index].Text0 = namePrefix+" ";

				InventoryItems[index].Text1 = slot+" x"+itemsCount;
				FormatText(InventoryItems[index].Text0+InventoryItems[index].Name, InventoryItems[index].Text1, InventoryButtons[i].Options, FONT_FALLOUT, 0, InventoryItems[index].TextW0, InventoryItems[index].TextW1);
				
				spriteHash = (InventoryItems[index].tempItem[0] !is null ? InventoryItems[index].tempItem[0].Proto.PicInv : 0);
				ItemPreviewBtm.SetPos(0, ItemPreview[i].Options.GetPosY());
			}

			name = (name == "" ? DEBUG_ITEM_INV_NAME/*"no item"*/ : name);//(InventoryItems[i].Child ? InventoryItems[i].Count : itemsCount);
			if(InventoryButtons[i] is null) {Message("null button"); continue;}

			InventoryButtons[i].InvItemIndex = (index < itemsLen ? index : uint16(-1));
			
			ItemPreview[i].SetPic(spriteHash);

			++counter;
		}
		
		FormatFreeButtons();
		return true;
	}
	
	void ShowListWear(){
		uint itemsLen = InventoryItems.length();
		
		InventoryButtonsWear[SLOT_HAND1-1].InvItemIndex = uint16(-1);
		InventoryButtonsWear[SLOT_HAND2-1].InvItemIndex = uint16(-1);
		InventoryButtonsWear[SLOT_ARMOR-1].InvItemIndex = uint16(-1);
	  
		for(uint i = 0; i < itemsLen; ++i){
			if(InventoryItems[i] !is null && InventoryItems[i].WearSlot != SLOT_INV){
				uint index = InventoryItems[i].WearSlot-1;
				
				//Message("indx "+index+" "+i);
			  
				if(index >= InventoryButtonsWear.length() || InventoryButtonsWear[index] is null) continue;
				
				InventoryButtonsWear[index].InvItemIndex = i;
				//FormatText(InventoryItems[i].Text0+InventoryItems[i].Name, InventoryItems[i].Text1, InventoryButtonsWear[index].Options, FONT_FALLOUT, 0, InventoryItems[i].TextW0, InventoryItems[i].TextW1);
				//SetNamePostfix(InventoryButtonsWear[index], InventoryItems[i], i);
			}
		}
	}
	
	void SetNamePostfix(InventoryItemButton& invButt, InventoryItem& invItem, uint index){
	  
		string name = "";
		string slot = "";
		
		uint16 itemsCount = 0;
		
		slot += GetSlotName(index);
		itemsCount += GetCountName(index);

		if(itemsCount <= 0){
		invButt.InvItemIndex = uint16(-1);
		invItem.tempItem.removeAt(0); return;}

		string namePrefix = GetPrefixName(index);
		invItem.Text0 = namePrefix+" ";

		invItem.Text1 = slot+" x"+itemsCount;
		FormatText(invItem.Text0+invItem.Name, invItem.Text1, invButt.Options, FONT_FALLOUT, 0, invItem.TextW0, invItem.TextW1);
	}

	string GetSlotName(uint16 index){

		string slotName = "";
		for(uint16 ii = 0, jj = InventoryItems[index].Id.length(); ii < jj; ++ii){
			if(InventoryItems[index].tempItem[ii].CritSlot != 0)
			{
				switch(InventoryItems[index].tempItem[ii].CritSlot){
					case SLOT_ARMOR : slotName += "A "; break;
					case SLOT_HAND1 : slotName += "L "; break;
					case SLOT_HAND2 : slotName += "R "; break;
					default : break;
				}
			}
		}

		return slotName;
	}

	string GetPrefixName(uint16 index){

		string prefixName = "";

		if(!InventoryItems[index].Child){
			if(InventoryItems[index].Id.length() > 1){
				if(InventoryItems.length() > index+1 && InventoryItems[index+1].Child){
					prefixName += "-";
				}else{
					prefixName += "+";
				}
			}else{
				prefixName += "*";
			}
		}else{
			prefixName += "\\--";
		}

		return prefixName;
	}

	int GetCountName(uint16 index){
		bool singleItem = true;

		int itemsCount = 0;

		for(uint16 ii = 0, jj = InventoryItems[index].Id.length(); ii < jj; ++ii){
			itemsCount += InventoryItems[index].Count[ii];

			if(index > 0 && itemsCount != InventoryItems[index].Count[0]) singleItem = false;
		}

		InventoryItems[index].Rolled = !singleItem;

		return itemsCount;
	}
	
	void FormatFreeButtons(){
	  
		uint16[] indexs;
	  
		for(uint i = 0; i < INVENTORY_ITEMS_LIST_COUNT; ++i){
			if(InventoryButtons[i].InvItemIndex != uint16(-1)){
				indexs.insertLast(InventoryButtons[i].InvItemIndex);
			}
		}
		
		uint16 invIndex = 0;
		
		for(uint i = 0, j = indexs.length(); i < INVENTORY_ITEMS_LIST_COUNT; ++i){
			
			if(i>=j){
				invIndex = uint16(-1);
			}else{
				invIndex = indexs[i];
			}
			
			InventoryButtons[i].InvItemIndex = invIndex; 
		}
	}

	void UpdateTree(uint16 index){
		uint16 j = InventoryItems[index].Id.length();
		if(index < InventoryItems.length() && index >= 0){
			for(uint16 i = index; i < index+j; ++i){
				//string slot = GetSlotName(index);
				//uint itemsCount = GetCountName(index);
				//string namePrefix = GetPrefixName(index);

				//InventoryItems[index].Text1 = slot+" x"+itemsCount;
				//FormatText(InventoryItems[index].Text0+InventoryItems[index].Name, InventoryItems[index].Text1, InventoryButtons[i].Options, FONT_FALLOUT, 0, InventoryItems[index].TextW0, InventoryItems[index].TextW1);
				SetNamePostfix(InventoryButtons[i], InventoryItems[index], index);
			}
		}
	}

	void UpdateList(){
		uint16 	index = InventoryButtons[0].InvItemIndex,
			itemsLen = InventoryItems.length();

		if(index >= 0){
			for(uint8 i = 0; i < INVENTORY_ITEMS_LIST_COUNT; ++i){

				index = InventoryButtons[i].InvItemIndex;

				if(index/*+INVENTORY_ITEMS_LIST_COUNT*/ >= itemsLen) break;

				if(!InventoryItems[index].Child && index+1 < itemsLen && InventoryItems[index+1].Child){
					UpdateTree(index);
				}

			}

		}
	}

	void FormatFreeSpace(){

		uint16 index = InventoryButtons[0].InvItemIndex,
			realBtn = 0;

		for(uint16 i = 0; i < INVENTORY_ITEMS_LIST_COUNT-1; ++i){


			if(InventoryButtons[i].InvItemIndex != uint16(-1) && InventoryButtons[i+1].InvItemIndex == uint16(-1)){
				realBtn++;
				//Message("btn0 "+realBtn+" i "+i);
			}else{
				if(i != 0 && realBtn != 0 && InventoryButtons[i+1].InvItemIndex != uint16(-1)){
				InventoryButtons[i-realBtn].InvItemIndex = InventoryButtons[i+1].InvItemIndex;
				}
			}
		}
	}

	void MoveNoItemToLast(){
	    for(uint16 i = 0; i < INVENTORY_ITEMS_LIST_COUNT-1; ++i){
	        if(InventoryButtons[i].InvItemIndex == uint16(-1)){
	            for(uint16 ii = i; ii < INVENTORY_ITEMS_LIST_COUNT-2; ++ii){
	                if(InventoryButtons[ii+1].InvItemIndex != uint16(-1))
	                InventoryButtons[ii].InvItemIndex = InventoryButtons[ii+1].InvItemIndex;
	            }
	        }
	    }
	}

	void SelectItem(uint8 index)
	{
		uint16 	itemsLen = InventoryItems.length(),
			realIndex = 0;
			
		InventoryItemButton@[]@ tempInvBtns;
		
		uint16 prIndex = 0;
		
		if(ListSelected){@tempInvBtns = InventoryButtons; prIndex = prevIndex;}else{@tempInvBtns = InventoryButtonsWear; prIndex = prevIndexWear;}
		
		//Message("len "+tempInvBtns.length());

		if(index >= itemsLen || tempInvBtns[index].InvItemIndex == uint16(-1)) return;
		//if(prevIndex != uint8(-1)) InventoryButtons[prevIndex].PressPic(false);
		//if(prevIndexWear != uint8(-1)) InventoryButtonsWear[prevIndexWear].PressPic(false);
		
		if(prIndex != uint8(-1)) {tempInvBtns[prIndex].PressPic(false);}
		
		/*if(ListSelected != ListSelectedPr) {
		  if(ListSelected){InventoryButtonsWear[prIndex].PressPic(false);Message("list");}else{InventoryButtons[prIndex].PressPic(false);Message("!list");}
		}*/
		
		if(ListSelected) {prevIndex = index;}else{prevIndexWear = index;}
		
		if(index != uint8(-1)) tempInvBtns[index].PressPic(true);

		realIndex = tempInvBtns[index].InvItemIndex;

		if(realIndex < InventoryItems.length())
		{
				uint spriteHash = (InventoryItems[realIndex].tempItem[0] !is null ? InventoryItems[realIndex].tempItem[0].Proto.PicInv : 0);
				string descText = (InventoryItems[realIndex].tempItem[0] !is null ? item_description(InventoryItems[realIndex].tempItem[0], ITEM_LOOK_INVENTORY) : "invalid item"); //GetMsgStr(TEXTMSG_ITEM,InventoryItems[index].tempItem[0].GetProtoId()*100+1)
				//Message(" "+spriteHash);
				ItemShow.Pic(spriteHash);
				ItemDesc.Text(descText);
				
				for(uint8 i = 0, j = ItemActions.length(); i < j; ++i){
					
					ItemActions[i].SetPos(tempInvBtns[index].Options.GetPosX(), tempInvBtns[index].Options.GetPosY());
				}
		}
	}

