class CRegisterArchivePic : IGUIElementCallbackInit
{

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterArchivePic(CRegisterScreen& instance){

            @Instance = instance;
            @Instance.ArchivePic = this;

        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void Switch(uint8 index){
            string sprName = "";

            switch(index){
                case 0 : sprName = "perksfdr.frm"; break;
                case 1 : sprName = "karmafdr.frm"; break;
                case 2 : sprName = "killsfdr.frm"; break;
            }

            Options.UpPic(sprName);

            //Options.Switch(IsSet);
        }
}

class CRegisterArchiveMask : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{

        uint8 Index;

        CRegisterScreen@ Instance;
        IGUIElementOpt@ Options;

        CRegisterArchiveMask(CRegisterScreen& instance, uint8 index){

            Index = index;

            @Instance = instance;
            @Instance.ArchiveMask[Index] = this;

        }

        void OnMouseClick(int click){

            if(Index == 2 && Instance.Param[QST_GAMEMODE] != GAME_ADVENTURE) {return;}   //gamemode

            Instance.ShowArchive(Index);
            //Message("index "+Index);

        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnDraw(){

            int x = Options.GetPosX(), y = Options.GetPosY();

            string text = "";

            switch(Index){
                    case 0 : text = "Инф"; break;
                    case 1 : text = "Осб"; break;
                    case 2 : text = "Доп"; break;
                    default: text = "иди нах#й попраошайка!"; break;
            }

            uint color = COLOR_SAND;
            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE || (Instance.Param[QST_GAMEMODE] == GAME_SURVIVAL && Index == 2)) {color = COLOR_LGRAY;}   //gamemode

            DrawText(""+text, x+345, y+314, 200 , 40, color, FONT_BIG,  0);
        }
}

