/**
 сказать
 Ищет ENT=v0
 НПС который стоит на нем говорит строку номер v1
 param=2
*/
int SayEnt(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	if(not player.IsPlayer()) return 0;
	uint _x=0,_y=0;
	if(player.GetMap().GetEntireCoords(v0, 0, _x, _y))
	{
