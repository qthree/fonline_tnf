    void LoadAnimationIndex(uint16 index)
    {
        string@[] @ temp_anim = split( GetMsgStr( TEXTMSG_GAME, index ), " " );
        string@[] @ temp_crtype = split( GetMsgStr( TEXTMSG_GAME, index+1 ), " " );

        uint8 len_anim = temp_anim.length();

        if( len_anim != temp_crtype.length() )
        {
            Message( "Length of critter types not equel, Send this message to developers" );
            return;
        }

        crTypes.resize( 0 );
        animIndex.resize( 0 );

        int temp = 0;
        for( uint8 i = 0; i < len_anim; i++ )
        {
            animIndex.insertLast( temp_anim[ i ] );
            StrToInt( temp_crtype[ i ], temp );
            crTypes.insertLast( temp );

            // Message(""+crTypes[i]+" "+temp_crtype[i]);
            // Message(""+crTypes[i]);
        }
    }


    void DropSelectSkin(){
        uint16 genderIndex = 0;//Param[ST_GENDER];//STR_CRTYPE_MALE + (GenderSelectBtn.GetGender() * 2);
        LoadAnimationIndex(genderIndex);
        SetSkinImage( 0, 3 );
    }

    void SendInfo(){

        /*for(uint8 i = 0; i < 10; ++i){

            int[] test(100);

            for(uint8 j = 0; j < 100; ++j){
                test[j] = Param[j+(i*100)];
            }*/

            RunServerScriptUnsafe("general_unsafe@unsafe_regchar", 0, 0, 0, null, Param);//Param);
        //}
    }
}

