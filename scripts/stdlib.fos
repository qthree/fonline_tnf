/**
 выставка времени таймаута
 param=1
 v0 - новое значение таймаута в игровых минутах
 используйте функцию d_TimeOutCheck для проверки истечения времени

 На ветку которая выдает квест вешаем условие: d_TimeOutCheck().
 Затем в момент выдачи квеста вызываем: r_TimeOutSet(2).
 Это означает что ветка будет недоступна два игровых часа.
 Функциями TimeOutSub и TimeOutAdd можно влиять на запущенный таймаут.
 Таймаут у каждого НПЦ свой личный.
*/
int TimeOutSet(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	GameVar @ t = GetLocalVar(LVAR_timeout, npc.Id);
	if(not valid(t)) return FALSE; // чтото пошло не так
	t = __FullMinute + v0;
	return TRUE;
}

/** уменьшение таймаута на v0 минут
 param=1
 v0 - число
*/
int TimeOutSub(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	GameVar @ t = GetLocalVar(LVAR_timeout, npc.Id);
	if(not valid(t)) return FALSE; // чтото пошло не так
	t -= v0;
	return TRUE;
}

/** увеличение таймаута на v0 минут
 param=1
 v0 - число
*/
int TimeOutAdd(uint8 runType,Critter@ player,int x,int y,int dir,Critter@ npc,Scenery@ scenery,Item@ item,int v0, int v1, int v2, int v3, int v4,int skill,Item@ itemUsed)
{
	GameVar @ t = GetLocalVar(LVAR_timeout, npc.Id);
	if(not valid(t)) return FALSE; // чтото пошло не так
	t += v0;
	return TRUE;
}

