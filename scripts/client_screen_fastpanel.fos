class FastButtonLayer : IGUIElementCallbackInit, IGUIElementCallbackMouseClick
{
    IGUIElementOpt@ Options;
    uint8           Type;

    FastButtonLayer(uint8 type){
        Type = type;
        @panel.LayerBtn[Type] = this;
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
    }

    void OnMouseClick( int click )
    {
        if( GetCurrentCursor() == CURSOR_DEFAULT && click == MOUSE_CLICK_LEFT )
        {
            int8 layer = panel.Layer;
            layer = ( Type > 0 ? layer - 1 : layer + 1 );
            if( layer < 0 )
                layer = PANEL_LAYER_COUNT-1;
            if(layer >= PANEL_LAYER_COUNT)
                layer = 0;
            //layer = ChangeLayer( layer );
            panel.Layer = layer;
        }
    }
}

class FastCell
{

    //bool            Visible;

    uint8           Id;

    uint8           Type;
    uint8           SubType;

    uint            PanelId;

    string          Text;
    string          Desc;

    string          SpriteUp;
    string          SpriteDown;

    //SPACE_TOKEN + fastPanelBtns[ i ].GetFastPanelType() + SPACE_TOKEN + fastPanelBtns[ i ].GetFastPanelId() + SPACE_TOKEN + fastPanelBtns[ i ].GetText() + SPACE_TOKEN + f[ i ].GetDescription()

    FastCell(uint8 id){

            Id = id;

            Type = 0;
            SubType = 0;

            PanelId = 0;

            Text = "";
            Desc = "";

            //Visible(false);
            //SpriteUp = "";
            //SpriteDown = "";
            SpriteUp =  "fastpanel_btblank_up.png";
            SpriteDown =  "fastpanel_btblank_dn.png";
    }

    void SetCell(uint8 id, uint8 type, uint8 subType, uint panelId, string text, string desc, string spriteUp, string spriteDown){

        if(id != uint8(-1)) Id = id;

        Type = type;
        SubType = subType;
        PanelId = panelId;

        Text = text;
        Desc = desc;

        SpriteUp = spriteUp;
        SpriteDown = spriteDown;
    }

    void SetMember(uint8 mmrIndex, string val){

        int temp = 0;

        if(mmrIndex < 4){
            StrToInt(val, temp);
        }

        switch(mmrIndex){

            case 0 : Id = temp; break;
            case 1 : Type = temp; break;
            case 2 : SubType = temp; break;
            case 3 : PanelId = temp; break;

            case 4 : Text = val; break;
            case 5 : Desc = val; break;
            case 6 : SpriteUp = val; break;
            case 7 : SpriteDown = val; break;

            default : return;
        }
    }

}

class FastPanel
{
    uint8 Layer;
    uint8 ButtonLast;

    FastCell@[] Cells;
    FastButton@[]   Buttons;
    FastButton@[]   Pockets;

    FastButtonLayer@[] LayerBtn;
    FastButtonLayerDisplay@ LayerDsp;

    FastPanel(){
        Layer = 0;

        Buttons.resize(PANEL_BUTTON_COUNT);
        Cells.resize(PANEL_CELL_COUNT+PANEL_POCKET_COUNT);
        Pockets.resize(PANEL_POCKET_COUNT);

        LayerBtn.resize(2);
    }

    void CellsClear(){
        //Cells.resize(0);
        //Cells.resize(PANEL_CELL_COUNT+PANEL_POCKET_COUNT);
        for(uint8 i = 0, j = Cells.length(); i<j; ++i){
            @Cells[i] = FastCell(i);
        }
    }

    void ShowPanel(bool show){
        for(uint8 i = 0, j = Buttons.length(); i<j; ++i){
            Buttons[i].Options.SetVisible(show);
        }

        /*for(uint8 i = 0, j = Pockets.length(); i<j; ++i){
            Pockets[i].Options.SetVisible(show);
        }*/

        LayerBtn[0].Options.SetVisible(show);
        LayerBtn[1].Options.SetVisible(show);

        LayerDsp.Options.SetVisible(show);
    }

    //bool SetCell(uint8 index, )

    //void
}

class FastButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick, IGUIElementCallbackDraw
{
    uint8           Type;
    uint8           SubType;
    uint8           ButtonNum;
    IGUIElementOpt@ Options;
    FastPanel@      Panel;
    Sprite          Sprite;

    FastButton(uint8 num){
        //@Panel = panel_;

        Type = 0;
        SubType = 0;
        ButtonNum = num;

        if(num >= PANEL_BUTTON_COUNT){
            @panel.Pockets[0] = this;
        }else{
            @panel.Buttons[num] = this;
        }
    }

    void OnInit()
    {
        @Options = GUI_GetElementOptions();
    }

    void OnMouseClick( int click )
    {

        uint8 cellId = (panel.Layer * PANEL_BUTTON_COUNT + ButtonNum);

        if(cellId < 0 || cellId >= PANEL_CELL_COUNT) {Message("out");return;}

        panel.ButtonLast = ButtonNum;

        Message(" "+panel.Cells[cellId].PanelId + " " + panel.Cells[cellId].Type);

        if( GetCurrentCursor() == CURSOR_DEFAULT )
        {
            // Message(""+Options.GetBtnNum());
            //if( Options.GetFastPanelId() == 0 && Options.GetFastPanelType() == 0 )
            if(panel.Cells[cellId].PanelId == 0 && panel.Cells[cellId].Type == 0 )
            {
                __subMenuNum = SUBMENU_FASTPANEL;
//                __fastpanelButtNum = Options.GetBtnNum();
                //@lastFastButton = this;
                //@lastPanelButton = Options;
                ::ShowScreen( CLIENT_SCREEN_CONTMENU, 300, 300, SUBMENU_FASTPANEL );
            }
            else
            {
                if( click == MOUSE_CLICK_RIGHT )
                {
                    panel.Cells[cellId].SpriteUp = "fastpanel_btblank_up.png";
                    panel.Cells[cellId].SpriteDown = "fastpanel_btblank_dn.png";
                    panel.Cells[cellId].Text = "";//, FONT_FALLOUT, COLOR_SAND, COLOR_GREEN, FT_CENTERX | FT_CENTERY );
                    panel.Cells[cellId].Desc = "";
                    panel.Cells[cellId].Type = 0;
                    panel.Cells[cellId].PanelId = 0;
                    //SaveFastPanel( false );
                    SavePanel20();
                }
                else if( click == MOUSE_CLICK_LEFT )
                {
                    switch(panel.Cells[cellId].Type)
                    {
                    case PANEL_TYPE_SKILL:
                        __skillIndex = panel.Cells[cellId].PanelId;
                        __fastPanel = true;
                        Message("skill "+__skillIndex);
                        ChangeCursor( CURSOR_USE_SKILL );
                        break;
                    case PANEL_TYPE_SAY:
                        if( panel.Cells[cellId].PanelId != 5 )
                        {
                            RunServerScriptUnsafe( "general_unsafe@unsafe_fastpanel_say", panel.Cells[cellId].PanelId, 0, 0, panel.Cells[cellId].Desc, null );
                            break;
                        }
                        else
                        {
                            out_message( panel.Cells[cellId].Desc, int( panel.Cells[cellId].PanelId ) );
                            break;
                        }
                    case PANEL_TYPE_POCKET :
                            RunServerScriptUnsafe( "general_unsafe@unsafe_fastpanel_pocket", int(panel.Cells[PANEL_CELL_COUNT+ButtonNum].PanelId), 0, 0, null, null );
                            break;
                    }
                }
            }

            //Sprite.Load(panel.Cells[cellId].SpriteDown, PT_ART_INTRFACE);
//                      Message("type = "+Options.GetFastPanelType()+" id = "+Options.GetFastPanelId());
        }
    }

    void OnDraw(){
        //Sprite.Load()
        uint8 cellId = (panel.Layer * PANEL_BUTTON_COUNT + ButtonNum);

        if(cellId < 0 || cellId >= PANEL_CELL_COUNT) return;

        uint color = GetColor(panel.Cells[cellId].PanelId);
        DrawText(panel.Cells[cellId].Text, Options.GetPosX()+110, Options.GetPosY()+640, Options.GetSurfaceWidth(), Options.GetSurfaceHeight(), color, FONT_FALLOUT, FT_CENTERX | FT_CENTERY );
    }
}

