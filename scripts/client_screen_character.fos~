class CCharacterInfoShow : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        bool IsSet;
        uint8 Index;
        uint16 ParamIndex;

        CCharacterScreen@ Instance;
        IGUIElementOpt@ Options;

        CCharacterInfoShow(CCharacterScreen& instance, uint8 index, uint16 paramIndex){

            IsSet = false;
            Index = index;
            ParamIndex = paramIndex;

            @Instance = instance;
            @Instance.InfoShow[Index] = this;

        }

        void OnMouseClick(int click){
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnDraw(){

            //string text = Instance.Param[ParamIndex];//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);
            //uint color = COLOR_GREEN;

            IsSet = (ParamIndex >= SKILL_BEGIN && Instance.Param[ParamIndex] != 0);

            uint color = (IsSet ? COLOR_GRAY : COLOR_GREEN);
            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

            uint statVal = (Instance.Param[ParamIndex]);
            if(ParamIndex == ST_CARRY_WEIGHT){
                statVal /= 1000;
            }

	    if(ParamIndex == ST_HUNGER || ParamIndex == ST_THRIST || ParamIndex == ST_DYSPNEA){statVal = 0;}

            int x = Options.GetPosX(), y = Options.GetPosY();
            int[] infoShowTextXY = {225, 363};

            infoShowTextXY = GetIniValues2("TnfRegInfoShowText", infoShowTextXY);

            //DrawText(""+statVal, x+325, y+314, 40 , 40, color, FONT_FALLOUT,  0);
            DrawText(""+statVal, x + infoShowTextXY[0], y + infoShowTextXY[1], 40 , 40, color, FONT_FALLOUT,  0);
        }

        void Switch(){
            //Options.Switch(IsSet);
        }

        void Visible(bool vis){
            Options.SetVisible(vis);
        }

        void SetParamIndex(uint16 paramIndex){
            ParamIndex = paramIndex;
            //Message("paramIndex "+ParamIndex);

            IsSet = (ParamIndex > SKILL_BEGIN && Instance.Param[ParamIndex] > 0);
        }
}

class CCharacterInfoDesc : IGUIElementCallbackMouseClick, IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        bool IsSet;
        uint8 Index;
        uint16 ParamIndex;

        CCharacterScreen@ Instance;
        IGUIElementOpt@ Options;

        CCharacterInfoDesc(CCharacterScreen& instance, uint8 index, uint16 paramIndex){

            Index = index;
            ParamIndex = paramIndex;

            IsSet = false;

            @Instance = instance;
            @Instance.InfoDesc[Index] = this;

        }

        void OnMouseClick(int click){
            Instance.SetHelp(ParamIndex);
        }

        void OnInit(){
            @Options = GUI_GetElementOptions();
        }

        void OnDraw(){

            if(ParamIndex == uint16(-1)) {return;}

            string text = GetMsgStr(TEXTMSG_GAME, (STR_STAT_FULL+ParamIndex)*10+1);//Text(Index != 7 ? Instance.Param[ParamIndex] : Instance.UnxpStat);

            IsSet = (ParamIndex == Instance.Param[TAG_SKILL1] || ParamIndex == Instance.Param[TAG_SKILL2] || ParamIndex == Instance.Param[TAG_SKILL3] || ParamIndex == Instance.Param[TAG_SKILL4]);//(ParamIndex >= SKILL_BEGIN && Instance.Param[ParamIndex] != 0);
	    
            uint color = (IsSet ? COLOR_GRAY : COLOR_GREEN);
            if(Instance.Param[QST_GAMEMODE] == GAME_ARCADE) {color = COLOR_LGRAY;}   //gamemode

            int x = Options.GetPosX(), y = Options.GetPosY();
            int[] infoDescTextXY = {225, 363};

            infoDescTextXY = GetIniValues2("TnfRegInfoDescText", infoDescTextXY);
	    
	    if(ParamIndex == ST_HUNGER || ParamIndex == ST_THRIST || ParamIndex == ST_DYSPNEA){
	      /*text += "\t\t\t";
	      for(uint8 i = 0, j = Instance.Param[ParamIndex] / 100 + 1; i<j; ++i){
		      text += " #";
	      }*/
	      DrawStatus(ParamIndex, x+infoDescTextXY[0], y+infoDescTextXY[1]);
	    }else{
	      DrawText(""+text, x+infoDescTextXY[0], y+infoDescTextXY[1], 200 , 40, color, FONT_FALLOUT,  0);
	    }
	    
        }
        
        void DrawStatus(uint stat, int x, int y){
	  CritterCl@ choo = GetChosen();
	    if(!(choo is null)){
		  uint8 proc = choo.StatBase[stat] * (stat != ST_DYSPNEA ? 0.1 : 1);
		  //thristProc = GetChosen().StatBase[ST_THRIST] * 0.1,
		  //dyspneaProc = GetChosen().StatBase[ST_DYSPNEA];
		  //DrawBar(int startX, int endX, int startY, uint8 proc, uint color0, uint color1, bool invertX, bool invertY)
		  //DrawBar(x, x+200, y, thristProc, 0, 0, false, false, "Жажда");

		  //if(dyspneaProc < 100){
			//DrawBar(x, x+200, y, dyspneaProc, COLOR_DBLUE, COLOR_WHITE, false, false, "Воздух");
		  //}
		  
		  uint color0 = COLOR_GREEN;
		  uint color1 = COLOR_GREEN;
		  
		  string text = "";

		  if(stat == ST_DYSPNEA){
		  ItemCl@ gasMask =choo.GetItem( 0, SLOT_HAND2 );
		  if(gasMask !is null && gasMask.GetProtoId() == 1399){
					uint8 gasMaskProc = gasMask.Indicator;
					if(gasMaskProc < 100){
						//DrawBar(20, 220, 90, gasMaskProc, COLOR_DBLUE, COLOR_GRAY, false, false, "Воздух");
						color0 = COLOR_DBLUE;
						color1 = COLOR_LGRAY;
						
						text = "Маска";
					}
		    }
		  }
		  
		  DrawBar(x, x+200, y, proc, color0, color1, false, false, "");
            }
	}
        
    void DrawBar(int startX, int endX, int startY, uint8 proc, uint color0, uint color1, bool invertX, bool invertY, string text){
	  int[] drawData;

    uint8 r0 = 0x15,
           g0 = 0x1F,
           b0 = 0x00,

           r1 = 0x67,
           g1 = 0x60,
           b1 = 0x00;

	   proc = CLAMP(proc, 0, 100);

	if(color0 != 0 && color1 != 0){
		uint8 a = 0;
		__GetColor(a, r0, g0, b0, color0);
		__GetColor(a, r1, g1, b1, color1);
	}

	uint16 tempY = (endX - startX) * (proc * 0.01);
	//Message("startY "+startY+" : "+tempY);
	//( ( EXPBAR_POS_Y - EXPBAR_LINE_END ) * ( allTime > 0 ? timeMod * 0.01 :  expMod * 0.01 ) );

    for( uint16 i = 0; i < tempY; ++i )
    {
        i += 3;

        drawData.insertLast( startX + i );
        drawData.insertLast( startY/* - i*/ );
        drawData.insertLast( COLOR_RGB( r0, g0, b0 ) );

        drawData.insertLast( startX /*+ 5*/ + i );
        drawData.insertLast( startY /*- i*/ + 5 );
        drawData.insertLast( COLOR_RGB( r1, g1, b1 ) );

        drawData.insertLast( startX/* + 5 */ + i);
        drawData.insertLast( startY/* - i*/ + 5 );
        drawData.insertLast( COLOR_RGB( r1, g1, b1 ) );

        drawData.insertLast( startX /*+ 8*/ + i );
        drawData.insertLast( startY /*- i*/ + 8 );
        drawData.insertLast( COLOR_RGB( r0, g0, b0 ) );


    }

   // DrawSprite( expbar.Id, -1, EXPBAR_POS_X - 42, EXPBAR_POS_Y - 210, 0 );
    DrawPrimitive( DRAW_PRIMITIVE_LINELIST, drawData );
     DrawText( ""+text, endX + 10, startY, 70, 10, COLOR_RGB( r1, g1, b1 ), FONT_FALLOUT, 0 );
}

        void Switch(){
            //Options.Switch(IsSet);
        }

        void Switch(bool set){
            Options.Switch(set);
        }

        void Visible(bool vis){
            Options.SetVisible(vis);
        }

        void SetParamIndex(uint16 paramIndex){
            ParamIndex = paramIndex;
            //Message("paramIndex "+ParamIndex);

            IsSet = (ParamIndex > SKILL_BEGIN && Instance.Param[ParamIndex] > 0);
        }
}

