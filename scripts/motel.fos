uint8 keyNumberLex = 0;

void r_SaleRoom(Critter& master, Critter@slave, int val)
{
  if(FreeRoomNumber(slave,false) != -1) 
  {
    SaleRoomAction(master, slave, val);
  }
}

bool d_FreeRooms(Critter& master, Critter@ slave)
{
  if(FreeRoomNumber(slave, false) != -1) {return true;}
  return false;
}

bool d_NoFreeRooms(Critter& master, Critter@ slave)
{
  if(FreeRoomNumber(slave, false) == -1) {return true;}
  return false;
}

int16 FreeRoomNumber(Critter@ npc, bool sale)
{
  Map @ map = npc.GetMap();
  if(!valid(map)) return -1;
  uint16 hexX = 0, hexY = 0;
  for (uint16 i = npc.StatBase[ST_NPC_ROLE]; i < npc.StatBase[ST_TEAM_ID]; i++)
  {
    if(map.GetEntireCoords(i, 0, hexX, hexY))
    {
      Item @ door = ValidDoor(map, hexX, hexY);
      if(door.Val3 == 0)
      {
	keyNumberLex = i - npc.StatBase[ST_NPC_ROLE] + 1;
	if(!sale)
	{
	  return npc.StatBase[ST_NPC_ROLE] + i;
	}
	else
	{
 	return door.Id;
	}
	
      }
    }
  }
  return -1;
}

Item@ ValidDoor(Map& map, uint16 hexX, uint16 hexY) //search needed proto 4 door
{
  string doorNum;
  int temp = 0;
  for(uint8 i = 0; i < DOOR_COUNT; i++)
  {
    doorNum = "DOOR_"+i;
    StrToInt(doorNum, temp);
    Item@ door = map.GetItem(hexX, hexY, temp);
    if(valid(door))
    {
//       door.LockerComplexity = DoorComplexity(i);
      return door;
    }
  }
  return null;
}
    
