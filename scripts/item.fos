void _InitGmPistol(Item& item, bool firstTime)
{
item.SetEvent(ITEM_EVENT_USE, "e_GmPistolUse");
}

bool e_GmPistolUse(Item& item, Critter& cr, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{
	if(item.GetProtoId()==PID_GM_PISTOL && cr.GetAccess()>=ACCESS_MODER)
	{
		cr.ShowScreen(SCREEN_SAY , 0, "item@GmPistolUseScreen");
		cr.StatBase[ST_VAR0] = item.Id;
	}
	return true;
}
 
void GmPistolUseScreen(Critter& player, uint answerI, string& answerS)
{
	Item @ item = GetItem(player.StatBase[ST_VAR0]);
	if(answerS.length() >0)
	{
		int number=0;
		StrToInt (answerS, number);
		item.Val1 = number;
		if (number == 100) {item.Val2 = 0; player.Say(SAY_NETMSG, "притягивание");}
		else if (number == 200) {item.Val2 = 1; player.Say(SAY_NETMSG, "прыжок к");}
		else if (number == 300) {item.Val2 = 2; player.Say(SAY_NETMSG, "обезвоживание");}
		else if (number == 400) player.RunClientScript("client_main@_showId", 1, 1, 1, null, null);
		Critter@ target=GetCritter(number);
		if (not valid(target) || item.Val2>1) return;

		Critter@ daddy=((item.Val2!=0)?target:player);
		Critter@ child=((item.Val2==0)?target:player);

		Map@ map=daddy.GetMap();
		if (not valid(map)) return;
		uint8 temp_dir = Random(0, 5);
		for(uint i=0; i<6; i++)
			{
			uint16 hexX = daddy.HexX, hexY = daddy.HexY;
			map.MoveHexByDir (hexX, hexY, (temp_dir+i)%6, 1);
			if(not map.IsHexPassed(hexX, hexY)) continue;
			child.TransitToMap(map.Id, hexX, hexY, 0);
			break;	
			}
	}
}

void _InitRPStuff(Item& item, bool firstTime)
{
item.SetEvent(ITEM_EVENT_USE, "e_RPStuffUse");
}
 
bool e_RPStuffUse(Item& item, Critter& cr, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{
		if(item.Val0 == 0)
		{
		cr.ShowScreen(SCREEN_SAY , 0, "item@RPStuffUseScreen");
		cr.StatBase[ST_VAR0] = item.Id;
		}
		else cr.Say(SAY_NETMSG, "уже заполненно");
	return true;
}
 
void RPStuffUseScreen(Critter& player, uint answerI, string& answerS)
{
if(answerS.length() != 0)
	{
	Item @ item = GetItem(player.StatBase[ST_VAR0]);
	uint16 itemPid=item.GetProtoId();

	switch(itemPid)
		{
		case PID_RPSTUFF1: item.SetLexems(""+ answerS); break;
		case PID_RPSTUFF2: item.SetLexems(""+ answerS); break;
		case PID_RPSTUFF3: item.SetLexems(""+ answerS); break;
		case PID_RPSTUFF4: item.SetLexems(""+ answerS); break;
		case PID_RPGUN1: item.SetLexems(""+ answerS); break;
		case PID_RPGUN2: item.SetLexems(""+ answerS); break;
		case PID_RPGUN3: item.SetLexems(""+ answerS); break;
		}

	item.Val0 = 1;
	item.Update();
	}
}

