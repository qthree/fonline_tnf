class DynamicTile
{
	uint16 HashNum;
	uint16 Reserved0;
	uint16 HexX, HexY;
	
	void Set(uint16 hs1, uint16 hs2, uint16 hexX, uint16 hexY)
	{
		HashNum=hs1;
		Reserved0=hs2;
		HexX=hexX; HexY=hexY;
	}
}

