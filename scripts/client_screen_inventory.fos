class ScreenSkills : IGUIScreenCallbackShow, IGUIScreenCallbackHide
{
	IGUIScreenOpt@ screenOpt;
	SkillIncreaser@ SkillInc;
	SkillSPCounter@ SkillCounter;
	SkillArray@[]	Skills;
	
	ScreenSkills()
	{
	}
	
	void OnShow(int p0, int p1, int p2)
	{
		@screenOpt=GUI_GetScreenOptions();
		int y = Skills[lastSkillId].Options.GetPosY();
		SkillInc.SetIncPos(lastSkillId, y);
	}
	
	void OnHide(int p0, int p1, int p2)
	{
		RemoveSkillChange();
	}
}

class SkillArray : IGUIElementCallbackInit, IGUIElementCallbackDraw, IGUIElementCallbackMouseClick
{
	IGUIElementOpt@ Options;
	ScreenSkills @ Instance;
	uint16 SkillIndex;
	uint16 AddValue;
	
	int TextW0;
	int TextW1;
	string Text0;
	string Text1;
	
	SkillArray(ScreenSkills& instance, uint16 skillIndex, uint16 addValue)
	{
		@Instance = instance;
		SkillIndex = skillIndex;
		AddValue = addValue;
	}
	
	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		@Instance.Skills[SkillIndex - SKILL_BEGIN] = this;
		AddValue = skillArrayValue[SkillIndex - SKILL_BEGIN];
		//Options.Text("",FONT_FALLOUT, COLOR_GREEN, COLOR_GREEN, FT_CENTERY);
		
		Text0 = GetMsgStr(TEXTMSG_GAME,  100000 + (SkillIndex * 10) + 1);
	}
	
	void OnMouseClick(int click)
	{
		lastSkillId = SKILL_END - SkillIndex;
		Instance.SkillInc.SetIncPos(SkillIndex, Options.GetPosY());
	}
	
	void OnDraw()
	{
		CritterCl @ choo = GetChosen();
		if(choo is null) return;
		
		Text1 = (choo.Skill[SkillIndex]+AddValue)+"%";
		FormatText(Text0, Text1, Options, FONT_FALLOUT, FT_CENTERY, TextW0, TextW1);
		
		int x = 0, y = 0, xOff = Instance.screenOpt.GetPosX() + Options.GetPosX(), yOff = Instance.screenOpt.GetPosY() + Options.GetPosY();
		DrawText(""+Text0, x+xOff, y+yOff, 640 , 480, COLOR_GREEN, FONT_FALLOUT, 0);
		DrawText(""+Text1, x+xOff+TextW0+TextW1, y+yOff, 640 , 480, COLOR_GREEN, FONT_FALLOUT, 0);
	}
}

class SkillIncreaser :  IGUIElementCallbackInit
{
	ScreenSkills@ Instance;
	IGUIElementOpt@ Options;
	SkillIncreaserButton@[] IncBtn;
	uint16 SkillIndex;
	
	SkillIncreaser(ScreenSkills& instance)
	{
		@Instance = instance;
	}
	
	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		@Instance.SkillInc = this;
		IncBtn.resize(2);
		SkillIndex = lastSkillId + SKILL_BEGIN;
	}
	
	void SetIncPos(uint16 skillIndex, int y)
	{
		//Message("skill in "+skillIndex);
		SkillIndex = skillIndex;
		Options.Position(Options.GetPosX(), y-SLIDER_YOFFSET);
		IncBtn[0].SetPos(y-SLIDER_YOFFSET+8);
		IncBtn[1].SetPos(y-SLIDER_YOFFSET+8);
	}
}

class SkillIncreaserButton : IGUIElementCallbackInit, IGUIElementCallbackMouseClick
{
	 ScreenSkills@ Instance;
	 IGUIElementOpt@ Options;
	 uint8 Type;
	 
	 SkillIncreaserButton(ScreenSkills& instance, uint8 type)
	 {
		@Instance = instance;
		Type = type;
	 }
	 
	 void OnInit()
	 {
		@Options = GUI_GetElementOptions();
		@Instance.SkillInc.IncBtn[Type] = this;
	 }
	 
	 void OnMouseClick(int click)
	 {
		Instance.SkillCounter.ChangeCounter(Instance.SkillInc.SkillIndex, Type > 0 ? false : true);
		isChangedSkills = true;
	 }
	 
	 void SetPos(int y)
	 {
		Options.Position(Options.GetPosX(), y+(Type > 0 ? 5 : -5));
	 }
}

class SkillSPCounter : IGUIElementCallbackInit
{
	 ScreenSkills@ Instance;
	 IGUIElementOpt@ Options;
	 uint16 SP;
	 
	 SkillSPCounter(ScreenSkills& instance)
	 {
		@Instance = instance;
	 }
	 
	 void OnInit()
	 {
		@Options = GUI_GetElementOptions();
		@Instance.SkillCounter = this;
		
		CritterCl@ choo = GetChosen();
		if(choo is null) return;
		
		SP = choo.StatBase[ST_UNSPENT_SKILL_POINTS];
		Options.Text(""+SP,FONT_BIG,COLOR_RED, COLOR_GREEN, FT_CENTERX|FT_CENTERY);
	 }
	 
	 int ChangeCounter(uint16 skill, bool increase)
	 {
		CritterCl@ choo = GetChosen();
		if(choo is null) return -4;
		
		uint8 valueMod = 1;
		uint16 skillValue = choo.Skill[skill] + Instance.Skills[skill - SKILL_BEGIN].AddValue;
		
		if(skillValue >= SKILL_MOD_0) valueMod = 2;
		if(skillValue >= SKILL_MOD_1) valueMod = 3;
		if(skillValue >= SKILL_MOD_2) valueMod = 4;
		if(skillValue >= SKILL_MOD_3) valueMod = 5;
		if(skillValue >= SKILL_MOD_4) valueMod = 6;
		
		if(SP < valueMod) {Message("Недостаточно очков навыка."); return -1;}
		if(!increase && Instance.Skills[skill - SKILL_BEGIN].AddValue <= 0) {Message("Нельзя понизить навык."); return -2;}
		if(skillValue >= SKILL_MAX) {Message("Нельзя повысить навык."); return -3;}
		
		Instance.Skills[skill - SKILL_BEGIN].AddValue += (increase ? 1 : -1);
		if(skillArrayValue[skill - SKILL_BEGIN] + (increase ? 1 : -1) >= 0) skillArrayValue[skill - SKILL_BEGIN] += (increase ? 1 : -1);
		SP += (increase ? valueMod : valueMod-(valueMod*2));
		
		Message(""+increase);
		
		Options.Text(""+SP,FONT_BIG,COLOR_RED, COLOR_GREEN, FT_CENTERX|FT_CENTERY);
		return 0;
	 }
	 
	 
}

