#include "_macros.fos"


void Warn(Critter& player, int param0, int param1, int param2)
{
Critter@ cr=GetCritter(param0);
if(valid(cr))
	{
	cr.ParamBase[ST_WARNINGS]+=1;
	uint WarnCount=cr.Param[ST_WARNINGS];
		cr.AddTimeEvent("Dialog",1,3,WarnCount);
	}
}

uint Dialog(Critter& cr, int identifier, uint& rate)
{
string str=rate;
cr.ShowScreen(SCREEN_DIALOGBOX, 1, "AnswerMe");
if(rate<3)cr.SayMsg(SAY_DIALOGBOX_TEXT,TEXTMSG_GAME,12930); else cr.SayMsg(SAY_DIALOGBOX_TEXT,TEXTMSG_GAME,12934);
cr.SayMsg(SAY_NETMSG,TEXTMSG_GAME,12931);
cr.Say(SAY_NETMSG,str);
cr.SayMsg(SAY_DIALOGBOX_BUTTON(0),TEXTMSG_GAME,12932);
if(rate>2)
	{
	cr.ToDead(COND_DEAD_EXPLODE, null); 
	return 0;
	}
return 7;
}

void AnswerMe(Critter& cr, uint answerI, string& answerS)
{
if(answerI==0)cr.EraseTimeEvents(3);
}