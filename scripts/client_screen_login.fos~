/*
char state

-1 - not plaid before
 0 - notactive / game_start
 1 - active
 2 - dead
*/

#define CHAR_STATE_MAX       (4)
#define CHAR_STATE_NOTPLAID  (0)
#define CHAR_STATE_NOTACTIVE (1)
#define CHAR_STATE_ACTIVE    (2)
#define CHAR_STATE_DEAD      (3)

class CLoginScreenCharInfo : IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        CLoginScreen@  Instance;
        IGUIElementOpt@ Options;

        string          CharName;
        string[]        SCharState;
        uint8           ICharState;

        CLoginScreenCharInfo(CLoginScreen& instance){
                @Instance = instance;

                SCharState.resize(CHAR_STATE_MAX);
                SCharState[CHAR_STATE_NOTPLAID] = "Не в игре";
                SCharState[CHAR_STATE_NOTACTIVE] = "Не акт.";
                SCharState[CHAR_STATE_ACTIVE] = "Жив.";
                SCharState[CHAR_STATE_DEAD] = "Мертв";

                ICharState = CHAR_STATE_ACTIVE;
        }

        void OnInit(){
                @Options = GUI_GetElementOptions();
                @Instance.CharInfo = this;
        }

        void OnDraw(){
            DrawText( CharName, Options.GetPosX()+290, Options.GetPosY()+247, 200, 200, COLOR_RED, FONT_FALLOUT, 0 );
            DrawText( SCharState[ICharState], Options.GetPosX()+550, Options.GetPosY()+247, 100, 200, COLOR_RED, FONT_FALLOUT, 0 );
        }

        void SetCharState(uint8 state){
            ICharState = state;
        }

        void SetCharName(string name){
            CharName = name;
        }
/*
        void Visible(){
            Options.SetVisible(!Options.GetVisible());
        }*/
}



class CLoginScreen : IGUIScreenCallbackShow, IGUIScreenCallbackHide, IGUIScreenCallbackMove, /*IGUIElementCallbackInit,*/ IGUIElementCallbackKeyPress
{

    uint8 ElementIndex;

    string UserName;
    string UserPass;

    IGUIScreenOpt@  ScreenOpt;
    IGUIElementOpt@ InputBoxOpt;

    //CLoginScreenCharList@ CharList;
    CLoginScreenCharCreateInput@ CharCreateInput;
    //CLoginScreenCharCreatePic@   CharCreatePic;
    CLoginScreenCharInfo@        CharInfo;

    CLoginScreenButton@[]        LoginBtn;
    CLoginScreenCharListElement@[] Elements;

    CLoginScreen(){
        ElementIndex = 0;
    }

    void OnShow( int p0, int p1, int p2 )
    {
        //::Message( "OnShow " + p0 + " " + p1 + " " + p2 + "." );
        @ScreenOpt = GUI_GetScreenOptions();
        @outLoginScreen = this;

        __charLogin = false;
    }

    void OnHide( int p0, int p1, int p2 )
    {
        forumId = uint(-1);
        //::Message( "OnHide " + p0 + " " + p1 + " " + p2 + "." + "\nforumId "+forumId);
    }

    void OnMove( int posX, int posY )
    {
        ::Message( "OnMove posX " + posX + " posY " + posY );
        ::Message( "equal posX " + ScreenOpt.GetPosX() + " posY " + ScreenOpt.GetPosY() );
    }
/*
    void OnInit()
    {
        @InputBoxOpt = GUI_GetElementOptions();
    }
*/
    void OnKeyPress( uint8 key, uint8 letter )
    {
        string letter_ = " ";
        letter_[ 0 ] = ( letter != 0 ? letter : '?' );
        //::Message( "OnKeyPress key code " + key + " letter " + letter_ + "." );
    }

    void UserDataGet(string& name, string& pass){
            name = UserName;
            pass = UserPass;
    }

    void UserDataSet(string name, string pass){
            UserName = name;
            UserPass = pass;
    }

    bool IsRegActive(){
            //return (CharCreateInput.Options.GetVisible() && CharCreatePic.Options.GetVisible() && LoginBtn[LoginBtn.length()-1].Options.GetVisible());
#ifdef __DEBUG
            Message("reg active "+CharCreateInput.Options.GetVisible());// + " " + CharCreatePic.Options.GetVisible());
#endif //__DEBUG
            return (CharCreateInput.Options.GetVisible());// && CharCreatePic.Options.GetVisible());
    }

    bool CharListRefresh(){
        if(loginBtn is null) return false;

        loginBtn.GetChars(forumId);
        return true;
    }

    void ListMoveDown(){

        if(ElementIndex+CHARLIST_LENGTH+1 >= uname.length()) return;

        ElementIndex++;

        //for(uint8 i = ElementIndex; i < ElementIndex+CHARLIST_LENGTH; ++i){
        for(uint8 i = 0; i < Elements.length(); ++i){
            Elements[i].SetElement(ElementIndex+i);
        }

    }

    void ListMoveUp(){

        if(ElementIndex <= 0) return;

        ElementIndex--;

        //for(uint8 i = ElementIndex; i < ElementIndex+CHARLIST_LENGTH; ++i){
        for(uint8 i = 0; i < Elements.length(); ++i){
            Elements[i].SetElement(ElementIndex+i);
        }
    }
}
/*      show code to Tim_i_on ^_^
class CCharShowStatAdditional : IGUIElementCallbackInit, IGUIElementCallbackDraw
{
        int iXpos = 0, iYpos = 0;
        IGUIElemntOpt@ Options;

        CCharShowStatAdditional(){
        }

        void OnInit(){
                @Options = GUI_GetElementOptions();

                iXpos = Options.GetPosX();
                iYpos = Options.GetPosY();
        }

        void OnDraw(){

                uint16 uYoff = 0;

                CritterCl@  crChoo = GetChosen();
                if(crChoo is null) return;

                for(uint8 i = 0; i < 18; ++i){
                        //int iX = iXpos, iY = iYpos;

                        DrawText( ""+crChoo.StatBase[200+i], iXpos, iYpos + iYoff, 50, 200, COLOR_RED, FONT_FALLOUT, 0 );

                        iYoff += 10;
                }
        }
}

void InitTestScreen(){

        CCharShowStatAdditional testElement;
