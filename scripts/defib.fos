#include "_macros.fos"
/*import void InjureCritter(Critter& cr, uint dmg, uint dmgType, uint8 dir, uint attackerId) from "combat";*/
void _ItemInit(Item& item, bool FirstTime)
{
 item.SetEvent(ITEM_EVENT_USE, "_Reanimate");
 }

bool _Reanimate(Item& item, Critter& crit, Critter@ onCritter, Item@ onItem, Scenery@ onScenery)
{

if(!valid(onCritter)) 
{
return false;
}

if(onCritter.IsLife())
{
/*InjureCritter(onCritter, 50, 5, 0, crit.Id);*/
crit.Say(SAY_NETMSG, "В этом нет необходимости.");
return true;
}

if(onCritter.IsDead())
{
if(crit.Param[SK_DOCTOR]<80){crit.Say(SAY_NETMSG,"Вы недостаточно разбираетесь в медицине."); return true;}
switch(onCritter.CondExt)
	{
	case COND_DEAD_FRONT:
	onCritter.ToLife();
	crit.DeleteItem(PID_DEFIB,1);
	crit.Say(SAY_NETMSG, "Вы успешно применили реанимационный набор.");
	onCritter.EraseEnemyFromStack(crit.Id);
	crit.ParamBase[ST_EXPERIENCE]+=200;
	return true;
	
	case COND_DEAD_BACK:
	onCritter.ToLife();
	crit.DeleteItem(PID_DEFIB,1);
	crit.Say(SAY_NETMSG, "Вы успешно применили реанимационный набор."); 
	onCritter.EraseEnemyFromStack(crit.Id);
	crit.ParamBase[ST_EXPERIENCE]+=200;
	return true;
	
	case COND_DEAD_BURST:
	onCritter.ToLife();
	crit.DeleteItem(PID_DEFIB,1);
	crit.Say(SAY_NETMSG, "Вы успешно применили реанимационный набор."); 
	onCritter.EraseEnemyFromStack(crit.Id);
	crit.ParamBase[ST_EXPERIENCE]+=300;
	return true;
	
	default: crit.Say(SAY_NETMSG, "Это уже не поможет.");return true;
	}
}
return false;
}
