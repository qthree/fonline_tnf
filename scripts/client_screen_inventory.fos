class InventoryItemAction : IGUIElementCallbackInit, IGUIElementCallbackMouseClick, IGUIElementCallbackDraw
{
	IGUIElementOpt@ Options;
	ScreenInventory @ Instance;
	bool CanPress;
	uint8 Type;
	uint16[] PosArr;

	InventoryItemAction(ScreenInventory& instance, uint8 type)
	{
		@Instance = instance;
		Type = type;
		CanPress = true;
		
		uint16[] posArr = {150,175,200,225,250,275};
		
		PosArr = posArr;
	}

	void OnInit()
	{
		uint8 index = (Type != INVENTORY_ITEM_DROP ? Type : Instance.ItemActions.length() -1);
		@Options = GUI_GetElementOptions();
		@Instance.ItemActions[index] = this;

		Options.Position(Options.GetPosX(), Options.GetPosY(), 20, 20);
	}

	void OnMouseClick(int click)
	{
		if(click == MOUSE_CLICK_LEFT && CanPress)
		{
			switch(Type)
			{
				case INVENTORY_ITEM_USE 	: InventoryUse(); break;
				case INVENTORY_ITEM_WEAR_DOWN 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_ARMOR 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_HAND1 	: InventoryWear(); break;
				case INVENTORY_ITEM_WEAR_HAND2 	: InventoryWear(); break;
				case INVENTORY_ITEM_SKILL 	: InventorySkillShow(true); break;
				case INVENTORY_ITEM_UNLOAD 	: InventoryUnloadWeap(); break;
				case INVENTORY_ITEM_DROP	: InventoryDrop(); break;
				default 			: break;
			}
			
			//Instance.FullRefrash();
		}
	}
	
	/*
	 *  use / unload / armor - drop - skill - left - right - down
	 *  use / unload - skill - drop - wear - down 
	 */

	void OnDraw()
	{
		//string text = "X";
		

		//Options.Text(""+text,FONT_BIG,CanPress ? COLOR_SAND : COLOR_RED, COLOR_GREEN, FT_CENTERX|FT_CENTERY);
	}
	
	void SetVisible(){
		uint8 prevIndex = Instance.prevIndex;

		if(prevIndex == 255) return;

		uint16 invItemIndex = Instance.InventoryButtons[prevIndex].InvItemIndex;

		//InventoryItem invItem
		if(invItemIndex < 0 || invItemIndex >= Instance.InventoryItems.length()) {Message("idx err");return;}

		ItemCl@ tempItem = Instance.InventoryItems[invItemIndex].tempItem[0];

		if(tempItem is null) {Message("null item");return;}
		
		CanPress = true;

		switch(Type)
		{
			case INVENTORY_ITEM_USE 		: if(FLAG(tempItem.Flags, ITEM_CAN_USE) || FLAG(tempItem.Flags, ITEM_CAN_USE_ON_SMTH)) {CanPress = true;} else { CanPress = false;} break;
			case INVENTORY_ITEM_WEAR_DOWN		: if(tempItem.CritSlot != SLOT_INV) {CanPress = true;} else { CanPress = false;} break;
			case INVENTORY_ITEM_WEAR_ARMOR 	: if(tempItem.GetType() == ITEM_TYPE_ARMOR && tempItem.CritSlot != SLOT_ARMOR) {CanPress = true;} else {CanPress = false;} break;
			case INVENTORY_ITEM_UNLOAD		: if(tempItem.GetType() == ITEM_TYPE_WEAPON && tempItem.AmmoCount<tempItem.Proto.Weapon_MaxAmmoCount) {CanPress = true;} else {CanPress = false;} break;
			default			: break;
		}
		
		Options.SetVisible(CanPress);
	}
	
	void SetPos(int x, int y){
	  
		SetVisible();
	  
		uint8 arrPos = 0;
	  
		switch(Type){
			case INVENTORY_ITEM_USE 	: arrPos = 0; break;
			case INVENTORY_ITEM_WEAR_DOWN 	: arrPos = 5; break;
			case INVENTORY_ITEM_WEAR_ARMOR 	: arrPos = 0; break;
			case INVENTORY_ITEM_WEAR_HAND1 	: arrPos = 3; break;
			case INVENTORY_ITEM_WEAR_HAND2 	: arrPos = 4; break;
			case INVENTORY_ITEM_SKILL 	: arrPos = 2; break;
			case INVENTORY_ITEM_UNLOAD 	: arrPos = 0; break;
			case INVENTORY_ITEM_DROP	: arrPos = 1; break;
			default : break;
		}
	  
		Options.Position(x+PosArr[arrPos], y+25, 20, 20);
	}

	void InventoryUse()
	{
		Instance.ActionUse();
			//RefreshItemList();
	}
	
	void InventorySkillShow(bool vis){
		Instance.ActionSkillShow();
		
	}

	void InventorySkill()
	{
		Instance.ActionSkill();
	}

	void InventoryWear()
	{
		Instance.ActionWear(Type);
	}

	void InventoryUnloadWeap()
	{
		Instance.ActionUnloadWeap();
	}

	void InventoryDrop()
	{
		Instance.ActionDrop();	
	}
}

class InventoryItemSort  : IGUIElementCallbackInit, IGUIElementCallbackMouseClick
{
	IGUIElementOpt@ Options;
	ScreenInventory @ Instance;
	uint8 Type;
	bool Reverse;
	string DownPic;
	string UpPic;

	InventoryItemSort(ScreenInventory& instance, uint8 type, string upPic, string downPic)
	{
		@Instance = instance;
		Type = type;
		UpPic = upPic;
		DownPic = downPic;
		Reverse = false;
	}

	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		@Instance.ItemSorts[Type] = this;
	}

	void OnMouseClick(int click)
	{
	      if(click == MOUSE_CLICK_LEFT)
	      {
			Instance.Sort(Type, Reverse);

			if(Reverse)
			{
				Reverse = false;
				Options.UpPic(UpPic);
				Options.DownPic(DownPic);
			}else
			{
				Reverse = true;
				Options.UpPic(DownPic);
				Options.DownPic(UpPic);
			}
			
			for(uint8 i = 0, j = Instance.ItemSorts.length(); i < j; ++i)
			{
				if(Instance.ItemSorts[i].Type != Type)
				{
					Instance.ItemSorts[i].Options.UpPic(Instance.ItemSorts[i].Reverse ? Instance.ItemSorts[i].UpPic : Instance.ItemSorts[i].DownPic);
					Instance.ItemSorts[i].Options.DownPic(Instance.ItemSorts[i].Reverse ? Instance.ItemSorts[i].DownPic : Instance.ItemSorts[i].UpPic);
					Instance.ItemSorts[i].Reverse = (Instance.ItemSorts[i].Reverse ? false : true);
				}
			}
	      }
	}
}

class InventoryItemSlide : IGUIElementCallbackInit, IGUIElementCallbackMouseClick
{
	IGUIElementOpt@ Options;
	ScreenInventory @ Instance;
	uint8 Type;

	InventoryItemSlide(ScreenInventory& instance, uint8 type)
	{
		@Instance = instance;
		Type = type;
	}

	void OnInit()
	{
		@Options = GUI_GetElementOptions();
		@Instance.ItemSlide[Type] = this;
	}

	void OnMouseClick(int click)
	{
		uint8 prevIndex = Instance.prevIndex;

		InventoryItem tempInvItem = Instance.InventoryItems[Instance.InventoryButtons[prevIndex].InvItemIndex];

		switch(Type)
		{
			case INVENTORY_ITEMS_LIST_UP 		: Instance.MoveItemList(true, false); break;
			case INVENTORY_ITEMS_LIST_DOWN		: Instance.MoveItemList(false, false); break;
			case INVENTORY_ITEMS_LIST_UP_FORCED	: Instance.MoveItemList(true, true); break;
			case INVENTORY_ITEMS_LIST_DOWN_FORCED	: Instance.MoveItemList(false, true); break;
			case INVENTORY_ITEMS_LIST_LEFT 		: {if(tempInvItem.Rolled)  {Instance.RollUpItemArrow(prevIndex); /*Instance.InventoryButtons[prevIndex].Rolled = false;*/} break;}
			case INVENTORY_ITEMS_LIST_RIGHT 	: {if(!tempInvItem.Rolled && !tempInvItem.Child){Instance.DropItem(prevIndex); /*Instance.InventoryButtons[prevIndex].Rolled = true;*/} break;}
			default : break;
		}
	}


}

